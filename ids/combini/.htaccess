Options +FollowSymLinks

RewriteEngine on

RewriteRule ^semkraph/license/?(.*) https://raw.githubusercontent.com/COMBINI-Hub/semkraphkg-pipeline/main/license.ttl [R=307,L]
RewriteRule ^semkraph/metadata/?(.*) https://raw.githubusercontent.com/COMBINI-Hub/semkraphkg-pipeline/main/semkraph-metadata.ttl [R=307,L]
RewriteRule ^semkraph/source_files/?(.*) https://doi.org/10.5281/zenodo.20735733 [R=307,L]
RewriteRule ^semkraph/output_files/?(.*) https://doi.org/10.5281/zenodo.21652814 [R=307,L]
RewriteRule ^semkraph/?(.*) https://hbcesar.github.io/simple-dcat-visualizer/?url=https://github.com/COMBINI-Hub/semkraphkg-pipeline/blob/main/semkraph-metadata.ttl [R=307,L]
RewriteRule ^(.*)$ https://combini-hub.github.io/ [R=307,L]