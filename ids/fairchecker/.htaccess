# Turn off MultiViews
Options -MultiViews

# Basic redirect to the project pages
RewriteEngine On
RewriteRule ^$ https://fair-checker.france-bioinformatique.fr [R=302,L]

# redirection for a full FAIR assessment in RDF turtle
RewriteRule ^assessment/(.*)$ https://fair-checker.france-bioinformatique.fr/assessment/$1 [R=302,L]

# redirection for individual FAIR metrics in RDF turtle
RewriteRule ^eval/(.*)$ https://fair-checker.france-bioinformatique.fr/eval/$1 [R=302,L]

# redirection for test descriptions
RewriteRule ^test/(.*)$ https://fair-checker.france-bioinformatique.fr/test/$1 [R=302,L]
