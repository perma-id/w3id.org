# # /gyomu/
#
# 業務語彙（Gyomu Vocabulary）
# A vocabulary and reference dataset describing business operations of
# companies in Japan in four layers: department, workflow, stage and step.
#
# https://w3id.org/gyomu/        -> https://furuchanchan.github.io/gyomu-vocab/
# https://w3id.org/gyomu/ns      -> the vocabulary (HTML, or Turtle by content negotiation)
# https://w3id.org/gyomu/id/...  -> the data (HTML, or Turtle / JSON-LD by content negotiation)
#
# Source: https://github.com/furuchanchan/gyomu-vocab
#
# ## Contact
# This space is administered by:
#
# Kotaro Furuno (TechWorker Inc.)
# GitHub username: furuchanchan
# Email: info@techworker.co.jp

Options +FollowSymLinks
RewriteEngine on

# The vocabulary: https://w3id.org/gyomu/ns (terms are https://w3id.org/gyomu/ns#Step etc.)
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^ns/?$ https://furuchanchan.github.io/gyomu-vocab/gyomu-vocab.ttl [R=303,L]
RewriteRule ^ns/?$ https://furuchanchan.github.io/gyomu-vocab/ns/ [R=303,L]

# The JSON-LD context
RewriteRule ^context\.jsonld$ https://furuchanchan.github.io/gyomu-vocab/context.jsonld [R=303,L]

# The data: https://w3id.org/gyomu/id/<type>/<name>
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^id/(.+?)/?$ https://furuchanchan.github.io/gyomu-vocab/id/$1.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^id/(.+?)/?$ https://furuchanchan.github.io/gyomu-vocab/id/$1.jsonld [R=303,L]
RewriteRule ^id/(.+?)/?$ https://furuchanchan.github.io/gyomu-vocab/id/$1/ [R=303,L]

# The dataset description and everything else
RewriteRule ^dataset/?$ https://furuchanchan.github.io/gyomu-vocab/ [R=303,L]
RewriteRule ^(.*)$ https://furuchanchan.github.io/gyomu-vocab/$1 [R=302,L]
