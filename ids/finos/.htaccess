# w3id.org/finos - FINOS (Fintech Open Source Foundation) persistent identifiers
# for the LinkML linked-data sidecar of FINOS projects. Maintainers: README.md.
# Test harness: https://github.com/lmodel/w3id_smoke_test
#
# Namespace layout:  https://w3id.org/finos/<repo>[/<path>]
#   <repo>  repository under https://github.com/finos/<repo> (aliases below)
#   Each project carries LinkML in a ".linkml/" sidecar directory so that the
#   linked-data toolchain never collides with the project's own tree
#   (dot-prefixed: ignored by Jekyll/GitHub Pages builds of the main docs):
#     .linkml/src/<STEM>/schema/<STEM>.yaml       LinkML source (root schema)
#     .linkml/src/<STEM>/schema/<name>.yaml       further modules
#     .linkml/project/<generator>/<STEM>.<ext>    gen-project artefacts
#   Docs: https://finos.github.io/<repo>/ unless overridden (GitHub itself
#   redirects to a custom domain where one is configured for the repo).
#
# This is the same rule set as w3id.org/lmodel (reference implementation, used
# by the github.com/lmodel forks of these projects). Only the org, the SIDECAR
# prefix and the per-repo overrides differ; keep the two files in sync.
#
# Minor caveats & accepted design trade-offs (all minor or trivial)
# 1. [minor]   No `;q=` weight parsing; first rule wins (rare: most clients send single type).
# 2. [trivial] Bare `<repo>/<x>.yaml` -> canonical schema (single-file LinkML design).
#              Multi-file repos use `<repo>/schema/<name>.yaml`.
# 3. [trivial] HTML conneg=303; docs=302 (same dest, different semantics).
# 4. [trivial] `{jsonld,jsonschema}/foo.json` mis-routes; harmless 404 upstream.
# 5. [trivial] AddType sparse; GitHub sets Content-Type. Local-serve only.
# 6. [trivial] Deprecated variants (`text/x-yaml`, `application/x-turtle`) unsupported; get 406.
# 7. [minor]   `[N,DPI]` assumes single-pass aliasing. Chain carefully (respects LimitInternalRecursion=10).
# 8. [minor]   Apache `.htaccess` cannot map hyphens to underscores: every hyphenated repo needs an explicit STEM entry.
# 9. [trivial] `[^/]+` allows unusual chars; safe (fixed-template redirects, no traversal).
# 10. [trivial] `+FollowSymLinks` needs vhost permission; not portable to restrictive hosts.

Options +FollowSymLinks
Options -MultiViews
RewriteEngine on

# MIME type registrations (belt-and-braces; 3xx targets set their own types)
AddType application/rdf+xml      .rdf
AddType text/turtle              .ttl
AddType application/n-triples    .nt
AddType application/ld+json      .jsonld
AddType text/shex                .shex
AddType application/yaml         .yaml

#### FINOS ORGANIZATION ###

# Bare base URL -> FINOS home page (information resource -> 302)
RewriteRule ^$ https://www.finos.org/ [R=302,L]

# Path canonicalization & aliases (internal rewrite; [N,DPI] preserves suffixes)
# `aigf` is the historical short name of ai-governance-framework.
RewriteRule ^aigf((?:/.*)?)$ ai-governance-framework$1 [N,DPI]

# Per-request variables (Apache `.htaccess` cannot translate hyphens to
# underscores natively - RewriteMap is forbidden here - so hyphenated repos
# get explicit STEM entries):
#
#   STEM:    artifact filename stem (hyphens->underscores). Default: $1.
#   BRANCH:  git branch. Default: main (`master` for older FINOS repos).
#   PROJECT: artifact prefix inside the sidecar ("project/" or empty). Default: "project/".
#   SIDECAR: sidecar directory prefix. Default: ".linkml/" (empty = LinkML at repo root).
#   DOCS:    documentation site (mkdocs, gen-doc pages under /elements/). Default: https://finos.github.io/$1
RewriteRule ^([^/]+) - [E=STEM:$1,E=BRANCH:main,E=PROJECT:project/,E=SIDECAR:.linkml/,E=DOCS:https://finos.github.io/$1]

# Repo overrides. Add one line per FINOS project that adopts the sidecar.
RewriteRule ^ai-governance-framework(?:/|$) - [E=STEM:ai_governance_framework,E=DOCS:https://air-governance-framework.finos.org]
RewriteRule ^common-domain-model(?:/|$)     - [E=STEM:common_domain_model,E=BRANCH:master]
RewriteRule ^fluxnova-bpm-platform(?:/|$)   - [E=STEM:fluxnova_bpm_platform]

# ----------------------------------------------------------------------------
# Template: repo with `project/` gitignored, artifacts CI-published elsewhere
# Variant A: artifacts on `artifacts` branch, standard layout. E=STEM:...,E=BRANCH:artifacts
# Variant B: artifacts at branch root. E=STEM:...,E=BRANCH:artifacts,E=PROJECT:
# Variant C: artifacts on `gh-pages` (requires custom deploy). E=STEM:...,E=BRANCH:gh-pages
# Variant D: LinkML at repo root (no sidecar). E=STEM:...,E=SIDECAR:

# Schemas - explicit filename honors $2 (supports multi-file schemas)
#   $2's `(.+)` is greedy and spans `/`, so nested module
#   layouts also resolve (e.g. <repo>/schema/modules/mymodule.yaml ->
#   .linkml/src/<STEM>/schema/modules/mymodule.yaml).
#
# Bare /schema canonicalizes to root schema (+ .yaml extension).
# And /schema/<path> (single- or multi-segment) resolves to the named schema,
# honoring the filename (+ .yaml extension); nested sub-directory paths supported.
RewriteRule ^([^/]+)/schema/(.+)\.yaml$  https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}src/%{ENV:STEM}/schema/$2.yaml [R=303,NE,L]
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^([^/]+)/schema/(.+?)/?$     https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}src/%{ENV:STEM}/schema/$2.yaml [R=303,NE,L]
RewriteRule ^([^/]+)/schema/?$           https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}src/%{ENV:STEM}/schema/%{ENV:STEM}.yaml [R=303,NE,L]

# Bare <repo>/<anything>.yaml fallback (excludes prefixmap, golr, yaml, .linkml.yaml)
RewriteCond %{REQUEST_URI} !/(schema|prefixmap|golr|yaml)/
RewriteCond %{REQUEST_URI} !\.linkml\.yaml$
RewriteRule ^([^/]+)/(.+)\.yaml$         https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}src/%{ENV:STEM}/schema/%{ENV:STEM}.yaml [R=303,NE,L]

# Core LinkML Artifacts - representations (non-information resource) -> 303 See Other

# GraphQL
RewriteRule ^([^/]+)/(.+)\.graphql$         https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}graphql/$2.graphql [R=303,NE,L]

# JSON-LD context + plain. .context.json variant for CDN compatibility.
RewriteRule ^([^/]+)/context\.jsonld$      https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonld/%{ENV:STEM}.context.jsonld [R=303,NE,L]
RewriteRule ^([^/]+)/context\.json$        https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonld/%{ENV:STEM}.context.jsonld [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.context\.jsonld$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonld/$2.context.jsonld [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.context\.json$   https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonld/$2.context.jsonld [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.jsonld$         https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonld/$2.jsonld [R=303,NE,L]

# JSON Schema + plain JSON. .schema.json matched first; .json excludes /terminusdb/ (Non-Core rule).
RewriteRule ^([^/]+)/(.+)\.schema\.json$  https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonschema/$2.schema.json [R=303,NE,L]
RewriteCond %{REQUEST_URI} !/terminusdb/
RewriteRule ^([^/]+)/(.+)\.json$          https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}json/$2.json [R=303,NE,L]

# OWL (emitted as .owl.ttl). Both .owl and .owl.ttl resolve to same file.
RewriteRule ^([^/]+)/(.+)\.owl(?:\.ttl)?$   https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}owl/$2.owl.ttl [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.rdf$             https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}rdf/$2.rdf [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.nt$              https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}rdf/$2.nt [R=303,NE,L]

# Prefix map (semantic config)
RewriteRule ^([^/]+)/prefixmap/(.+)\.yaml$  https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}prefixmap/$2.yaml [R=303,NE,L]

# Protobuf, SHACL, ShEx, SQL DDL. (.shexc is alias for .shex)
RewriteRule ^([^/]+)/(.+)\.wire\.proto$     https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}protobuf/$2.wire.proto [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.proto$           https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}protobuf/$2.proto [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.shacl\.ttl$      https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}shacl/$2.shacl.ttl [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.shex$            https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}shex/$2.shex [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.shexc$           https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}shex/$2.shex [R=303,NE,L]
RewriteRule ^([^/]+)/(.+)\.shexj$           https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}shex/$2.shexj [R=303,NE,L]
RewriteCond %{REQUEST_URI} !/sqlvalidation/
RewriteRule ^([^/]+)/(.+)\.sql$             https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}sqlschema/$2.sql [R=303,NE,L]

# Turtle (excludes .owl.ttl which is matched by the .owl rule above)
RewriteCond %{REQUEST_URI} !\.owl\.
RewriteRule ^([^/]+)/(.+)\.ttl$             https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}rdf/$2.ttl [R=303,NE,L]

# Merged LinkML YAML
RewriteRule ^([^/]+)/(.+)\.linkml\.yaml$    https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}linkml/$2.linkml.yaml [R=303,NE,L]

# Non-Core Artifacts - information resources / code-gen outputs (302, no conneg)
# MIME collisions handled by path segmentation (3× .py, 3× .yaml, 2× .md, 2× .sql)
RewriteRule ^([^/]+)/(.+)\.xlsx$                  https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}excel/$2.xlsx [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.java$                  https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}java/$2.java [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.ts$                    https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}typescript/$2.ts [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.h$                     https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}cpp/$2.h [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.csv$                   https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}csv/$2.csv [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.dbml$                  https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}dbml/$2.dbml [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.er\.md$                https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}erdiagram/$2.er.md [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.go$                    https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}golang/$2.go [R=302,NE,L]
RewriteRule ^([^/]+)/golr/(.+)\.yaml$             https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}golr/$2.yaml [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.dot\.dot$              https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}graphviz/$2.dot.dot [R=302,NE,L]
RewriteRule ^([^/]+)/markdown-datadict/(.+)\.md$  https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}markdown-datadict/$2.md [R=302,NE,L]
RewriteRule ^([^/]+)/mermaid/(.+)\.md$            https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}mermaid/$2.md [R=302,NE,L]
RewriteRule ^([^/]+)/namespaces/(.+)\.py$         https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}namespaces/$2.py [R=302,NE,L]
RewriteRule ^([^/]+)/pandera/(.+)\.py$            https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}pandera/$2.py [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.plantuml$              https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}plantuml/$2.plantuml [R=302,NE,L]
RewriteRule ^([^/]+)/sqla/(.+)\.py$               https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}sqla/$2.py [R=302,NE,L]
RewriteRule ^([^/]+)/sqlvalidation/(.+)\.sql$     https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}sqlvalidation/$2.sql [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.sssom\.tsv$            https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}sssom/$2.sssom.tsv [R=302,NE,L]
RewriteRule ^([^/]+)/summary/(.+)\.tsv$           https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}summary/$2.tsv [R=302,NE,L]
RewriteRule ^([^/]+)/terminusdb/(.+)\.json$       https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}terminusdb/$2.json [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.tql$                   https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}typedb/$2.tql [R=302,NE,L]
RewriteRule ^([^/]+)/yaml/(.+)\.yaml$             https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}yaml/$2.yaml [R=302,NE,L]
RewriteRule ^([^/]+)/rust/Cargo\.toml$            https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}rust/Cargo.toml [R=302,NE,L]
RewriteRule ^([^/]+)/(.+)\.rq$                    https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}sparql/$2.rq [R=302,NE,L]

# Content negotiation - no file extension triggers (303 See Other)
# Matches repo root and any depth (e.g. /finos/<repo>/<TermName>)

# Turtle
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}rdf/%{ENV:STEM}.ttl [R=303,NE,L]

# RDF/XML and OWL/XML (requires `gen-rdf` to have produced .rdf)
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/owl\+xml [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}rdf/%{ENV:STEM}.rdf [R=303,NE,L]

# N-Triples
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/n-triples [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}rdf/%{ENV:STEM}.nt [R=303,NE,L]

# JSON-LD
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonld/%{ENV:STEM}.context.jsonld [R=303,NE,L]

# Plain JSON - fallback to JSON-LD context (broadest JSON form).
# Must come after application/ld+json so clients accepting both pick more specific representation.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/json [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonld/%{ENV:STEM}.context.jsonld [R=303,NE,L]

# JSON Schema
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/schema\+json [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}jsonschema/%{ENV:STEM}.schema.json [R=303,NE,L]

# SHACL (Turtle profile)
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/shacl\+turtle [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}shacl/%{ENV:STEM}.shacl.ttl [R=303,NE,L]

# ShEx
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/shex [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}%{ENV:PROJECT}shex/%{ENV:STEM}.shex [R=303,NE,L]

# LinkML schema source (YAML)
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/yaml [NC,OR]
RewriteCond %{HTTP_ACCEPT} text/yaml [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/x-yaml [NC]
RewriteRule ^([^/]+)(?:/.*)?$ https://raw.githubusercontent.com/finos/$1/%{ENV:BRANCH}/%{ENV:SIDECAR}src/%{ENV:STEM}/schema/%{ENV:STEM}.yaml [R=303,NE,L]

# HTML - browser default. Returns 303 See Other to docs site. Accept:*/* excluded.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/html [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [NC]

# LinkML gen-doc class/slot/enum pages are published under /elements/.
# Match a single trailing term segment that is NOT a reserved docs path.
RewriteCond %{REQUEST_URI} !^/finos/[^/]+/(about|index|elements|schema|prefixmap)(/|$)
RewriteRule ^([^/]+)/([^/]+)/?$ %{ENV:DOCS}/elements/$2/ [R=303,NE,L]

# Fallback: repo root, multi-segment paths already under /elements/, etc.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/html [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [NC]
RewriteRule ^([^/]+)(/.*)?$ %{ENV:DOCS}$2 [R=303,NE,L]

# 406 Not Acceptable - Accept header present, specific, no match. Accept:*/* excluded.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} .+
RewriteCond %{HTTP_ACCEPT} !\*/\*
RewriteRule ^(.+)$ - [R=406,L]

#### FINOS PROJECTS ###
# Catch-all: any canonical <repo>/<rest> -> docs site (302)
# Path canonicalization applied via [N] rules above; aliases already resolved.
RewriteRule ^([^/]+)(/.*)?$ %{ENV:DOCS}$2 [R=302,NE,L]
