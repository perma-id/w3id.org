# w3id.org/people/takakura-makiko
# 個人用の試験的な永続URI。
# /smartcity/ 配下は GitHub Pages（takakura-makiko/smartcity-test）へ転送。
# 動作確認中のため 302（一時転送）。運用が固まったら 301 に変更を検討。

Options +FollowSymLinks
RewriteEngine on

# https://w3id.org/people/takakura-makiko/smartcity
# https://w3id.org/people/takakura-makiko/smartcity/
#   →  https://takakura-makiko.github.io/smartcity-test/
RewriteRule ^smartcity/?$ https://takakura-makiko.github.io/smartcity-test/ [R=302,L]

# https://w3id.org/people/takakura-makiko/smartcity/xxx
#   →  https://takakura-makiko.github.io/smartcity-test/xxx
RewriteRule ^smartcity/(.+)$ https://takakura-makiko.github.io/smartcity-test/$1 [R=302,L]
