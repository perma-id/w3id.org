# Verisav W3ID namespace root
# Persistent URIs: https://w3id.org/verisav/{dpp,rma,wty}/...
# Contact: k.boutillier@verisav.fr
# GitHub: https://github.com/kevinbouti
# See also: README.md in this directory

Options +FollowSymLinks
RewriteEngine On

# Namespace index → ns.verisav.fr hub
RewriteRule ^$ https://ns.verisav.fr/ [R=303,L]

# Fallback for paths not handled by subdir .htaccess (dpp/, rma/, wty/)
RewriteRule ^(.+)$ https://ns.verisav.fr/$1 [R=303,L]
