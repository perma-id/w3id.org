RewriteEngine on

# Add types for .ttl and .jsonld and .json
AddType text/turtle .ttl
AddType application/ld+json .jsonld
AddType application/json .json

# vliz-be-opsci home page
# https://w3id.org/vliz-be-opsci redirects to https://open-science.vliz.be/
RewriteRule ^$ https://vliz-be-opsci.github.io/ [R=302,L]

# Ontologies / Vocabularies
# https://w3id.org/vliz-be-opsci/ns redirects to https://open-science.vliz.be/ns
RewriteRule ^ns$ https://vliz-be-opsci.github.io/ns/ [R=302,L]

# Add rules for text/turtle files in /ns
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^ns/(.*)$ https://vliz-be-opsci.github.io/ns/$1.ttl [R=303,L]

# Rule to redirect subdirectories of /ns to the corresponding subdirectories of the GitHub Pages site
RewriteRule ^ns/(.*)$ https://vliz-be-opsci.github.io/ns/$1 [R=302,L]

# RO-Crates
# Add rule for application/ld+json files in /rocrate
RewriteCond %{HTTP_ACCEPT} application/ld+json
RewriteRule ^rocrate/(.*)$ https://vliz-be-opsci.github.io/$1/ro-crate-metadata.jsonld [R=303,L]
# Add rule for application/json files in /rocrate
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^rocrate/(.*)$ https://vliz-be-opsci.github.io/$1/ro-crate-metadata.json [R=303,L]
# example rocrate here https://w3id.org/vliz-be-opsci/rocrate/$1 redirects to https://vliz-be-opsci.github.io/$1
RewriteRule ^rocrate/(.*)$ https://vliz-be-opsci.github.io/$1 [R=302,L]

# RO-Crate profile crate-profiles/mrc-ro-profile/{version}
# The version segment (e.g. 0.1, 0.2, 1.0) is captured and mapped to git tag v{version}.0.
# All redirects below are 302 for now; they can be switched to 301 once the targets are stable.

# Context file https://w3id.org/vliz-be-opsci/crate-profiles/mrc-ro-profile/{version}/context
SetEnvIf Request_URI "^/vliz-be-opsci/crate-profiles/mrc-ro-profile/[^/]+/context/?$" W3ID_CONTEXT
Header always set Content-Type application/ld+json env=W3ID_CONTEXT
Header always set Access-Control-Allow-Origin * env=W3ID_CONTEXT
RewriteRule ^crate-profiles/mrc-ro-profile/([^/]+)/context/?$ https://raw.githubusercontent.com/vliz-be-opsci/mrc-ro-profile/v$1.0/profiles/mrc-ro-profile/$1/ro-crate-metadata.json [R=302,L]

# Profile https://w3id.org/vliz-be-opsci/crate-profiles/mrc-ro-profile/{version}
# Clients that accept JSON (application/json or application/ld+json) get the JSON-LD metadata file
RewriteCond %{HTTP_ACCEPT} application/(ld\+)?json
RewriteRule ^crate-profiles/mrc-ro-profile/([^/]+)/?$ https://raw.githubusercontent.com/vliz-be-opsci/mrc-ro-profile/v$1.0/profiles/mrc-ro-profile/$1/ro-crate-metadata.json [R=302,L]

# All other clients (for example browsers) get the HTML profile page
RewriteRule ^crate-profiles/mrc-ro-profile/([^/]+)/?$ https://open-science.vliz.be/mrc-ro-profile/$1/index.html [R=302,L]
