RewriteEngine on

RewriteRule ^profile-registry https://raw.githubusercontent.com/icer-unibe-ch/voc-profile-registry/main/registry.csv [R=302,L]
RewriteRule ^p([0-9]+)/([a-zA-Z]+) https://raw.githubusercontent.com/icer-unibe-ch/voc-p$1/main/$2.json [R=302,L]
RewriteRule ^v([0-9]+)/(.+) https://icer-unibe-ch.github.io/voc-v$1/w3id.org/icer/v$1/$2 [R=302,L]
RewriteRule ^p-([a-z]{3})/([a-zA-Z]+) https://raw.githubusercontent.com/icer-unibe-ch/p-$1/main/$2.json [R=302,L]
RewriteRule ^v-([a-z]{3})/(.+) https://icer-unibe-ch.github.io/v-$1/w3id.org/icer/v-$1/$2 [R=302,L]
RewriteRule ^(.*) https://icer-unibe-ch.github.io/w3id-404 [R=302,L]
