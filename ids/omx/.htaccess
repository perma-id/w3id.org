# /omx/
#
# omx: ontology metrics extension, a vocabulary for metrics, summarizability and ambiguous
# terms in OWL ontologies. https://gitlab.com/briceg/omx
#
# https://w3id.org/omx          the vocabulary: Turtle for RDF clients, the spec for browsers
# https://w3id.org/omx/shapes   the SHACL shapes
# https://w3id.org/omx/<x.y.z>  a release, and /<x.y.z>/shapes its shapes
#
# ## Contact
# This space is administered by:
#
# Brice Giesbrecht
# briceg@gmail.com
# GitHub username: bgiesbrecht

RewriteEngine on

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^$ https://briceg.gitlab.io/omx/omx.ttl [R=303,L]
RewriteRule ^$ https://briceg.gitlab.io/omx/ [R=303,L]

RewriteRule ^shapes/?$ https://briceg.gitlab.io/omx/omx-shapes.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)/?$ https://briceg.gitlab.io/omx/$1/omx.ttl [R=303,L]
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)/?$ https://briceg.gitlab.io/omx/$1/ [R=303,L]
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)/shapes/?$ https://briceg.gitlab.io/omx/$1/omx-shapes.ttl [R=303,L]
