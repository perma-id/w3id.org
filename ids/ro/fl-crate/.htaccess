# # /ro/fl-crate/
#
# Permanent identifiers for the Federated Learning RO-Crate profile.
#
# https://w3id.org/ro/fl-crate      redirects to the latest version
# https://w3id.org/ro/fl-crate/0.1  redirects to version 0.1
#
# Documentation: https://esciencelab.org.uk/federated-learning-ro-crate-profile/
#
# ## Contact
# This space is administered by:
#
# Eli Chadwick
# GitHub username: elichad
#
# Ali Feizollah
# GitHub username: faizollah

RewriteEngine on

# Latest version
RewriteRule ^$ https://esciencelab.org.uk/federated-learning-ro-crate-profile/federated-learning-profile.html [R=303,L]

# Version 0.1
RewriteRule ^0\.1/?$ https://esciencelab.org.uk/federated-learning-ro-crate-profile/federated-learning-profile.html [R=303,L]
