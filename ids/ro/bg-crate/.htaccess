AddType application/ld+json .jsonld
AddType application/rdf+xml .xml
AddType text/turtle .ttl
AddType application/n-triples .nt

RewriteEngine on

# latest version
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://esciencelab.org.uk/bge-ro-crate-profile/ro-crate-metadata.json [R=303,L]

RewriteRule ^$ https://esciencelab.org.uk/bge-ro-crate-profile/bge-profile.html [R=303,L]

# versioned
RewriteRule ^(.+)/context$ https://esciencelab.org.uk/bge-ro-crate-profile/$1/context.json [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(.+)$ https://esciencelab.org.uk/bge-ro-crate-profile/$1/ro-crate-metadata.json [R=303,L]

RewriteRule ^(.+)$ https://esciencelab.org.uk/bge-ro-crate-profile/$1/bge-profile.html [R=303,L]
