RewriteRule ^comp/(bcorecomp|comp)\.html$ https://tud-imb.github.io/BCore/comp/ [R=303,L]
# > .ttl suffix
RewriteRule ^comp/(bcorecomp|comp)\.ttl$ https://tud-imb.github.io/BCore/comp/bcorecomp.ttl [R=303,L]
# > .rdf suffix
