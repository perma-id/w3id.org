RewriteEngine On

# Workspace explanation
RewriteRule ^$ https://arc-rdm.org/workspace/ [R=302,L]
RewriteRule ^definition$ https://arc-rdm.org/workspace/definition [R=302,L]

# ISA-ARC workspace
RewriteRule ^isa-arc$ https://arc-rdm.org/workspace/isa-arc [R=302,L]
RewriteRule ^isa-arc/$ https://arc-rdm.org/workspace/isa-arc/ [R=302,L]
RewriteRule ^isa-arc/definition$ https://arc-rdm.org/workspace/isa-arc/definition [R=302,L]
RewriteRule ^isa-arc/isa-xlsx$ https://arc-rdm.org/workspace/isa-arc/isa-xlsx [R=302,L]
RewriteRule ^isa-arc/wr-xlsx$ https://arc-rdm.org/workspace/isa-arc/wr-xlsx [R=302,L]
RewriteRule ^isa-arc/datamap-xlsx$ https://arc-rdm.org/workspace/isa-arc/datamap-xlsx [R=302,L]
