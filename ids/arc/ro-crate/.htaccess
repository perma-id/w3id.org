AddType application/ld+json .jsonld

RewriteEngine On

# ARC RO-Crate landing page
RewriteRule ^$ https://nfdi4plants.github.io/arc-ro-crate-profile/ [R=302,L]

## administrative RO-Crate profile

### latest version 
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^administrative-core$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/administrative_core/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^administrative-core$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/administrative_core/ [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^provenance-core$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/provenance_core/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^provenance-core$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/provenance_core/ [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^semantic-core$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/semantic_core/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^semantic-core$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/semantic_core/ [R=302,L]

### versioned

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^administrative-core/(\d+\.\d+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/administrative_core/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^administrative-core/(\d+\.\d+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/administrative_core/ [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^provenance-core/(\d+\.\d+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/provenance_core/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^provenance-core/(\d+\.\d+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/provenance_core/ [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^semantic-core/(\d+\.\d+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/semantic_core/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^semantic-core/(\d+\.\d+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/semantic_core/ [R=302,L]