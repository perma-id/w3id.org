RewriteEngine On

# Abstract model landing page
RewriteRule ^$ https://arc-rdm.org/abstract-model/ [R=302,L]

# Abstract model facets
RewriteRule ^administrative-core$ https://arc-rdm.org/abstract-model/administrative-core [R=302,L]
RewriteRule ^provenance-core$ https://arc-rdm.org/abstract-model/provenance-core [R=302,L]
RewriteRule ^semantic-core$ https://arc-rdm.org/abstract-model/semantic-core [R=302,L]
RewriteRule ^isa$ https://arc-rdm.org/abstract-model/isa [R=302,L]
RewriteRule ^wr$ https://arc-rdm.org/abstract-model/wr [R=302,L]
RewriteRule ^datamap$ https://arc-rdm.org/abstract-model/datamap [R=302,L]
