# Permanent download identifier for WebDecoy's Open Bot Ontology.
# Source: https://github.com/WebDecoy/open-bot-ontology
# Maintainer: WebDecoy (GitHub: cport1)

RewriteEngine on
RewriteRule ^$ https://raw.githubusercontent.com/WebDecoy/open-bot-ontology/main/ontology/open-bot-ontology.owl [R=302,L]
