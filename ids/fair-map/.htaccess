# # /fair-map/
#
# Permanent identifiers for the FAIR Mappings Schema, a LinkML schema for
# describing FAIR mapping specifications, developed by the RDA FAIR Mappings
# Working Group.
#
# https://w3id.org/fair-map/               -> schema documentation
# https://w3id.org/fair-map/schema         -> schema documentation (the schema id)
# https://w3id.org/fair-map/fair-map.yaml  -> LinkML schema source
# https://w3id.org/fair-map/schema.yaml    -> LinkML schema source (import by id)
# https://w3id.org/fair-map/<Element>      -> documentation page for that class, slot or enum
#
# https://w3id.org/fair-map/transforms/sssom-to-fair      -> SSSOM to FAIR transformation (LinkML-Map)
# https://w3id.org/fair-map/transforms/linkmlmap-to-fair  -> LinkML-Map to FAIR transformation (LinkML-Map)
# https://w3id.org/fair-map/mappings/sssom-to-fair        -> SSSOM to FAIR slot mappings (SSSOM/TSV)
# https://w3id.org/fair-map/mappings/linkmlmap-to-fair    -> LinkML-Map to FAIR slot mappings (SSSOM/TSV)
#
# ## Contact
# This space is administered by:
#
# Nico Matentzoglu
# nicolas.matentzoglu@gmail.com
# GitHub username: matentzn
#
# Editors (GitHub usernames): StroemPhi, cthoyt, jkesanie

RewriteEngine on

# Schema documentation; "schema" is the schema id
RewriteRule ^(schema)?$ https://mapping-commons.github.io/fair-mappings-schema/ [R=302,L]

# LinkML schema source; LinkML resolves an import of the schema id as schema.yaml
RewriteRule ^(fair-map|schema)\.yaml$ https://raw.githubusercontent.com/mapping-commons/fair-mappings-schema/main/src/fair_mappings_schema/schema/fair_mappings_schema.yaml [R=302,L]

# Transformations from SSSOM and LinkML-Map metadata into the schema
RewriteRule ^transforms/sssom-to-fair$ https://raw.githubusercontent.com/mapping-commons/fair-mappings-schema/main/src/fair_mappings_schema/transformations/sssom-to-fair.transformation.yaml [R=302,L]
RewriteRule ^transforms/linkmlmap-to-fair$ https://raw.githubusercontent.com/mapping-commons/fair-mappings-schema/main/src/fair_mappings_schema/transformations/linkmlmap-to-fair.transformation.yaml [R=302,L]

# Slot-level SSSOM mapping sets that document those transformations field by field
RewriteRule ^mappings/sssom-to-fair$ https://raw.githubusercontent.com/mapping-commons/fair-mappings-schema/main/src/fair_mappings_schema/mappings/sssom-to-fair.sssom.tsv [R=302,L]
RewriteRule ^mappings/linkmlmap-to-fair$ https://raw.githubusercontent.com/mapping-commons/fair-mappings-schema/main/src/fair_mappings_schema/mappings/linkmlmap-to-fair.sssom.tsv [R=302,L]

# Schema elements (classes, slots, enums) resolve to their documentation pages.
# Only element-shaped names match, so paths with a dot or slash stay free for
# future artefacts instead of landing on a missing docs page.
RewriteRule ^([A-Za-z_][A-Za-z0-9_]*)$ https://mapping-commons.github.io/fair-mappings-schema/elements/$1 [R=302,L]
