# # /canon/
#
# Persistent IRIs for the ontology and vocabulary of the
# Analects Junzi Commentary Archive (논어 君子 장 주석 아카이브).
#
#   https://w3id.org/canon/ontology/analects  the ontology
#   https://w3id.org/canon/ns                 the canon vocabulary namespace
#                                             (https://w3id.org/canon/ns#);
#                                             its terms are defined in the
#                                             same ontology document
#
# Both are content-negotiated (Turtle, RDF/XML, JSON-LD, HTML default).
# The files are hosted on GitHub Pages:
#   https://github.com/sy527991/canon-ontology
#
# ## Contact
# This space is administered by:
#
# GitHub username: sy527991

RewriteEngine on

# Explicit format by extension
RewriteRule ^ontology/analects\.(ttl|rdf|jsonld|html)$ https://sy527991.github.io/canon-ontology/ontology/analects.$1 [R=303,L]

# Content negotiation for the ontology IRI and the namespace IRI
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^(ontology/analects|ns)$ https://sy527991.github.io/canon-ontology/ontology/analects.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(ontology/analects|ns)$ https://sy527991.github.io/canon-ontology/ontology/analects.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^(ontology/analects|ns)$ https://sy527991.github.io/canon-ontology/ontology/analects.rdf [R=303,L]

# Default: human-readable documentation
RewriteRule ^(ontology/analects|ns)$ https://sy527991.github.io/canon-ontology/ontology/analects.html [R=303,L]

# The bare identifier
RewriteRule ^$ https://sy527991.github.io/canon-ontology/ [R=302,L]
