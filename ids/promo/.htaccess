# w3id.org redirect rules for the ProMo namespace.
# Copy this directory (promo/) into a fork of perma-id/w3id.org and
# submit a pull request.  See publish/README.md in the ProMo14 repo.
#
# IRI layout:
#   https://w3id.org/promo#<term>      -> vocabulary document (hash IRIs
#                                       never reach the server; the base
#                                       redirect serves the whole doc)
#   https://w3id.org/promo/ontology    -> editable ontology named graph
#   https://w3id.org/promo/language#<> -> ProMo language vocabulary

Options +FollowSymLinks
RewriteEngine on

# --- Base namespace: content negotiation ---------------------------
# RDF clients get the Turtle vocabulary; browsers get the landing page.
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://heinz-preisig.github.io/ProMo-ontologies/ontology.ttl [R=303,L]

RewriteRule ^$ https://heinz-preisig.github.io/ProMo-ontologies/ [R=303,L]

# --- Slash IRIs -----------------------------------------------------
RewriteRule ^ontology/?$ https://heinz-preisig.github.io/ProMo-ontologies/ontology.ttl [R=303,L]
RewriteRule ^language/?$ https://heinz-preisig.github.io/ProMo-ontologies/language.ttl [R=303,L]

# --- Catch-all: anything else under /promo/ -------------------------
RewriteRule ^(.*)$ https://heinz-preisig.github.io/ProMo-ontologies/$1 [R=303,L]
