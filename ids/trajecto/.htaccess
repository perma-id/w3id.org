# Trajecto ontology: https://w3id.org/trajecto
#
# The core module (https://w3id.org/trajecto) and its modules
# (https://w3id.org/trajecto/<module>, e.g. /poi, /purpose/skos) redirect to
# their WIDOCO documentation on GitHub Pages; RDF serializations are served by
# content negotiation (RDF/XML, Turtle, JSON-LD, N-Triples).
# Source: https://github.com/sotirisAng/trajecto-stakg
#
# ## Contact
# This space is administered by:
#
# Sotirios Angelis
# GitHub username: sotirisAng

RewriteEngine on

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^temporal-dwell/?$ https://sotirisang.github.io/trajecto-stakg/temporal-dwell/ontology.owl [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^temporal-dwell/?$ https://sotirisang.github.io/trajecto-stakg/temporal-dwell/ontology.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^temporal-dwell/?$ https://sotirisang.github.io/trajecto-stakg/temporal-dwell/ontology.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^temporal-dwell/?$ https://sotirisang.github.io/trajecto-stakg/temporal-dwell/ontology.nt [R=303,L]
RewriteRule ^temporal-dwell/?$ https://sotirisang.github.io/trajecto-stakg/temporal-dwell/ [R=303,L]

