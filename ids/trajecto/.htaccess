# Versioned IRIs (e.g. /trajecto/poi/1.1.0) resolve to the current documentation
RewriteRule ^(.*?)/?[0-9]+\.[0-9]+(\.[0-9]+)?$ https://sotirisang.github.io/trajecto-stakg/$1 [R=303,L]
