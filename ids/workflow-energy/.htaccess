RewriteEngine on
RewriteRule ^run-metadata/research-software$ https://raw.githubusercontent.com/YagmurKati/workflow-energy-ontology/main/research-software.ttl [R=303,L]
RewriteRule ^run-metadata$ https://raw.githubusercontent.com/YagmurKati/workflow-energy-ontology/main/workflow-energy-core.ttl [R=303,L]
RewriteRule ^(.*)$ https://github.com/YagmurKati/workflow-energy-ontology [R=302,L]
