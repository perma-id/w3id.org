# # /ktl/
#
# Knowledge Trust Ladder (KTL): Agent Skills that keep a repository's
# knowledge as a LOKF knowledge bundle, with the trust in every claim left
# visible. https://w3id.org/ktl/ and everything under it redirects to the
# project's site, https://noelmcloughlin.github.io/knowledge-trust-ladder/.
#
# https://w3id.org/ktl/knowledge/ is the namespace of the bundle's concepts.
# A concept's IRI, such as https://w3id.org/ktl/knowledge/glossary/accession,
# resolves to its page in a browser, to its JSON-LD for application/ld+json,
# and to its Markdown file for text/markdown. The bundle's own IRI resolves to
# its page, to every concept as JSON-LD, or to the whole bundle as N-Triples.
# A path that names a file by its extension goes to that file.
#
# Source: https://github.com/noelmcloughlin/knowledge-trust-ladder
#
# ## Contact
# This space is administered by:
#
# Noel McLoughlin
# GitHub username: noelmcloughlin

RewriteEngine on

# A file named by its extension, such as knowledge/graph.nt or
# knowledge/glossary/accession.jsonld: the same path on the site.
RewriteRule ^(knowledge/.+\.(jsonld|json|md|nt))$ https://noelmcloughlin.github.io/knowledge-trust-ladder/$1 [R=302,L]

# The bundle.
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^knowledge/?$ https://noelmcloughlin.github.io/knowledge-trust-ladder/knowledge/concepts.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} (application/n-triples|text/turtle)
RewriteRule ^knowledge/?$ https://noelmcloughlin.github.io/knowledge-trust-ladder/knowledge/graph.nt [R=303,L]
RewriteRule ^knowledge/?$ https://noelmcloughlin.github.io/knowledge-trust-ladder/knowledge/ [R=303,L]

# A concept. Its ID is its path in the bundle: lowercase words joined by
# hyphens, in one or more folders.
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/knowledge-trust-ladder/knowledge/$1.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteRule ^knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/knowledge-trust-ladder/knowledge/$1.md [R=303,L]
RewriteRule ^knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/knowledge-trust-ladder/knowledge/$1/ [R=303,L]

# The federation's top domain, https://w3id.org/ktl/federation/knowledge/,
# kept in the ktl-federation repository, whose site, with the workspace
# built from the domain's members, is everything else under federation/.
RewriteRule ^federation/(knowledge/.+\.(jsonld|json|md|nt))$ https://noelmcloughlin.github.io/ktl-federation/$1 [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^federation/knowledge/?$ https://noelmcloughlin.github.io/ktl-federation/knowledge/concepts.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} (application/n-triples|text/turtle)
RewriteRule ^federation/knowledge/?$ https://noelmcloughlin.github.io/ktl-federation/knowledge/graph.nt [R=303,L]
RewriteRule ^federation/knowledge/?$ https://noelmcloughlin.github.io/ktl-federation/knowledge/ [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^federation/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/ktl-federation/knowledge/$1.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteRule ^federation/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/ktl-federation/knowledge/$1.md [R=303,L]
RewriteRule ^federation/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/ktl-federation/knowledge/$1/ [R=303,L]
RewriteRule ^federation(/.*)?$ https://noelmcloughlin.github.io/ktl-federation$1 [R=302,L]

# The KTL Curator plugin's own bundle, https://w3id.org/ktl/curator/knowledge/,
# kept in the obsidian-ktl-curator repository.
RewriteRule ^curator/(knowledge/.+\.(jsonld|json|md|nt))$ https://noelmcloughlin.github.io/obsidian-ktl-curator/$1 [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^curator/knowledge/?$ https://noelmcloughlin.github.io/obsidian-ktl-curator/knowledge/concepts.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} (application/n-triples|text/turtle)
RewriteRule ^curator/knowledge/?$ https://noelmcloughlin.github.io/obsidian-ktl-curator/knowledge/graph.nt [R=303,L]
RewriteRule ^curator/knowledge/?$ https://noelmcloughlin.github.io/obsidian-ktl-curator/knowledge/ [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^curator/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/obsidian-ktl-curator/knowledge/$1.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteRule ^curator/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/obsidian-ktl-curator/knowledge/$1.md [R=303,L]
RewriteRule ^curator/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/obsidian-ktl-curator/knowledge/$1/ [R=303,L]
RewriteRule ^curator(/.*)?$ https://noelmcloughlin.github.io/obsidian-ktl-curator$1 [R=302,L]

# The KTL Registrar plugin's own bundle, https://w3id.org/ktl/registrar/knowledge/,
# kept in the obsidian-ktl-registrar repository.
RewriteRule ^registrar/(knowledge/.+\.(jsonld|json|md|nt))$ https://noelmcloughlin.github.io/obsidian-ktl-registrar/$1 [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^registrar/knowledge/?$ https://noelmcloughlin.github.io/obsidian-ktl-registrar/knowledge/concepts.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} (application/n-triples|text/turtle)
RewriteRule ^registrar/knowledge/?$ https://noelmcloughlin.github.io/obsidian-ktl-registrar/knowledge/graph.nt [R=303,L]
RewriteRule ^registrar/knowledge/?$ https://noelmcloughlin.github.io/obsidian-ktl-registrar/knowledge/ [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^registrar/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/obsidian-ktl-registrar/knowledge/$1.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteRule ^registrar/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/obsidian-ktl-registrar/knowledge/$1.md [R=303,L]
RewriteRule ^registrar/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/obsidian-ktl-registrar/knowledge/$1/ [R=303,L]
RewriteRule ^registrar(/.*)?$ https://noelmcloughlin.github.io/obsidian-ktl-registrar$1 [R=302,L]

# linkml-sidecar's bundle, https://w3id.org/ktl/linkml-sidecar/knowledge/,
# kept in the linkml-sidecar repository, whose site is everything else under
# linkml-sidecar/.
RewriteRule ^linkml-sidecar/(knowledge/.+\.(jsonld|json|md|nt))$ https://noelmcloughlin.github.io/linkml-sidecar/$1 [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^linkml-sidecar/knowledge/?$ https://noelmcloughlin.github.io/linkml-sidecar/knowledge/concepts.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} (application/n-triples|text/turtle)
RewriteRule ^linkml-sidecar/knowledge/?$ https://noelmcloughlin.github.io/linkml-sidecar/knowledge/graph.nt [R=303,L]
RewriteRule ^linkml-sidecar/knowledge/?$ https://noelmcloughlin.github.io/linkml-sidecar/knowledge/ [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^linkml-sidecar/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/linkml-sidecar/knowledge/$1.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteRule ^linkml-sidecar/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/linkml-sidecar/knowledge/$1.md [R=303,L]
RewriteRule ^linkml-sidecar/knowledge/([a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*)$ https://noelmcloughlin.github.io/linkml-sidecar/knowledge/$1/ [R=303,L]
RewriteRule ^linkml-sidecar(/.*)?$ https://noelmcloughlin.github.io/linkml-sidecar$1 [R=302,L]

# Anything else: the same path on the site.
RewriteRule ^(.*)$ https://noelmcloughlin.github.io/knowledge-trust-ladder/$1 [R=302,L]
