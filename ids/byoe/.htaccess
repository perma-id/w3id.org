# BYOE (Bring Your Own Everything) application stack contexts
#
# homepage:
#   - https://github.com/interop-alliance/byoe-context
# maintainers:
#   - Dmitri Zagidulin (@dmitrizagidulin)
#
Header set Access-Control-Allow-Origin *
Header set Access-Control-Allow-Headers DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range
Options +FollowSymLinks
RewriteEngine on
RewriteRule ^v([0-9.]+)$ https://interop-alliance.github.io/byoe-context/contexts/v$1.jsonld [R=302,L]
RewriteRule ^app-connect/v([0-9.]+)$ https://interop-alliance.github.io/byoe-context/contexts/app-connect-v$1.jsonld [R=302,L]
RewriteRule ^encrypted-collections/v([0-9.]+)$ https://interop-alliance.github.io/byoe-context/contexts/encrypted-collections-v$1.jsonld [R=302,L]
RewriteRule ^$ https://interop-alliance.github.io/byoe-context/ [R=302,L]
