RewriteEngine on

RewriteRule ^$ https://monarchinitiative.org/ [R=302,L]

# Entity pages on the Monarch website, e.g. entity/MONDO:0007523
RewriteRule ^entity/(.*)$ https://monarchinitiative.org/$1 [R=302,L]

# Fall through: project documentation on the organisation's GitHub Pages
RewriteRule ^(.+)$ https://monarch-initiative.github.io/$1 [R=302,L]
