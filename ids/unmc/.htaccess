Options +FollowSymLinks
RewriteEngine on

RewriteRule ^(.+)/(.+)$  https://unmc-vcr.github.io/data-governance/$1/$2.html  [R=302,L]
RewriteRule ^(.*)$       https://unmc-vcr.github.io/data-governance/            [R=302,L]
