# # /bigcontext/
#
# Permanent identifiers minted by BigContext's software, such as Context Warehouse.
#
# ## Contact
# This space is administered by:
#
# Joji John
# GitHub username: joji-figlabs

RewriteEngine on

# Every identifier names a record that is private to its organization: every request, from a browser or a program,
# gets this space's description
RewriteRule ^ https://github.com/perma-id/w3id.org/tree/master/ids/bigcontext [R=302,L]
