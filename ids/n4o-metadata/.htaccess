# https://w3id.org/n4o-metadata/<ANYTHING> — permanent identifiers for metadata
# artefacts of NFDI4Objects.
#
# Currently one namespace is in use:
#
#   /n4o-metadata/prov-matrix/            the catalogue itself
#   /n4o-metadata/prov-matrix/JREAD3      one entry of the catalogue
#   /n4o-metadata/prov-matrix/scheme/type one of the two concept schemes
#
# Everything under prov-matrix/ resolves into the Linked-Data view generated
# from the published graph, where the path after the namespace maps one to one
# onto a directory holding index.html, index.ttl and index.json. The rules
# below therefore negotiate on Accept and hand out the matching representation.
#
# ## Contact
# This space is administered by:
#
# Florian Thiery
# GitHub username: @florianthiery
# email: florian.thiery@leiza.de

RewriteEngine on

# --- Turtle -----------------------------------------------------------------
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/n3 [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^prov-matrix/?$ https://n4o-rse.github.io/ta2-prov-tools-services-matrix/lod/index.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/n3 [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^prov-matrix/(.+?)/?$ https://n4o-rse.github.io/ta2-prov-tools-services-matrix/lod/$1/index.ttl [R=303,L]

# --- JSON -------------------------------------------------------------------
RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^prov-matrix/?$ https://n4o-rse.github.io/ta2-prov-tools-services-matrix/lod/index.json [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^prov-matrix/(.+?)/?$ https://n4o-rse.github.io/ta2-prov-tools-services-matrix/lod/$1/index.json [R=303,L]

# --- HTML, and anything that did not ask for a specific format --------------
RewriteRule ^prov-matrix/?$ https://n4o-rse.github.io/ta2-prov-tools-services-matrix/lod/index.html [R=303,L]
RewriteRule ^prov-matrix/(.+?)/?$ https://n4o-rse.github.io/ta2-prov-tools-services-matrix/lod/$1/index.html [R=303,L]

# --- anything else under this namespace -------------------------------------
# No second namespace exists yet; until one does, send visitors somewhere that
# explains what this space is rather than to a 404.
RewriteRule ^(.*)$ https://n4o-rse.github.io/ta2-prov-tools-services-matrix/ [R=303,L]
