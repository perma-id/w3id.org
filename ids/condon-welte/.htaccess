# The red Welte rolls of the Condon collection at Stanford Libraries, as linked data:
# premises for dating a roll, the classes of paper they name, and the hands that signed
# the rolls. The documents are served from GitHub Pages, so moving them means changing
# this file only.

RewriteEngine on

# premises and papers name JSON-LD documents without their extension, and their fragments
# name what each states: premises#advance-1mm-belief is the belief that the 1.0 mm advance
# was not used after a day. A browser is shown the page, which finds a premise or a paper
# by its fragment. Anything else is given the JSON-LD.
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^(premises|papers)$ https://pfefferniels.github.io/condon-dates/premises.html [R=303,L]
RewriteRule ^(premises|papers)$ https://pfefferniels.github.io/condon-dates/$1.jsonld [R=302,L]
RewriteRule ^evidence/([a-z0-9-]+)$ https://pfefferniels.github.io/condon-dates/evidence/$1.json [R=302,L]
RewriteRule ^context\.jsonld$ https://pfefferniels.github.io/condon-dates/context.jsonld [R=302,L]

# A hand, e.g. hands/fritz, names a person and is answered with 303 by the one document
# that describes them all, at hands. A browser is shown the hand's signatures on the
# front page.
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^hands/([a-z0-9-]+)$ https://pfefferniels.github.io/condon-dates/#$1 [R=303,NE,L]
RewriteRule ^hands/([a-z0-9-]+)$ https://pfefferniels.github.io/condon-dates/hands.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^hands$ https://pfefferniels.github.io/condon-dates/#registry-section [R=303,NE,L]
RewriteRule ^hands$ https://pfefferniels.github.io/condon-dates/hands.jsonld [R=302,L]

RewriteRule ^$ https://pfefferniels.github.io/condon-dates/ [R=302,L]
