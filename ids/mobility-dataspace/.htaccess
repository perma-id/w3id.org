Header always set Access-Control-Allow-Origin *

# Turn off MultiViews
Options -MultiViews

AddType application/ld+json .jsonld

RewriteEngine on

# Connector Management API JSON-LD contexts (mds-edc), one per published API version.
# https://w3id.org/mobility-dataspace/connector/management/v1
RewriteRule ^connector/management/(v1|v2)$ https://mobility-data-space.github.io/mds-edc/context/mds-management-context-$1.jsonld [R=302,L]

# MDS dataspace profile, one per published profile version (<YYYY>/<n>)
# JSON-LD contexts - https://w3id.org/mobility-dataspace/2026/1/policy/context.jsonld
RewriteRule ^(2026/1)/(policy|credentials|vocabulary)/context\.jsonld$ https://mobility-data-space.github.io/mds-profile/$1/$2/context.jsonld [R=302,L]

# JSON Schemas of the MDS verifiable credentials - https://w3id.org/mobility-dataspace/2026/1/credentials/MembershipCredential.schema.json
RewriteRule ^(2026/1)/credentials/([\w.-]+\.schema\.json)$ https://mobility-data-space.github.io/mds-profile/$1/credentials/$2 [R=302,L]

# Terms minted in a namespace: 303 to the term's section of the specification
# https://w3id.org/mobility-dataspace/2026/1/policy/ParticipantId
RewriteRule ^(2026/1)/(policy|credentials)/([A-Za-z]+)$ https://mobility-data-space.github.io/mds-profile/$1/$2/#$3 [NE,R=303,L]

# Namespaces, and anything else under them: 303 to the specification
RewriteRule ^(2026/1)/(policy|credentials|vocabulary)/?[^/]*$ https://mobility-data-space.github.io/mds-profile/$1/$2/ [R=303,L]

# The profile version itself - https://w3id.org/mobility-dataspace/2026/1/
RewriteRule ^(2026/1)/?$ https://mobility-data-space.github.io/mds-profile/$1/ [R=303,L]

# Default
RewriteRule ^.*$ https://github.com/Mobility-Data-Space/mds-profile [R=303,L]
