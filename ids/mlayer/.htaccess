Options +FollowSymLinks
RewriteEngine on
RewriteRule ^aspect/(.*)$ https://api.mlayer.org/aspects/$1 [R=303,L]
RewriteRule ^dimension/(.*)$ https://api.mlayer.org/dimensions/$1 [R=303,L]
RewriteRule ^function/(.*)$ https://api.mlayer.org/functions/$1 [R=303,L]
RewriteRule ^unit/(.*)$ https://api.mlayer.org/units/$1 [R=303,L]
RewriteRule ^scale/(.*)$ https://api.mlayer.org/scales/$1 [R=303,L]
RewriteRule ^system/(.*)$ https://api.mlayer.org/systems/$1 [R=303,L]
RewriteRule ^$ https://mlayer.org/ [R=303,L]
