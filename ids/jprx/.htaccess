# w3id.org/jprx  ->  JPRX ontology and knowledge graph
# Maintainer: Ming Shan Ng (GitHub: charmings33), ng@kit.ac.jp
Options +FollowSymLinks
RewriteEngine on

# Versioned ontology: https://w3id.org/jprx/ontology/2.0.0
RewriteRule ^ontology/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://charmings33.github.io/processatlas/ontology/$1/jprx_ontology.ttl [R=303,L]

# Current ontology (Turtle requested or default): https://w3id.org/jprx/ontology
RewriteRule ^ontology/?$ https://charmings33.github.io/processatlas/ontology/jprx_ontology.ttl [R=303,L]

# Anonymised public knowledge graph: https://w3id.org/jprx/kg
RewriteRule ^kg/?$ https://charmings33.github.io/processatlas/ontology/jprx_kg_public.ttl [R=303,L]

# Anything else: project page
RewriteRule ^.*$ https://charmings33.github.io/processatlas/ [R=303,L]
