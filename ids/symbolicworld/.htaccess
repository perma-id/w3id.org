# # /symbolicworld/
#
# Identifiers for The Symbolic World, a knowledge graph of C. G. Jung's
# Collected Works: https://symbolicworld.observer
#
# - a request that asks for Turtle (Accept: text/turtle) gets RDF:
#   /symbolicworld/ns the vocabulary, every other IRI the graph file,
#   which holds that resource's triples
# - /symbolicworld/ns (terms such as ns#Claim) goes to the vocabulary page
# - /symbolicworld/node/<id> goes to that concept's page
# - /symbolicworld/family/<id> goes to that family's page
# - /symbolicworld/claim/<id>, reference/<id> and edge/<id> go to that record
# - a gate, audit or family stage goes to the record it checks
# - relation, other stage, agent, author and text IRIs go to the vocabulary page
# - /symbolicworld/data/ goes to the dataset's Zenodo record
#
# ## Contact
# This space is administered by:
#
# Damian Spendel
# GitHub username: damianspendel

RewriteEngine on

# Content negotiation: Turtle on request
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle)
RewriteRule ^ns$ https://symbolicworld.observer/symbolicworld-ontology.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle)
RewriteRule ^(data/?|(node|family|relation|edge|claim|reference|stage|agent|author|text)/.+)$ https://symbolicworld.observer/symbolicworld-graph.ttl [R=303,L]

# Pages for people
RewriteRule ^$ https://symbolicworld.observer/ [R=302,L]
RewriteRule ^ns$ https://symbolicworld.observer/vocabulary [R=303,L]
RewriteRule ^node/([a-z0-9-]+)$ https://symbolicworld.observer/concept-$1 [R=303,L]
RewriteRule ^family/([a-z-]+)$ https://symbolicworld.observer/family-$1 [R=303,L]
RewriteRule ^(claim|reference)/([0-9a-f]{16}-[0-9a-z]+-[0-9]+(-[0-9]+)?)$ https://symbolicworld.observer/record?$1=$2 [R=303,L]
RewriteRule ^edge/([0-9a-f]{16})$ https://symbolicworld.observer/record?edge=$1 [R=303,L]
RewriteRule ^stage/([0-9a-f]{16}-[0-9a-z]+-[0-9]+(-[0-9]+)?)-(gate|audit)$ https://symbolicworld.observer/record?claim=$1 [R=303,L]
RewriteRule ^stage/([0-9a-f]{16})-(family|norm-proposal|norm-gate|norm-audit)$ https://symbolicworld.observer/record?edge=$1 [R=303,L]
RewriteRule ^(relation|edge|claim|reference|stage|agent|author|text)/ https://symbolicworld.observer/vocabulary [R=303,L]
RewriteRule ^data/ https://doi.org/10.5281/zenodo.21631523 [R=302,L]
