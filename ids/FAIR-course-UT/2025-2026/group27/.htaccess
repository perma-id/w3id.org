RewriteEngine on
RedirectMatch 301 ^/myproject/ont$ https://raw.githubusercontent.com/TKastelein/FDE-Project/refs/heads/main/ontology/fifa-world-cup-statistics.rdf [R=302,L]
RedirectMatch 301 ^/myproject/participations$ https://raw.githubusercontent.com/TKastelein/FDE-Project/refs/heads/main/fair-data/participation_stats.ttl [R=302,L]
