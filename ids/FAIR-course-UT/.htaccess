# # /FAIR-course-UT/
#
# Namespace for the resources of the FAIR Principles and FAIRification
# Process course of the University of Twente, the Netherlands.
# https://canvas.utwente.nl/courses/9711
#
# Every identifier under this namespace is forwarded to the course's own
# redirect service, where the rules of each course edition are maintained
# and tested before they go live:
# https://fair-testbed.eemcs.utwente.nl/pid/FAIR-course-UT/
# This file therefore stays the same from one course edition to the next.
#
# ## Contact
# This space is administered by:
#
# Luiz Olavo Bonino da Silva Santos
# l.o.boninodasilvasantos@utwente.nl
# GitHub username: luizbonino

RewriteEngine on
RewriteRule ^(.*)$ https://fair-testbed.eemcs.utwente.nl/pid/FAIR-course-UT/$1 [R=302,L]
