RewriteEngine on

# XenoBase catalogue IRIs live under /xenosite/xenobase/ (subdirectory .htaccess).
# Pass those paths through so they are not swallowed by the landing redirect.
RewriteRule ^xenobase(/.*)?$ - [L]

# Interim landing: everything else under /xenosite/ → xenosite.org
RewriteRule ^ https://xenosite.org/ [R=302,L]
