Options +FollowSymLinks
RewriteEngine on

RewriteRule ^readme/?$ https://github.com/erdemonal/eautonome/blob/main/README.md [R=303,L]

RewriteRule ^1\.0\.0/?$ https://erdemonal.github.io/eautonome/ontology/eautonome.ttl [R=303,L]

RewriteRule ^ontology\.ttl$ https://erdemonal.github.io/eautonome/ontology/eautonome.ttl [R=303,L]
RewriteRule ^eautonome-shapes\.ttl$ https://erdemonal.github.io/eautonome/ontology/eautonome-shapes.ttl [R=303,L]
RewriteRule ^eautonome\.(ttl|rdf|nt|jsonld)$ https://erdemonal.github.io/eautonome/ontology/eautonome.$1 [R=303,L]
RewriteRule ^ontology/(eautonome(?:-shapes)?\.(ttl|rdf|nt|jsonld))$ https://erdemonal.github.io/eautonome/ontology/$1 [R=303,L]

RewriteRule ^((?:shower|hydrodynamic)-observations\.jsonld)$ https://erdemonal.github.io/eautonome/data/$1 [R=303,L]
RewriteRule ^data/((?:shower|hydrodynamic)-observations\.jsonld)$ https://erdemonal.github.io/eautonome/data/$1 [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^/?$ https://erdemonal.github.io/eautonome/ontology/eautonome.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^/?$ https://erdemonal.github.io/eautonome/ontology/eautonome.rdf [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^/?$ https://erdemonal.github.io/eautonome/ontology/eautonome.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/n-triples [OR]
RewriteCond %{HTTP_ACCEPT} text/n3 [OR]
RewriteCond %{HTTP_ACCEPT} text/rdf\+n3
RewriteRule ^/?$ https://erdemonal.github.io/eautonome/ontology/eautonome.nt [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^/?$ https://erdemonal.github.io/eautonome/index.html [R=303,L]

RewriteRule ^/?$ https://erdemonal.github.io/eautonome/ontology/eautonome.ttl [R=303,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ https://erdemonal.github.io/eautonome/index.html [R=303,L]