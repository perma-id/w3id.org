# # /maktoob/
#
# Persistent identifiers for Maktoob, the reference vocabulary of impact
# management published by Narrate (SKOS concepts, collections and the
# ontology).
#
# https://w3id.org/maktoob/<path> redirects to https://narrate.works/id/<path>.
# The target negotiates the format itself (Turtle, JSON-LD or HTML from the
# Accept header, or a .ttl/.jsonld suffix), so the path is kept as it is.
#
# ## Contact
# This space is administered by:
#
# Jeroen (Narrate)
# GitHub username: jeroen-narrate

RewriteEngine on
RewriteRule ^(.*)$ https://narrate.works/id/$1 [R=303,L]
