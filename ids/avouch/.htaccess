# # /avouch/
#
# Permanent identifiers for Avouch, an ontology format whose every claim
# cites its source (experimental draft). Home: https://avouch.dev/
#
# https://w3id.org/avouch/v1/schema.json  -> https://avouch.dev/v1/schema.json
#   (the $id of the format's JSON Schema, version 1)
# https://w3id.org/avouch/v1/vocab        -> https://avouch.dev/v1/vocab.ttl
#   (vocabulary; terms are https://w3id.org/avouch/v1/vocab#<term>)
# https://w3id.org/avouch/<path>          -> https://avouch.dev/<path>
#
# ## Contact
# This space is administered by:
#
# Githon LLC
# contact@avouch.dev
# GitHub username: githonllc

RewriteEngine on
RewriteRule ^v1/vocab$ https://avouch.dev/v1/vocab.ttl [R=303,L]
RewriteRule ^(.*)$ https://avouch.dev/$1 [R=302,L]
