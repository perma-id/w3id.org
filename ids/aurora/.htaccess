Options +FollowSymLinks
RewriteEngine On

# Main ontology
RewriteRule ^$ https://raw.githubusercontent.com/GSYAtools/AURORA-Ontology/main/AURORA/AURORA.rdf [R=302,L]

# ROMA module
RewriteRule ^roma$ https://raw.githubusercontent.com/GSYAtools/AURORA-Ontology/main/AURORA/ROMA.rdf [R=302,L]

# EcoSec module
RewriteRule ^ecosec$ https://raw.githubusercontent.com/GSYAtools/AURORA-Ontology/main/AURORA/EcoSec.rdf [R=302,L]
