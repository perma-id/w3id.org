RewriteEngine On

# Ontology
RewriteRule ^ontology/?$ https://raw.githubusercontent.com/psymarkus/sharp-concepts/main/ontology.ttl [R=302,L]

# Concept Scheme
RewriteRule ^scheme/SHARP/?$ https://raw.githubusercontent.com/psymarkus/sharp-concepts/main/skos.ttl [R=302,L]

# Startseite
RewriteRule ^/?$ https://psymarkus.github.io/sharp-concepts/ [R=302,L]
RewriteRule ^index\.html/?$ https://psymarkus.github.io/sharp-concepts/ [R=302,L]

# Concept pages (Singular!)
RewriteRule ^concept/([^/]+)/?$ https://psymarkus.github.io/sharp-concepts/concept/$1.html [R=302,L]
RewriteRule ^concept/([^/]+)\.html/?$ https://psymarkus.github.io/sharp-concepts/concept/$1.html [R=302,L]
