# INTRO - https://w3id.org/lso/intro/
# Mostly from https://www.w3.org/TR/swbp-vocab-pub/#recipe3

Header always set Access-Control-Allow-Origin *
Header always set Access-Control-Allow-Headers DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type
Options +FollowSymLinks
Options -MultiViews

AddType application/rdf+xml .rdf
AddType application/rdf+xml .owl
# AddType text/turtle .ttl

RewriteEngine on

# ---------------------------------------------------------------------------
# 1. Current version (v1.0)
#    - ontology IRI:  https://w3id.org/lso/intro/        (always the latest version)
#    - version IRI:   https://w3id.org/lso/intro/v1.0    (this fixed version)
#    Humans  -> documentation page of the version: https://boberreither.github.io/INTRO/v1.0/
#               (= docs/v1.0/index.html). No #fragment is appended on purpose: a fragment of
#               the requested IRI (e.g. .../v1.0#INT1_Passage) is kept by the browser.
#    Others  -> OWL file (master)
#    For a new release (e.g. v1.1): see RELEASE comment at the end of this file.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^$ https://boberreither.github.io/INTRO/v1.0/ [R=303,NE,L]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^v1\.0$ https://boberreither.github.io/INTRO/v1.0/ [R=303,NE,L]

RewriteRule ^(|v1\.0)$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_v1.0.owl [R=303,L]

# ---------------------------------------------------------------------------
# 2. Older versions: OWL file for everybody (humans and machines)
# ---------------------------------------------------------------------------
RewriteRule ^beta202506$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_beta202506.owl [R=303,L]
RewriteRule ^beta202408$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_beta202408.owl [R=303,L]
RewriteRule ^beta202304$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_beta202304.owl [R=303,L]
RewriteRule ^beta202210$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_beta202210.owl [R=303,L]
RewriteRule ^beta202001$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_Beta202001.owl [R=303,L]
RewriteRule ^beta201901$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_Beta201901.owl [R=303,L]

# Alias, frozen at the last beta
RewriteRule ^currentbeta$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_beta202506.owl [R=302,L]

# ---------------------------------------------------------------------------
# 3. Version-less term IRIs, e.g. https://w3id.org/lso/intro/INT1_Passage
#    (INT1_Passage, INT_Motif, R10_hasPassage, R10i_isPassageOf, ...)
#    Humans  -> documentation page of the current version, anchored at the term
#    Others  -> OWL file (master), which defines the term under exactly this IRI
#    Must stay LAST, so that it does not swallow version names.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^((?:INT[0-9]*|R[0-9]+i?)_[A-Za-z0-9]+)$ https://boberreither.github.io/INTRO/v1.0/#$1 [R=303,NE,L]

RewriteRule ^((?:INT[0-9]*|R[0-9]+i?)_[A-Za-z0-9]+)$ https://raw.githubusercontent.com/BOberreither/INTRO/master/INTRO_v1.0.owl [R=303,L]

# ---------------------------------------------------------------------------
# RELEASE (e.g. v1.1) - what to change:
#  - docs: generate the new docs as docs/v1.1/index.html; docs/v1.0/ stays untouched;
#    in docs/index.html (redirect page) replace v1.0/ by v1.1/.
#  - section 1: add the v1.1 rules (humans -> .../INTRO/v1.1/, others -> INTRO_v1.1.owl);
#    point the ontology IRI (^$) and the term rules (section 3, humans and others) to v1.1.
#  - section 2: move v1.0 there (humans: .../INTRO/v1.0/, others: INTRO_v1.0.owl, ideally from tag v1.0).
# ---------------------------------------------------------------------------
