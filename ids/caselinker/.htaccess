# # /caselinker/
#
# https://w3id.org/caselinker/ redirects to the CaseLinker application.
# Resource and provenance IRIs are permanent names. The application
# serves the project and the graph browser, not a document per resource.
#
# https://w3id.org/caselinker/              -> https://caselinker.up.railway.app/
# https://w3id.org/caselinker/ns/provenance -> https://caselinker.up.railway.app/patterns
# https://w3id.org/caselinker/resource/...  -> https://caselinker.up.railway.app/patterns
#
# ## Contact
# This space is administered by:
#
# Mrinaal Ramachandran
# mrinaalr@gmail.com
# GitHub username: mrinaalr

RewriteEngine on

RewriteRule ^$ https://caselinker.up.railway.app/ [R=302,L]
RewriteRule ^ns/provenance/?$ https://caselinker.up.railway.app/patterns [R=302,L]
RewriteRule ^resource(/.*)?$ https://caselinker.up.railway.app/patterns [R=302,L]
RewriteRule ^ https://caselinker.up.railway.app/ [R=302,L]
