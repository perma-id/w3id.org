# /caselinker/
#
# Source of truth for perma-id/w3id.org → copy verbatim to
# `ids/caselinker/.htaccess` (PR against their master). Their docroot is
# `ids/`, so that file serves https://w3id.org/caselinker/…
#
# Rules match the path *after* `/caselinker/`:
#   https://w3id.org/caselinker/              -> https://caselinker.up.railway.app/
#   https://w3id.org/caselinker/resource/...  -> https://caselinker.up.railway.app/resource/...
#   https://w3id.org/caselinker/ns/provenance -> https://caselinker.up.railway.app/ns/provenance
#
# 303 See Other (httpRange-14): the w3id IRI names the resource; Railway
# returns a description (HTML / Turtle / JSON-LD via run/deref.py). Do not
# use 302 to /patterns — that drops the path.
#
# CORS is set on the application, not here (w3id checkers warn on redirect
# Access-Control headers). If the app host changes, edit only the target
# host below and re-submit this file.
#
# ## Contact
# This space is administered by:
#
# Mrinaal Ramachandran
# mrinaalr@gmail.com
# GitHub username: mrinaalr

RewriteEngine on

RewriteRule ^$ https://caselinker.up.railway.app/ [R=303,L]
RewriteRule ^(.*)$ https://caselinker.up.railway.app/$1 [R=303,L,QSA]
