# RevMeta vocabulary identifiers: https://w3id.org/revmeta/
# Maintainer: @mmarcinmichal (https://github.com/mmarcinmichal)
# Documentation: https://mmarcinmichal.github.io/revmeta/
# Published RDF describes the currently defined terms and guidance items.
RewriteEngine on

# Published representation files: retain direct document URLs.
RewriteRule ^(vocabulary\.(?:ttl|jsonld)|decision-states\.ttl|mappings\.sssom\.(?:ttl|tsv)|alignments\.ttl)$ https://mmarcinmichal.github.io/revmeta/$1 [R=303,L]

# The mapping set and the decision-state identifiers use separate RDF graphs.
RewriteRule ^mappings$ https://mmarcinmichal.github.io/revmeta/mappings.sssom.ttl [R=303,L]
RewriteRule ^(decisionStates|state/[A-Z_]+)$ https://mmarcinmichal.github.io/revmeta/decision-states.ttl [R=303,L]

# The vocabulary graph handles ontology IRIs (including guidance and sources).
# Membership/validity of a term is determined by the published RDF, not by w3id.
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^(.*)$ https://mmarcinmichal.github.io/revmeta/vocabulary.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^(.*)$ https://mmarcinmichal.github.io/revmeta/vocabulary.jsonld [R=303,L]

# Human-readable anchors exist for concepts and facets only.
RewriteRule ^$ https://mmarcinmichal.github.io/revmeta/index.html [R=303,L]
RewriteRule ^facet/([A-Za-z][A-Za-z0-9_-]*)$ https://mmarcinmichal.github.io/revmeta/index.html#facet-$1 [R=303,L,NE]
RewriteRule ^([A-Za-z][A-Za-z0-9_-]*\.[A-Za-z][A-Za-z0-9_-]*)$ https://mmarcinmichal.github.io/revmeta/index.html#concept-$1 [R=303,L,NE]
RewriteRule ^scheme$ https://mmarcinmichal.github.io/revmeta/index.html [R=303,L]

# Guidance, source metadata and properties have no HTML fragment targets.
RewriteRule ^(.+)$ https://mmarcinmichal.github.io/revmeta/vocabulary.ttl [R=303,L]
