# # /revmeta/
# Identifier: https://w3id.org/revmeta/
# Provisional RevMeta identifier redirects; DO NOT REGISTER without owner approval.
# Owner-controlled target: https://mmarcinmichal.github.io/revmeta/
# ## Contact
# Maintainer: Marcin Michał Mirończuk
# GitHub username: mmarcinmichal
# https://github.com/mmarcinmichal
RewriteEngine on

# Direct representation URLs, all present in the approved Pages site.
RewriteRule ^(vocabulary\.(?:ttl|jsonld)|decision-states\.ttl|mappings\.sssom\.(?:ttl|tsv)|alignments\.ttl)$ https://mmarcinmichal.github.io/revmeta/$1 [R=303,L]

# Mapping set and coding states are separate RDF graphs (Turtle only).
RewriteRule ^mappings$ https://mmarcinmichal.github.io/revmeta/mappings.sssom.ttl [R=303,L]
RewriteRule ^(?:decisionStates|state/(?:AMBIGUOUS|INSUFFICIENT_ACCESS|NEGATIVE_VERIFIED|NOT_ESTABLISHED|NOT_IN_SCOPE|SATISFIED|VOCABULARY_GAP))$ https://mmarcinmichal.github.io/revmeta/decision-states.ttl [R=303,L]

# Base vocabulary IRI: RDF on Accept, otherwise documentation.
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^$ https://mmarcinmichal.github.io/revmeta/vocabulary.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^$ https://mmarcinmichal.github.io/revmeta/vocabulary.jsonld [R=303,L]
RewriteRule ^$ https://mmarcinmichal.github.io/revmeta/index.html [R=303,L]

