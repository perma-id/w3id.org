RewriteEngine On

# Main ontology page
RewriteRule ^$ https://faith-tangara.github.io/utt-ontology/ [R=303,L]

# UTT ontology classes/properties
RewriteRule ^def/(.+)$ https://faith-tangara.github.io/utt-ontology/#$1 [NE,R=303,L]

# UTT controlled vocabulary concepts
RewriteRule ^voc/(.+)$ https://faith-tangara.github.io/utt-ontology/#$1 [NE,R=303,L]
