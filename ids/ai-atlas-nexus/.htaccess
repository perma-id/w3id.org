# w3id.org/ai-atlas-nexus - AI Atlas Nexus (IBM): "ai-risk-ontology", a LinkML
# ontology describing AI systems and their risks. Maintainers: see README.md.
#
# Upstream repository: https://github.com/IBM/ai-atlas-nexus (branch: main)
#   SCHEMA   src/ai_atlas_nexus/ai_risk_ontology/schema/    LinkML source modules
#   PROJECT  project/                                       gen-project artefacts
#   DOCS     https://ibm.github.io/ai-atlas-nexus/ontology/ gen-doc + MkDocs pages
#   STEM     ai-risk-ontology                               root schema name / artefact stem
#
# Resolution model (same conventions as w3id.org/linkml and w3id.org/lmodel):
#   <PID>                          browser -> DOCS; RDF/YAML/JSON via Accept header (303)
#   <PID>/<Term>                   class/slot/enum IRI (nexus: prefix); same conneg
#   <PID>/ai-risk-ontology.yaml    self-contained (merged) schema: importable downstream as
#                                    prefixes: {nexus: https://w3id.org/ai-atlas-nexus/}
#                                    imports:  [nexus:ai-risk-ontology]
#   <PID>/<module>.yaml            source module (common, ai_risk, ai_system, ...) = module id
#   <PID>/schema/<path>.yaml       any source file under SCHEMA (modular root included)
#   <PID>/<stem>.<ext>             gen-project artefact selected by extension
#   <PID>/graph_export/<path>      knowledge-graph exports (yaml, json, cypher, owl, latex)
#   <PID>/<tag>/<any of above>     pinned to a git tag, e.g. /v1.2.5/schema/common.yaml
#
# Why the merged schema: LinkML appends ".yaml" to an expanded CURIE import and
# resolves the modular root's "./common"-style imports against the *importing*
# file, so only an import-free schema is usable via `imports:` over HTTP.
# Direct loading (SchemaView(<PID>/schema/ai-risk-ontology.yaml)) works either way.
#
# Test harness: https://github.com/lmodel/w3id_smoke_test

# "always": this namespace only ever answers with 3xx, and plain "Header set"
# is applied to 2xx responses only. Browsers apply CORS checks to every hop.
Header always set Access-Control-Allow-Origin *
Options +FollowSymLinks
Options -MultiViews
RewriteEngine on

# MIME registrations (belt-and-braces; redirect targets set their own types)
AddType application/rdf+xml   .rdf
AddType text/turtle           .ttl
AddType application/ld+json   .jsonld
AddType text/shex             .shex
AddType application/yaml      .yaml

# ---------------------------------------------------------------------------
# Git ref selection. Default REF=main. A leading /v<semver>/ segment pins the
# raw targets to that tag and is stripped before the rules below run ([N]).
# Docs pages are not versioned: HTML requests always resolve to the latest.
# ---------------------------------------------------------------------------
RewriteRule ^(v[0-9][^/]*)/?$              https://github.com/IBM/ai-atlas-nexus/tree/$1 [R=302,NE,L]
RewriteRule ^(v[0-9][^/]*)/(.*)$           $2 [N,DPI,E=REF:$1]
RewriteCond %{ENV:REF} ^$
RewriteRule ^                              - [E=REF:main]

# ---------------------------------------------------------------------------
# Knowledge-graph exports (information resources, 302): graph_export/<fmt>/<file>
# Listed first: the export filenames share extensions with the artefact rules.
# ---------------------------------------------------------------------------
RewriteRule ^graph_export/(.+)$            https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/graph_export/$1 [R=302,NE,L]

# ---------------------------------------------------------------------------
# LinkML schema (303 See Other: the PID names the model, not the file)
# ---------------------------------------------------------------------------

# Root schema, self-contained. Produced by `make regenerate_project`
# (gen-linkml --mergeimports) into project/linkml/.
RewriteRule ^ai-risk-ontology\.yaml$       https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/linkml/ai-risk-ontology.merged.linkml.yaml [R=303,NE,L]
RewriteRule ^(.+)\.linkml\.yaml$           https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/linkml/$1.linkml.yaml [R=303,NE,L]

# Source tree: /schema/<path>[.yaml]; bare /schema -> modular root
RewriteRule ^schema/(.+)\.yaml$            https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/src/ai_atlas_nexus/ai_risk_ontology/schema/$1.yaml [R=303,NE,L]
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^schema/(.+?)/?$               https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/src/ai_atlas_nexus/ai_risk_ontology/schema/$1.yaml [R=303,NE,L]
RewriteRule ^schema/?$                     https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/src/ai_atlas_nexus/ai_risk_ontology/schema/ai-risk-ontology.yaml [R=303,NE,L]

# Source modules by id: https://w3id.org/ai-atlas-nexus/<module> + ".yaml"
# (LinkML resolves the root's "./<module>" imports here when the modular
# root is loaded directly from its PID.)
RewriteRule ^([^/]+)\.yaml$                https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/src/ai_atlas_nexus/ai_risk_ontology/schema/$1.yaml [R=303,NE,L]

# ---------------------------------------------------------------------------
# gen-project artefacts: project/<generator>/<stem>.<ext>  (303)
# ---------------------------------------------------------------------------

# Stem-implied aliases
RewriteRule ^context\.jsonld$              https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonld/ai-risk-ontology.context.jsonld [R=303,NE,L]
RewriteRule ^context\.json$                https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonld/ai-risk-ontology.context.jsonld [R=303,NE,L]

# GraphQL
RewriteRule ^(.+)\.graphql$                https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/graphql/$1.graphql [R=303,NE,L]

# JSON-LD context + full JSON-LD (.context.json variant for CDN compatibility)
RewriteRule ^(.+)\.context\.jsonld$        https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonld/$1.context.jsonld [R=303,NE,L]
RewriteRule ^(.+)\.context\.json$          https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonld/$1.context.jsonld [R=303,NE,L]
RewriteRule ^(.+)\.jsonld$                 https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonld/$1.jsonld [R=303,NE,L]

# JSON Schema
RewriteRule ^(.+)\.schema\.json$           https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonschema/$1.schema.json [R=303,NE,L]

# OWL (Turtle serialisation). .owl and .owl.ttl resolve to the same file.
RewriteRule ^(.+)\.owl(?:\.ttl)?$          https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/owl/$1.owl.ttl [R=303,NE,L]

# Prefix map
RewriteRule ^prefixmap/(.+)\.yaml$         https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/prefixmap/$1.yaml [R=303,NE,L]

# Protobuf, SHACL, ShEx (.shexc alias), SQL DDL
RewriteRule ^(.+)\.proto$                  https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/protobuf/$1.proto [R=303,NE,L]
RewriteRule ^(.+)\.shacl\.ttl$             https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/shacl/$1.shacl.ttl [R=303,NE,L]
RewriteRule ^(.+)\.shex$                   https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/shex/$1.shex [R=303,NE,L]
RewriteRule ^(.+)\.shexc$                  https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/shex/$1.shex [R=303,NE,L]
RewriteRule ^(.+)\.sql$                    https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/sqlschema/$1.sql [R=303,NE,L]

# Generic Turtle -> the OWL rendering (upstream publishes no separate gen-rdf output)
RewriteCond %{REQUEST_URI} !\.(owl|shacl)\.ttl$
RewriteRule ^(.+)\.ttl$                    https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/owl/$1.owl.ttl [R=303,NE,L]

# ---------------------------------------------------------------------------
# Content negotiation: extension-less requests only (namespace root or any
# term IRI such as /Risk, /hasRelatedRisk). One 303 per representation.
# ---------------------------------------------------------------------------

# Turtle -> OWL/Turtle
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^.*$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/owl/ai-risk-ontology.owl.ttl [R=303,NE,L]

# JSON-LD
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^.*$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonld/ai-risk-ontology.context.jsonld [R=303,NE,L]

# Plain JSON -> JSON-LD context (broadest JSON form). After ld+json so clients
# accepting both get the more specific representation.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/json [NC]
RewriteRule ^.*$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonld/ai-risk-ontology.context.jsonld [R=303,NE,L]

# JSON Schema
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/schema\+json [NC]
RewriteRule ^.*$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/jsonschema/ai-risk-ontology.schema.json [R=303,NE,L]

# SHACL (Turtle profile)
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/shacl\+turtle [NC]
RewriteRule ^.*$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/shacl/ai-risk-ontology.shacl.ttl [R=303,NE,L]

# ShEx
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/shex [NC]
RewriteRule ^.*$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/shex/ai-risk-ontology.shex [R=303,NE,L]

# LinkML YAML: a module id gets its source module; anything else gets the
# self-contained root schema.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/yaml [NC,OR]
RewriteCond %{HTTP_ACCEPT} text/yaml [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/x-yaml [NC]
RewriteRule ^(common|ai_risk|ai_capability|ai_system|ai_eval|ai_intrinsic|ai_aiuc|eu_ai_act|energy|semweb_context)/?$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/src/ai_atlas_nexus/ai_risk_ontology/schema/$1.yaml [R=303,NE,L]
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} application/yaml [NC,OR]
RewriteCond %{HTTP_ACCEPT} text/yaml [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/x-yaml [NC]
RewriteRule ^.*$ https://raw.githubusercontent.com/IBM/ai-atlas-nexus/%{ENV:REF}/project/linkml/ai-risk-ontology.merged.linkml.yaml [R=303,NE,L]

# HTML (browsers). gen-doc pages are flat under DOCS: one directory per
# class / slot / enum / module. Accept: */* is deliberately excluded here and
# handled by the catch-all below.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/html [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [NC]
RewriteRule ^([^/]+)/?$ https://ibm.github.io/ai-atlas-nexus/ontology/$1/ [R=303,NE,L]
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} text/html [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [NC]
RewriteRule ^(.*)$ https://ibm.github.io/ai-atlas-nexus/ontology/$1 [R=303,NE,L]

# 406 Not Acceptable: a specific Accept header that matched nothing above.
RewriteCond %{REQUEST_URI} !\.[^./]+$
RewriteCond %{HTTP_ACCEPT} .+
RewriteCond %{HTTP_ACCEPT} !\*/\*
RewriteRule ^.*$ - [R=406,L]

# ---------------------------------------------------------------------------
# Catch-all (unchanged behaviour from the original namespace registration):
# anything else -> documentation site.
# ---------------------------------------------------------------------------
RewriteRule ^$    https://ibm.github.io/ai-atlas-nexus/ontology/ [R=302,L]
RewriteRule ^(.*)$ https://ibm.github.io/ai-atlas-nexus/ontology/$1 [R=302,NE,L]
