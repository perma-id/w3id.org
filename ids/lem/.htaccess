Options -MultiViews
RewriteEngine On

RewriteRule ^$ https://github.com/put-teleinformatics-networks/lem-location-encoding-model [R=302,L]
RewriteRule ^1\.0/specification$ https://github.com/put-teleinformatics-networks/lem-location-encoding-model/blob/v1.0/LEM_Location_Encoding_Model_v1_0_PREPRINT_EN.pdf [R=302,L]
RewriteRule ^1\.0/schema/core$ https://raw.githubusercontent.com/put-teleinformatics-networks/lem-location-encoding-model/refs/tags/v1.0/schemas/lem-core.schema.json [R=302,L]
RewriteRule ^1\.0/profile/emergency$ https://raw.githubusercontent.com/put-teleinformatics-networks/lem-location-encoding-model/refs/tags/v1.0/schemas/lem-emergency-profile.schema.json [R=302,L]
RewriteRule ^1\.0/profile/network-infrastructure$ https://raw.githubusercontent.com/put-teleinformatics-networks/lem-location-encoding-model/refs/tags/v1.0/schemas/lem-network-infrastructure-profile.schema.json [R=302,L]
RewriteRule ^yang/lem-location$ https://raw.githubusercontent.com/put-teleinformatics-networks/lem-location-encoding-model/refs/tags/v1.0/yang/lem-location.yang [R=302,L]
