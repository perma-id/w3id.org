# # /raveneyeglobal/
#
# Persistent identifiers for Raveneye Global (the trading name of RavenGroup
# Global Tech Private Limited) and its published research. These IRIs are
# embedded as identifiers in the schema.org JSON-LD of https://raveneyeglobal.com/
# (the Organization node and each research study).
#
# https://w3id.org/raveneyeglobal/               -> https://raveneyeglobal.com/
# https://w3id.org/raveneyeglobal/org            -> https://raveneyeglobal.com/about/
# https://w3id.org/raveneyeglobal/research/      -> https://raveneyeglobal.com/research/
# https://w3id.org/raveneyeglobal/research/SLUG  -> https://raveneyeglobal.com/research/SLUG/
#
# ## Contact
# This space is administered by:
#
# Chandranshu Kumar
# contact@raveneyeglobal.com
# GitHub username: Chandranshuk

RewriteEngine on
RewriteRule ^$ https://raveneyeglobal.com/ [R=302,L]
RewriteRule ^org/?$ https://raveneyeglobal.com/about/ [R=302,L]
RewriteRule ^research/?$ https://raveneyeglobal.com/research/ [R=302,L]
RewriteRule ^research/([a-z0-9-]+)/?$ https://raveneyeglobal.com/research/$1/ [R=302,L]
