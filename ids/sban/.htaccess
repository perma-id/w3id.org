# SBAN: SHACL annotations for BI tools.

Header set Access-Control-Allow-Origin *
Options +FollowSymLinks
RewriteEngine on

# Vocabulary (hash namespace https://w3id.org/sban/ns#): Turtle document.
RewriteRule ^ns$ https://jhisse.github.io/metabase-sparql-driver/ns.ttl [R=303,L]

# The bare identifier resolves to the project.
RewriteRule ^$ https://github.com/jhisse/metabase-sparql-driver [R=302,L]
