# # /eunomia/
#
# https://w3id.org/eunomia/vds/v1  -> VDS JSON-LD context (eunomiaupm/vds-rdf)
# https://w3id.org/eunomia/vad/v1  -> VAD JSON-LD context (eunomiaupm/vds-rdf)
# https://w3id.org/eunomia/vds/ns  -> VDS vocabulary, Turtle or HTML (eunomiaupm/vds-rdf)
# https://w3id.org/eunomia/*       -> https://servicios-ging.dit.upm.es/json-ld/*
#
# ## Contact
# This space is administered by:
#
# GitHub username: caparicio-esd

RewriteEngine on

# JSON-LD contexts
RewriteRule ^vds/v1$ https://eunomiaupm.github.io/vds-rdf/vds-v1.jsonld [R=302,L]
RewriteRule ^vad/v1$ https://eunomiaupm.github.io/vds-rdf/vad-v1.jsonld [R=302,L]

# VDS vocabulary: Turtle for RDF clients, HTML otherwise.
# vds/ns, vds/ns/ and vds/ns/<Term> all resolve to the vocabulary; in HTML a
# term jumps to its anchor (NE keeps the # from being escaped as %23).
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^vds/ns(/.*)?$ https://eunomiaupm.github.io/vds-rdf/vocab.ttl [R=303,L]
RewriteRule ^vds/ns/([^/]+)$ https://eunomiaupm.github.io/vds-rdf/vocab.html#$1 [R=303,NE,L]
RewriteRule ^vds/ns(/.*)?$ https://eunomiaupm.github.io/vds-rdf/vocab.html [R=303,L]

# Everything else: existing JSON-LD contexts, vocabularies and ontologies
RewriteRule ^(.*)$ https://servicios-ging.dit.upm.es/json-ld/$1 [R=303,L]
