# Legal Ontologies Foundry (LOF) persistent identifiers
# GENERATED by scripts/build_registry.py from the Foundry registry.
# Do not edit by hand; regenerate and resubmit.
# Registry: https://legal-ontologies-foundry.github.io/registry/

Options +FollowSymLinks
RewriteEngine on

# Machine-readable registry
RewriteRule ^registry/ontologies\.(yml|jsonld)$ https://legal-ontologies-foundry.github.io/registry/ontologies.$1 [R=302,L]

# ---- nao (NAO) ----
RewriteRule ^nao\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-nao/main/lof-nao.owl [R=302,L]
RewriteRule ^nao/(?:lof-)?nao-base\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-nao/main/lof-nao-base.owl [R=302,L]
RewriteRule ^nao/releases/([^/]+)/(?:lof-)?nao\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-nao/v$1/lof-nao.owl [R=302,L]
RewriteRule ^nao/releases/([^/]+)/(?:lof-)?nao-base\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-nao/v$1/lof-nao-base.owl [R=302,L]
RewriteRule ^nao/imports/(.+)$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-nao/main/src/ontology/imports/$1 [R=302,L]
RewriteRule ^nao/tracker$ https://github.com/legal-ontologies-foundry/lof-nao/issues [R=302,L]
RewriteRule ^nao/home$ https://github.com/legal-ontologies-foundry/lof-nao [R=302,L]
RewriteRule ^NAO_([0-9]{7})$ https://legal-ontologies-foundry.github.io/ontologies/nao/ [R=302,L]

