   # Legal Ontologies Foundry (LOF) persistent identifiers
   # GENERATED by scripts/build_registry.py from the Foundry registry.
   # Do not edit by hand; regenerate and resubmit.
   # Registry: https://legal-ontologies-foundry.github.io/registry/

   Options +FollowSymLinks
   RewriteEngine on

   # Machine-readable registry
   RewriteRule ^registry/ontologies\.(yml|jsonld)$ https://legal-ontologies-foundry.github.io/registry/ontologies.$1 [R=302,L]

   # ---- odp-001 (ODP001) ----
   RewriteRule ^odp-001\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-001/main/lof-odp-001.owl [R=302,L]
   RewriteRule ^odp-001/odp-001-base\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-001/main/lof-odp-001-base.owl [R=302,L]
   RewriteRule ^odp-001/releases/([^/]+)/odp-001\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-001/v$1/lof-odp-001.owl [R=302,L]
   RewriteRule ^odp-001/releases/([^/]+)/odp-001-base\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-001/v$1/lof-odp-001-base.owl [R=302,L]
   RewriteRule ^odp-001/imports/(.+)$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-001/main/src/ontology/imports/$1 [R=302,L]
   RewriteRule ^odp-001/tracker$ https://github.com/legal-ontologies-foundry/lof-odp-001/issues [R=302,L]
   RewriteRule ^odp-001/home$ https://github.com/legal-ontologies-foundry/lof-odp-001 [R=302,L]
   RewriteRule ^ODP001_([0-9]{7})$ https://legal-ontologies-foundry.github.io/ontologies/odp-001/ [R=302,L]

   # ---- odp-002 (ODP002) ----
   RewriteRule ^odp-002\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-002/main/lof-odp-002.owl [R=302,L]
