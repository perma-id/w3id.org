   RewriteRule ^odp-002/releases/([^/]+)/odp-002\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-002/v$1/lof-odp-002.owl [R=302,L]
   RewriteRule ^odp-002/releases/([^/]+)/odp-002-base\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-002/v$1/lof-odp-002-base.owl [R=302,L]
   RewriteRule ^odp-002/imports/(.+)$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-002/main/src/ontology/imports/$1 [R=302,L]
   RewriteRule ^odp-002/tracker$ https://github.com/legal-ontologies-foundry/lof-odp-002/issues [R=302,L]
   RewriteRule ^odp-002/home$ https://github.com/legal-ontologies-foundry/lof-odp-002 [R=302,L]
   RewriteRule ^ODP002_([0-9]{7})$ https://legal-ontologies-foundry.github.io/ontologies/odp-002/ [R=302,L]

   # ---- odp-003 (ODP003) ----
   RewriteRule ^odp-003\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-003/main/lof-odp-003.owl [R=302,L]
   RewriteRule ^odp-003/odp-003-base\.owl$ https://raw.githubusercontent.com/legal-ontologies-foundry/lof-odp-003/main/lof-odp-003-base.owl [R=302,L]
