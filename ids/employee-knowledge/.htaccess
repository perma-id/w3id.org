RewriteEngine on
RewriteRule ^ontology$ https://raw.githubusercontent.com/codcod/employee-knowledge/main/src/ek/ontology/employees.ttl [R=302,L]
RewriteRule ^ https://github.com/codcod/employee-knowledge [R=302,L]
