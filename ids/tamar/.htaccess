RewriteEngine on
RewriteRule ^taxonomy/(.*?)/ https://github.com/dsd-sztaki-hu/TaMaR/tree/main/taxonomies/$1 [R=302,L]
RewriteRule ^mapping/(.*?)/ https://github.com/dsd-sztaki-hu/TaMaR/tree/main/mappings/$1 [R=302,L]
RewriteRule ^ https://github.com/dsd-sztaki-hu/TaMaR/ [R=302,L]
