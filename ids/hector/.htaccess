# w3id.org/hector -> https://docuracy.github.io/hector/
# Maintainer: Stephen Gadd <stephen@docuracy.co.uk> (see README.md)

# Allow all (*) origins to access the resource on the server
Header set Access-Control-Allow-Origin *

Options +FollowSymLinks
Options -MultiViews

RewriteEngine on

# ---------------------------------------------------------------------------
# Fixed redirects (any Accept header)
# ---------------------------------------------------------------------------

# /about -> the GitHub repository
RewriteRule ^about/?$ https://github.com/docuracy/hector [R=303,L]

# /context -> the JSON-LD context
RewriteRule ^context/?$ https://docuracy.github.io/hector/context/hector.jsonld [R=303,L]

# /dump -> every record in one gzipped Turtle file
RewriteRule ^dump/?$ https://docuracy.github.io/hector/dump/hector.ttl.gz [R=303,L]

# A path ending in a file name (ledgers, the dump, the search index, a record's
# ontology.json / .ttl / .rdf, the site's own assets) is passed straight through.
RewriteRule ^(.+\.[A-Za-z0-9]+)$ https://docuracy.github.io/hector/$1 [R=303,L]

# ---------------------------------------------------------------------------
# Content negotiation for records: /<path> or /<path>/
#   JSON-LD (the primary format), then Turtle, then RDF/XML; mod_rewrite cannot
#   weigh q-values, so a client listing several gets the first in this order.
#   The site root is left to the HTML page.
# ---------------------------------------------------------------------------

RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^(.+?)/?$ https://docuracy.github.io/hector/$1/ontology.json [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^(.+?)/?$ https://docuracy.github.io/hector/$1/ontology.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^(.+?)/?$ https://docuracy.github.io/hector/$1/ontology.rdf [R=303,L]

# ---------------------------------------------------------------------------
# Everything else (browsers): the site, which shows the record for ?path=
# ---------------------------------------------------------------------------

RewriteRule ^(.*?)/?$ https://docuracy.github.io/hector/index.html?path=$1 [R=303,L]
