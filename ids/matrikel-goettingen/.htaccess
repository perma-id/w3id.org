# # /matrikel-goettingen/
#
# Permanent identifiers for the digital edition of the Göttingen University
# matriculation register (Die Matrikel der Georg-August-Universität zu Göttingen,
# 1734–1837; ed. Götz von Selle 1937), 39,177 entries, machine-read and checked
# against the page images, with a permanent identifier and an image clipping
# per entry. Data CC BY 4.0; archived versions with DOI at Zenodo (from 1.0).
#
# https://w3id.org/matrikel-goettingen/ and everything under it redirects, path
# preserved, to https://hassmann.com/research/matrikel-goe/ — the site serving
# the current version. The identifier is the path, so the site's own addresses
# are the permanent ones:
#
#   /                        start page of the current version
#   /eintrag/<id>            one entry; <id> is the matriculation number of the
#                            1937 print (e.g. 22761, 12807a) and never changes
#   /bild/eintrag/<id>.png   the image clipping of that entry
#   /daten/                  downloads of every version; /daten/<version>/<file>
#   /doku/<name>             documentation shipped with the version
#   /api/eintrag/<id>.json   machine-readable entry
#   /doi                     the dataset's concept DOI (activated with version 1.0)
#
# ## Contact
# This space is administered by:
#
# Andreas Hassmann
# andreas@hassmann.com
# GitHub username: Hassmann

RewriteEngine on

# The concept DOI of the archived dataset at Zenodo — activated with version 1.0.
# RewriteRule ^doi/?$ https://doi.org/10.5281/zenodo.XXXXXXX [R=302,L]

RewriteRule ^(.*)$ https://hassmann.com/research/matrikel-goe/$1 [R=302,L]
