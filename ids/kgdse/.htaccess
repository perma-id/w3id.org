# # /kgdse/
#
# KG-DSE: a traceable evidence graph of dataset use in knowledge graph
# research. It links research categories, subtasks and datasets to the exact
# location of the evidence in the literature (systematic mapping study).
# Source and data: https://github.com/gate-institute/kg-datasets
#
# - https://w3id.org/kgdse/                 the resource (website, or the
#                                            RDF graph for RDF clients)
# - https://w3id.org/kgdse/vocab            the kd: vocabulary (vocab#Term)
# - https://w3id.org/kgdse/shapes           the SHACL shapes (shapes#Shape)
# - https://w3id.org/kgdse/<kind>/<id>      a resource in the graph, e.g.
#   dataset/KGD-0001, record/B01-R001, subtask/CMP-01. Browsers get its page
#   on the website; RDF clients get the graph that describes it.
#
# ## Contact
# This space is administered by:
#
# Boniface Chukwuemeka Godwin
# GitHub username: BeefaceData
#
# Petar Tomov
# GitHub username: ptrtmv

RewriteEngine on

# Vocabulary and shapes: Turtle documents for every client
RewriteRule ^vocab$ https://gate-institute.github.io/kg-datasets/rdf/kgdse-vocab.ttl [R=303,L]
RewriteRule ^shapes$ https://gate-institute.github.io/kg-datasets/rdf/kgdse-shapes.ttl [R=303,L]

# Resources, RDF clients: the graph that describes them
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^(category|subtask|facet|domain|role|scheme|dataset|variant|report|study|record|peripheral|decision|decision-move|evidence|sample|agent)/[^/]+$ https://gate-institute.github.io/kg-datasets/rdf/kgdse.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^(category|subtask|facet|domain|role|scheme|dataset|variant|report|study|record|peripheral|decision|decision-move|evidence|sample|agent)/[^/]+$ https://gate-institute.github.io/kg-datasets/rdf/kgdse.nt [R=303,L]

# Resources, everyone else: their page on the website (fragment route, so NE)
RewriteRule ^(category|subtask|dataset|variant|report|study|record)/([^/]+)$ https://gate-institute.github.io/kg-datasets/#$1/$2 [R=303,NE,L]
RewriteRule ^(facet|domain|role|scheme)/[^/]+$ https://gate-institute.github.io/kg-datasets/#taxonomy [R=303,NE,L]
RewriteRule ^(peripheral|decision|decision-move|evidence|sample|agent)/[^/]+$ https://gate-institute.github.io/kg-datasets/#data [R=303,NE,L]

# The resource itself
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^$ https://gate-institute.github.io/kg-datasets/rdf/kgdse.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://gate-institute.github.io/kg-datasets/rdf/kgdse.nt [R=303,L]
RewriteRule ^$ https://gate-institute.github.io/kg-datasets/ [R=302,L]
