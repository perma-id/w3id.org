# # /vitrine/
#
# Namespace for Vitrine, a rendering layer that turns an IRI into HTML.
# /ns is the vocabulary, /context the JSON-LD context. Terms live in the
# hash namespace of one document, so adding a term needs no change here.
#
# Maintainer details are in README.md.

RewriteEngine on

RewriteRule ^ns/?$ https://aleph.garden/ns/vitrine [R=302,L]

RewriteRule ^context/?$ https://aleph.garden/ns/vitrine-context.jsonld [R=302,L]
