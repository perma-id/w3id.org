# https://w3id.org/geochem/metadata/ -- geochemistry metadata profiles
# (amds-ldeo/geochemBuildingBlocks). See README.md.
#
#   https://w3id.org/geochem/metadata/profiles/1.1/{name}
#
# The 1.1 is the CDIF version the profile is built on. Every target is the repository at the
# tag profiles-1.1, not its main branch, so a 1.1 URI keeps resolving to the 1.1 schema after the
# profiles move to a later CDIF.
#
#   Accept: application/schema+json or application/json  -> the resolved JSON Schema
#   .../{name}/schema                                    -> the resolved JSON Schema
#   .../{name}/shacl                                     -> the SHACL rules, for the profiles that have them
#   anything else                                          -> the building block's folder on GitHub

Header set Access-Control-Allow-Origin *
Options -MultiViews +FollowSymLinks
RewriteEngine on

SetEnvIf Request_URI ^.*$ GBB_RAW=https://raw.githubusercontent.com/amds-ldeo/geochemBuildingBlocks/refs/tags/profiles-1.1
SetEnvIf Request_URI ^.*$ GBB_TREE=https://github.com/amds-ldeo/geochemBuildingBlocks/tree/profiles-1.1

# adaAIVA
RewriteRule ^profiles/1\.1/adaAIVA/schema$ %{ENV:GBB_RAW}/_sources/techniqueProfile/adaProfile/AIVA/profile-ada/resolvedSchema.json [R=303,L]
RewriteRule ^profiles/1\.1/adaAIVA/shacl$ %{ENV:GBB_RAW}/_sources/techniqueProfile/adaProfile/AIVA/profile-ada/rules.shacl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/(schema\+)?json
RewriteRule ^profiles/1\.1/adaAIVA$ %{ENV:GBB_RAW}/_sources/techniqueProfile/adaProfile/AIVA/profile-ada/resolvedSchema.json [R=303,L]
RewriteRule ^profiles/1\.1/adaAIVA$ %{ENV:GBB_TREE}/_sources/techniqueProfile/adaProfile/AIVA/profile-ada [R=303,L]

# adaAMS
RewriteRule ^profiles/1\.1/adaAMS/schema$ %{ENV:GBB_RAW}/_sources/techniqueProfile/adaProfile/AMS/profile-ada/resolvedSchema.json [R=303,L]
