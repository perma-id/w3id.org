# DirectKG — persistent identifier namespace
# https://w3id.org/directkg/ identifies the OntoUML DirectKG project.
# Subordinate identifiers are reserved for individually verified, published resources;
# no catch-all redirect is configured.
# Maintainer: Pedro Paulo Favato Barcelos
# GitHub username: pedropaulofb
# Project: https://github.com/pedropaulofb/ontouml-directkg

RewriteEngine on
RewriteRule ^$ https://github.com/pedropaulofb/ontouml-directkg [R=302,L]
