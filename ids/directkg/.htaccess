# DirectKG — persistent identifier namespace
# Namespace root and /docs lead to the project's documentation website.
# Maintainer: Pedro Paulo Favato Barcelos
# GitHub username: pedropaulofb
# Project: https://github.com/pedropaulofb/ontouml-directkg

RewriteEngine on
RewriteRule ^$ https://pedropaulofb.github.io/ontouml-directkg/ [R=302,L]
RewriteRule ^docs/?$ https://pedropaulofb.github.io/ontouml-directkg/ [R=302,L]
RewriteRule ^git/?$ https://github.com/pedropaulofb/ontouml-directkg [R=302,L]
RewriteRule ^pypi/?$ https://pypi.org/project/ontouml-directkg/ [R=302,L]
RewriteRule ^releases/latest/?$ https://github.com/pedropaulofb/ontouml-directkg/releases/latest [R=302,L]
RewriteRule ^releases/(v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))/?$ https://github.com/pedropaulofb/ontouml-directkg/releases/tag/$1 [R=302,L]
