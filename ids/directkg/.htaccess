# DirectKG — persistent identifier namespace
# Namespace root and /docs lead to the project's documentation website.
# Maintainer: Pedro Paulo Favato Barcelos
# GitHub username: pedropaulofb
# Project: https://github.com/pedropaulofb/ontouml-directkg

RewriteEngine on
RewriteRule ^$ https://pedropaulofb.github.io/ontouml-directkg/ [R=302,L]
RewriteRule ^docs/?$ https://pedropaulofb.github.io/ontouml-directkg/ [R=302,L]
RewriteRule ^git/?$ https://github.com/pedropaulofb/ontouml-directkg [R=302,L]
RewriteRule ^pypi/?$ https://pypi.org/project/ontouml-directkg/ [R=302,L]
RewriteRule ^releases/latest/?$ https://github.com/pedropaulofb/ontouml-directkg/releases/latest [R=302,L]
RewriteRule ^releases/(v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))/?$ https://github.com/pedropaulofb/ontouml-directkg/releases/tag/$1 [R=302,L]

# Explicit downloads and documentation for the current vocabulary.
RewriteRule ^vocab/ttl/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/latest/dkgm-vocabulary.ttl [R=302,L]
RewriteRule ^vocab/docs/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/latest/index.html [R=302,L]

# Explicit downloads and documentation for a numbered vocabulary release.
RewriteRule ^vocab/((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))/ttl/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/versioned/dkgm-vocabulary-v$1.ttl [R=302,L]
RewriteRule ^vocab/((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))/docs/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/versioned/dkgm-vocabulary-v$1.html [R=302,L]

# The ontology IRI redirects to Turtle when explicitly accepted, or HTML otherwise.
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^vocab/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/latest/dkgm-vocabulary.ttl [R=303,L]
RewriteRule ^vocab/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/latest/index.html [R=303,L]

# The owl:versionIRI for each release has the same content-negotiated behavior.
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^vocab/((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/versioned/dkgm-vocabulary-v$1.ttl [R=303,L]
RewriteRule ^vocab/((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))/?$ https://pedropaulofb.github.io/ontouml-directkg/vocabulary/versioned/dkgm-vocabulary-v$1.html [R=303,L]
