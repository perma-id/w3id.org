RewriteEngine On

RewriteRule ^$ https://wanqin-liu.github.io/ahkto/doc/index-en.html [R=302,L]

RewriteRule ^ontology\.owl$ https://wanqin-liu.github.io/ahkto/doc/ontology.owl [R=302,L]

RewriteRule ^ontology\.ttl$ https://wanqin-liu.github.io/ahkto/doc/ontology.ttl [R=302,L]

RewriteRule ^0\.1\.0$ https://wanqin-liu.github.io/ahkto/doc/ontology.owl [R=302,L]

RewriteRule ^([^/]+)$ https://wanqin-liu.github.io/ahkto/doc/index-en.html [R=302,L]
