# # /skeleton-ontology/
#
# Persistent identifier namespace for Skeleton ontology: The Skeleton ontology
# supplies the structural backbone for representing experimental and 
# manufacturing procedures as knowledge graphs. It is intentionally minimal:
# it draws on the essential classes of EMMO and its domain modules, and
# introduces new terms namely for process parameters and for the planning of
# procedures and objects.

#
# Resources are served from https://dlr-dw.gitlab.io/skeleton-ontology/ with
# content negotiation: Turtle, RDF/XML, N-Triples or JSON-LD for RDF clients,
# HTML for browsers.
# Source: https://gitlab.com/dlr-dw/skeleton-ontology
#
# ## Contact
# This space is administered by:
#
# Oliver Helle
# GitHub username: oliverhelle
# Contact: oliver.helle@dlr.com


# Turn off MultiViews
Options -MultiViews

# Directive to ensure *.rdf files served as appropriate content type,
# if not present in main apache config
AddType application/rdf+xml .rdf
AddType application/rdf+xml .owl
AddType text/turtle .ttl
AddType application/n-triples .n3
AddType application/ld+json .json
AddType application/ld+json .jsonld

RewriteEngine on


############################## Rules for Previous Versions ##############################

# Rewrite rule to serve HTML with local name
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteCond %{REQUEST_URI} /(\d+)\.(\d+)\.(\d+)/(.+)$
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/archive/%1.%2.%3/index.html#%4 [NE,R=303,L]

# Rewrite rule to serve HTML without local name
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteCond %{REQUEST_URI} /(\d+)\.(\d+)\.(\d+)
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/archive/%1.%2.%3/index.html [NE,R=303,L]

# Rewrite rule to serve JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteCond %{REQUEST_URI} /(\d+)\.(\d+)\.(\d+)
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/archive/%1.%2.%3/ontology.jsonld [R=303,L]

# Rewrite rule to serve RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteCond %{REQUEST_URI} /(\d+)\.(\d+)\.(\d+)
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/archive/%1.%2.%3/ontology.owl [R=303,L]

# Rewrite rule to serve N-Triples content
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteCond %{REQUEST_URI} /(\d+)\.(\d+)\.(\d+)
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/archive/%1.%2.%3/ontology.nt [R=303,L]

# Rewrite rule to serve TTL content
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteCond %{REQUEST_URI} /(\d+)\.(\d+)\.(\d+)
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/archive/%1.%2.%3/ontology.ttl [R=303,L]


############################## Rules for individual Concepts ##############################

# Rewrite rule to serve HTML with local name
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteCond %{REQUEST_URI} /skeleton-ontology/(.+)$
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/index.html#%1 [NE,R=303,L]

# Rewrite rule to serve JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteCond %{REQUEST_URI} /skeleton-ontology/(.+)$
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.jsonld [R=303,L]

# Rewrite rule to serve RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteCond %{REQUEST_URI} /skeleton-ontology/(.+)$
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.owl [R=303,L]

# Rewrite rule to serve N-Triples content
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteCond %{REQUEST_URI} /skeleton-ontology/(.+)$
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.nt [R=303,L]

# Rewrite rule to serve TTL content
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteCond %{REQUEST_URI} /skeleton-ontology/(.+)$
RewriteRule ^ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.ttl [R=303,L]


############################## Rules for Full Versions ##############################

# Rewrite rule to serve HTML
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^$ https://dlr-dw.gitlab.io/skeleton-ontology/index.html [R=303,L]

# Rewrite rule to serve JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.jsonld [R=303,L]

# Rewrite rule to serve RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.owl [R=303,L]

# Rewrite rule to serve N-Triples
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.nt [R=303,L]

# Rewrite rule to serve TTL
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/\* [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^$ https://dlr-dw.gitlab.io/skeleton-ontology/ontology.ttl [R=303,L]


# Default response
# ---------------------------
# default response is the documentation page
RewriteRule ^$ https://dlr-dw.gitlab.io/skeleton-ontology/ [R=303,L]
