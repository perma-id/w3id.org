RewriteEngine On

# Main OFBO ontology (redirects base URI to raw ontology file)
RewriteRule ^$ https://raw.githubusercontent.com/rfb-predictor/OFBO/main/ontology/OFBO.ttl [R=302,L]

# Documentation redirect (redirects /docs to GitHub Pages)
RewriteRule ^docs/?$ https://rfb-predictor.github.io/OFBO/ [R=302,L]

# OFBO imported ontology modules
RewriteRule ^imports/chmo-subset$ https://raw.githubusercontent.com/rfb-predictor/OFBO/main/ontology/imports/chmo-subset.ttl [R=302,L]
RewriteRule ^imports/mdo-subset$ https://raw.githubusercontent.com/rfb-predictor/OFBO/main/ontology/imports/mdo-subset.ttl [R=302,L]
RewriteRule ^imports/prov-o-subset$ https://raw.githubusercontent.com/rfb-predictor/OFBO/main/ontology/imports/prov-o-subset.ttl [R=302,L]
RewriteRule ^imports/qudt-subset$ https://raw.githubusercontent.com/rfb-predictor/OFBO/main/ontology/imports/qudt-subset.ttl [R=302,L]