# /em/ — legacy alias of /extendedmatrix/
#
# Extended Matrix (CNR-ISPC). Before /extendedmatrix/ was registered
# (perma-id/w3id.org#6722), the Extended Matrix tools published IRIs under /em/
# (the ontology namespace https://w3id.org/em/ontology# and the node IRIs of
# exported RDF). This permanently redirects every path to the same path under
# /extendedmatrix/.
#
# Contact: Emanuel Demetrescu, CNR-ISPC, emanuel.demetrescu@cnr.it
# GitHub username: zalmoxes-laran

Options +FollowSymLinks
RewriteEngine on
RewriteRule ^(.*)$ https://w3id.org/extendedmatrix/$1 [R=301,L]
