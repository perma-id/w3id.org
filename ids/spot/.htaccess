# # /spot/
#
# Content-negotiated IRIs for the Space Types Ontology (SPOT).
#
# https://w3id.org/spot/ redirects to
# https://design-computation-rwth.github.io/spot/
#
# ## Contact
# This space is administered by:
#
# Anne Göbels
# goebels@dc.rwth-aachen.de
# GitHub username: AnneGoebels
#
# Oliver Schulz
# schulz@dc.rwth-aachen.de
# GitHub username: OlliSchu

Options +FollowSymLinks
RewriteEngine on

# Turn off MultiViews
Options -MultiViews

AddType text/turtle .ttl
AddType application/rdf+xml .rdf

# Rewrite rule to serve HTML content from the vocabulary URI if requested
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^$ https://design-computation-rwth.github.io/spot/ [R=302,NE,L]

# In case of accept header <text/turtle>
RewriteCond %{HTTP_ACCEPT} ^.*text/turtle.*
RewriteRule ^$ https://design-computation-rwth.github.io/spot/ontology.ttl [R=303,NE,L]

# In case of accept header <application/rdf+xml>
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://design-computation-rwth.github.io/spot/ontology.xml [R=302,NE,L]

# If suffix ttl, redirect to turtle version
RewriteRule ^ontology\.ttl$ https://design-computation-rwth.github.io/spot/ontology.ttl [R=302,NE,L]

# If suffix html, redirect to html version
RewriteRule ^ontology\.html$ https://design-computation-rwth.github.io/spot/ [R=302,NE,L]

# If suffix rdf, redirect to rdf version
RewriteRule ^ontology\.rdf$ https://design-computation-rwth.github.io/spot/ontology.xml [R=302,NE,L]

# If suffix jsonld, redirect to jsonld version
RewriteRule ^ontology\.jsonld$ https://design-computation-rwth.github.io/spot/ontology.json [R=302,NE,L]

# If suffix nt, redirect to nt version
RewriteRule ^ontology\.nt$ https://design-computation-rwth.github.io/spot/ontology.nt [R=302,NE,L]

# Default response: html
RewriteRule ^$ https://design-computation-rwth.github.io/spot/ [R=303,NE,L]
