# Name of the project: Teho
# Description: Persistent namespace for the Teho ontology of work — work-object classes,
#              SKOS schemes, mapping sets and named graphs published by Teho (teho.ai).
# Contact: David Carling (david@teho.ai), GitHub @david-built-by-dc

# Turn off MultiViews
Options -MultiViews

RewriteEngine on

# Everything under /teho/ forwards to the Teho research namespace host.
# Content negotiation (JSON-LD vs HTML) is handled by the target host.
RewriteRule ^(.*)$ https://www.teho.ai/research/ns/$1 [R=302,L]
