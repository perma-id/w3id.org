RewriteEngine On

# ================================================================
# FAIR-MOO Vocabulary
# ================================================================

# Vocabulary namespace
RewriteRule ^$ https://rrmororo.github.io/fair-moo-vocabulary/ [R=302,L]

# ================================================================
# Optimisation Objectives
# ================================================================

RewriteRule ^objective/rccc/?$ https://rrmororo.github.io/fair-moo-vocabulary/#rccc [R=302,L]

RewriteRule ^objective/sd/?$ https://rrmororo.github.io/fair-moo-vocabulary/#sd [R=302,L]

RewriteRule ^objective/mcra/?$ https://rrmororo.github.io/fair-moo-vocabulary/#mcra [R=302,L]

RewriteRule ^objective/cra/?$ https://rrmororo.github.io/fair-moo-vocabulary/#cra [R=302,L]
