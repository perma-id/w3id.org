# # /cheezml/
#
# CheezML: one record vocabulary for CubbyLLM, MoWM and CubeLang.
#
# https://w3id.org/cheezml/ redirects to https://ns.grillcheeseai.com/cheezml/
# The module IRIs (core, cubby, mowm, cubelang) are content-negotiated: HTML for a
# browser; Turtle, JSON-LD or RDF/XML for an RDF client.
#
# ## Contact
# This space is administered by:
#
# Nicolas Cloutier (GrillCheese Research Lab)
# GitHub username: grillcheese123

RewriteEngine on

# --- A module, current version: /cheezml/core, /cheezml/cubby, /cheezml/mowm, /cheezml/cubelang

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^(core|cubby|mowm|cubelang)$ https://ns.grillcheeseai.com/cheezml/$1.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(core|cubby|mowm|cubelang)$ https://ns.grillcheeseai.com/cheezml/$1.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^(core|cubby|mowm|cubelang)$ https://ns.grillcheeseai.com/cheezml/$1.rdf [R=303,L]

RewriteRule ^(core|cubby|mowm|cubelang)$ https://ns.grillcheeseai.com/cheezml/$1.html [R=303,L]

# --- A module, one version: /cheezml/core/v0.1

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^(core|cubby|mowm|cubelang)/(v[0-9]+(\.[0-9]+)*)$ https://ns.grillcheeseai.com/cheezml/$2/$1.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(core|cubby|mowm|cubelang)/(v[0-9]+(\.[0-9]+)*)$ https://ns.grillcheeseai.com/cheezml/$2/$1.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^(core|cubby|mowm|cubelang)/(v[0-9]+(\.[0-9]+)*)$ https://ns.grillcheeseai.com/cheezml/$2/$1.rdf [R=303,L]

RewriteRule ^(core|cubby|mowm|cubelang)/(v[0-9]+(\.[0-9]+)*)$ https://ns.grillcheeseai.com/cheezml/$2/$1.html [R=303,L]

# --- The SHACL shapes, in Turtle: /cheezml/shapes and /cheezml/shapes/v0.1

RewriteRule ^shapes$ https://ns.grillcheeseai.com/cheezml/shapes.ttl [R=303,L]
RewriteRule ^shapes/(v[0-9]+(\.[0-9]+)*)$ https://ns.grillcheeseai.com/cheezml/$1/shapes.ttl [R=303,L]

# --- Everything else by its file name (context.jsonld, core.ttl, v0.1/..., examples/...)
# --- and the home page

RewriteRule ^(.*)$ https://ns.grillcheeseai.com/cheezml/$1 [R=302,L]
