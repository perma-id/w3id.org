# Maintainer: MengJ97 (GitHub) - 蒋蒙 <D202210754@xs.ustb.edu.cn>
# Mining and Metallurgy Heritage Ontology (MMHO, 矿冶遗存本体)
# Redirects https://w3id.org/mmho/... to https://github.com/MengJ97/mmho/...

RewriteEngine On

# Root namespace
RewriteRule ^$ https://github.com/MengJ97/mmho [R=302,L]

# Versioned namespace (v1.6)
RewriteRule ^1\.6/?$ https://github.com/MengJ97/mmho/tree/main#v160 [R=302,L]

# Direct file access
RewriteRule ^MMHO_v1\.6\.0_crm_ids\.owl$ https://raw.githubusercontent.com/MengJ97/mmho/main/MMHO_v1.6.0_crm_ids.owl [R=302,L]
RewriteRule ^MMHO_v1\.6\.0_crm_ids\.ttl$ https://raw.githubusercontent.com/MengJ97/mmho/main/MMHO_v1.6.0_crm_ids.ttl [R=302,L]

# Documentation
RewriteRule ^README\.md$ https://github.com/MengJ97/mmho/blob/main/README.md [R=302,L]

# Catch-all: redirect to repo
RewriteRule ^(.*)$ https://github.com/MengJ97/mmho [R=302,L]
