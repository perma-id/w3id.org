# w3id.org/produpass: Produpass (BrainOps SAS), EU battery passport (Regulation (EU) 2023/1542).
# Permanent identifiers of the data point definitions and of the separate collection symbol, served by
# id.produpass.com. Maintainers: see README.md.
RewriteEngine on

# Index of the definitions: https://w3id.org/produpass/batterie
RewriteRule ^batterie/?$ https://id.produpass.com/definitions/batterie/ [R=302,L]

# One definition: https://w3id.org/produpass/batterie/v1/point-01
RewriteRule ^batterie/(v[1-9][0-9]*/point-[0-9]{2})/?$ https://id.produpass.com/definitions/batterie/$1/ [R=302,L]

# Separate collection symbol: https://w3id.org/produpass/symboles/v1/collecte-separee.svg
RewriteRule ^symboles/v1/collecte-separee\.svg$ https://id.produpass.com/_produpass/collecte-separee.svg [R=302,L]
