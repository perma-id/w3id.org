RewriteEngine on

# KHD herbarium sheet images (with optional suffixes such as _thumb)
RewriteRule ^images/(KHD[0-9]+(?:_[A-Za-z0-9]+)*)\.(JPG|jpg)$ https://khd.dbg-images.org/$1.$2 [R=302,L]

# KHD herbarium bryophyte images (with optional suffixes such as _thumb)
RewriteRule ^bryophytes/images/(KHD[0-9]+(?:_[A-Za-z0-9]+)*)\.(JPG|jpg)$ https://khdb.dbg-images.org/$1.$2 [R=302,L]

# DBG fungarium specimen images (with optional suffixes such as _S00 or _thumb)
RewriteRule ^images/(DBG-F-[0-9]+(?:_[A-Za-z0-9]+)*)\.(JPG|jpg)$ https://dbg.dbg-images.org/$1.$2 [R=302,L]
