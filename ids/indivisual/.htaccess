# Redirect for our lab's frozen OSF archive successor
# Maintainer: benjamindehaas@gmail.com

Header set Access-Control-Allow-Origin *
Options +FollowSymLinks -MultiViews

RewriteEngine on

# 1. MATLAB Excercises for Eyetracking
# w3id.org/indivisual/matlab-exercises-eyetracking redirects to its specific Zenodo Concept DOI
RewriteRule ^matlab-exercises-eyetracking/?$ https://zenodo.org/records/21980621 [R=302,L]
