# # /servicefacts/
#
# Service Facts: open schema.org extension vocabularies for professional
# services. Term IDs are hash IDs, for example
# https://w3id.org/servicefacts/legal#actsFor
#
# Browsers get the documentation page. JSON-LD and Turtle clients get the
# vocabulary file. Files are hosted on GitHub Pages:
# https://wldm-gh.github.io/servicefacts/
# Source: https://github.com/wldm-gh/servicefacts
#
# ## Contact
# This space is administered by:
#
# WLDM
# peter@wldm.io
# GitHub username: wldm-gh
#
# Peter (WLDM)
# peter@wldm.io
# GitHub username: growsontrees

RewriteEngine on

# --- /servicefacts/ : the list of vocabularies ---------------------------

RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^$ https://wldm-gh.github.io/servicefacts/index.jsonld [R=303,L]

RewriteRule ^$ https://wldm-gh.github.io/servicefacts/ [R=303,L]

# --- /servicefacts/legal : the latest release ----------------------------

RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^(legal)/?$ https://wldm-gh.github.io/servicefacts/$1/$1.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^(legal)/?$ https://wldm-gh.github.io/servicefacts/$1/$1.ttl [R=303,L]

RewriteRule ^(legal)/?$ https://wldm-gh.github.io/servicefacts/$1/ [R=303,L]

# --- /servicefacts/legal/0.1 : a frozen release --------------------------

RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^(legal)/([0-9]+(\.[0-9]+)*)/?$ https://wldm-gh.github.io/servicefacts/$1/$2/$1.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^(legal)/([0-9]+(\.[0-9]+)*)/?$ https://wldm-gh.github.io/servicefacts/$1/$2/$1.ttl [R=303,L]

RewriteRule ^(legal)/([0-9]+(\.[0-9]+)*)/?$ https://wldm-gh.github.io/servicefacts/$1/$2/ [R=303,L]
