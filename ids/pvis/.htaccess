# PVIS - Photovoltaic Irrigation System Ontology
# Maintainer: ZaydVL

RewriteEngine On

# RDF/XML for ontology evaluation tools
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^core/?$ https://zaydvl.github.io/pvis-ontology/pvis-ontology.rdf [R=303,L]

# HTML documentation for web browsers
RewriteRule ^core/?$ https://zaydvl.github.io/pvis-ontology/ [R=303,L]
