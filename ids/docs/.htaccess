# # /docs/
#
# The w3id.org documentation site. The whole path is passed through, so
# /docs/<anything> reaches https://docs.w3id.org/<anything>.
#
# Do not add `DirectorySlash Off` or `Options -Indexes` here: either one stops
# the rule below running for the bare /docs URL. See README.md.
#
# ## Contact
# This space is administered by:
#
# W3C Permanent Identifier Community Group
# public-perma-id@w3.org
# https://www.w3.org/community/perma-id/
# GitHub organization: perma-id

RewriteEngine on

RewriteRule ^(.*)$ https://docs.w3id.org/$1 [R=302,L]
