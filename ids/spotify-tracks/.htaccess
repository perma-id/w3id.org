#
# /spotify-tracks/
#
# Permanent identifiers for the Spotify Tracks Linked Data project
# (MEIC, FEUP - Seminars, Data Interoperability).
#
#   /spotify-tracks/terms/...   -> minted vocabulary (OWL, Turtle)
#   /spotify-tracks/shapes/...  -> SHACL shapes (Turtle)
#   everything else             -> project site, path preserved
#
# Maintained by:
# DP Neves
# up202108460@up.pt
# GitHub username: deenv

RewriteEngine on
RewriteRule ^terms(/.*)?$ https://deenv.github.io/spotify-tracks/spotify-tracks-terms.ttl [R=303,L]
RewriteRule ^shapes(/.*)?$ https://deenv.github.io/spotify-tracks/spotify-tracks-shapes.ttl [R=303,L]
RewriteRule ^(.*)$ https://deenv.github.io/spotify-tracks/$1 [R=302,L]
