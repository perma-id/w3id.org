Options +FollowSymLinks
RewriteEngine on

# SHACL shapes
RewriteRule ^shapes/?$ https://renedorsch.solidcommunity.net/apps/cartograph/cartograph-shapes.ttl [R=302,L]

# Ontology (hash namespace: https://w3id.org/cartograph#Term)
RewriteRule ^$ https://renedorsch.solidcommunity.net/apps/cartograph/cartograph.ttl [R=302,L]
