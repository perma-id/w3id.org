Options +FollowSymLinks
RewriteEngine On

# OAKE – Ontology for the Astronomical Knowledge Ecosystem
# Persistent namespace maintained by AstroSemantics.

# Ontology documentation
RewriteRule ^$ https://github.com/astrosemantics/oake [R=302,L]

# Version 0.1.0
RewriteRule ^0\.1\.0/?$ https://github.com/astrosemantics/oake/releases/tag/v0.1.0 [R=302,L]
