Options +FollowSymLinks
RewriteEngine On
DirectorySlash Off

# AstroSemantics namespace
# Maintained by the AstroSemantics community.

# Handle the OAKE ontology IRI without a trailing slash.
RedirectMatch 302 ^/astrosemantics/oake$ /astrosemantics/oake/

# Redirect the namespace root to the GitHub organisation.
RewriteRule ^$ https://github.com/astrosemantics [R=302,L]
