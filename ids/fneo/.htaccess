# /fneo/
#
# https://w3id.org/fneo/ redirects to the GitHub Pages documentation.
# https://w3id.org/fneo/ontology and the 0.1.0-rc2 version IRI redirect to the
# ontology files in the tagged release.
#
# Targets checked over HTTPS on 2026-11-07:
#   https://alihur-ecu.github.io/fneo/
#   https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.ttl
#   https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.owl
#   https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.jsonld
#
# The v0.1.0 tag is the commit that contains this file. The namespace is not
# registered until the w3id.org pull request is merged.
#
# ## Contact
# This space is administered by:
#
# Ali HUR
# m.alihur@ecu.edu.au
# https://orcid.org/0000-0001-9537-2648
# GitHub username: alihur-ecu

Header set Access-Control-Allow-Origin *

RewriteEngine on

RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^ontology/0\.1\.0-rc2$ https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^ontology/0\.1\.0-rc2$ https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.owl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^ontology/0\.1\.0-rc2$ https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.jsonld [R=303,L]

RewriteRule ^ontology/0\.1\.0-rc2$ https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.ttl [R=303,L]
RewriteRule ^ontology$ https://raw.githubusercontent.com/alihur-ecu/fneo/v0.1.0/ontology/fneo.ttl [R=303,L]
RewriteRule ^$ https://alihur-ecu.github.io/fneo/ [R=303,L]
