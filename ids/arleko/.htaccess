# # /arleko/
#
# Permanent identifiers for AR-LEKO, the Argentine Legal Knowledge Ontology.
#
# https://w3id.org/arleko          current ontology IRI
# https://w3id.org/arleko/vocab    controlled vocabularies, defined in the same document
# https://w3id.org/arleko/1.3.0    version IRI of release 1.3.0
#
# Browsers receive the HTML documentation on GitHub Pages.
# RDF clients receive a serialization from jsDelivr, which serves Turtle,
# JSON-LD, RDF/XML and N-Triples with their registered media types.
# The version IRI is pinned to the git tag 1.3.0. The unversioned IRI follows
# the main branch.
#
# ## Contact
# This space is administered by:
#
# ar-leko
# GitHub username: ar-leko

RewriteEngine on

# --- version 1.3.0 ----------------------------------------------------------

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/n3
RewriteRule ^1\.3\.0/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@1.3.0/docs/1.3.0/arleko.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^1\.3\.0/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@1.3.0/docs/1.3.0/arleko.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^1\.3\.0/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@1.3.0/docs/1.3.0/arleko.rdf [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^1\.3\.0/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@1.3.0/docs/1.3.0/arleko.nt [R=303,L]

RewriteRule ^1\.3\.0/?$ https://ar-leko.github.io/ar-leko-ontology/1.3.0/ [R=303,L]

# --- controlled vocabularies (same ontology document) -----------------------

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/n3
RewriteRule ^vocab/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^vocab/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^vocab/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.rdf [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^vocab/?$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.nt [R=303,L]

RewriteRule ^vocab/?$ https://ar-leko.github.io/ar-leko-ontology/ [R=303,L]

# --- current ontology IRI ---------------------------------------------------

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} text/n3
RewriteRule ^$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.rdf [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://cdn.jsdelivr.net/gh/ar-leko/ar-leko-ontology@main/docs/ontology/arleko.nt [R=303,L]

RewriteRule ^$ https://ar-leko.github.io/ar-leko-ontology/ [R=303,L]
