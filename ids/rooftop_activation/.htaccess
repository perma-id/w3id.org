# Rooftop Activation Ontology
# https://w3id.org/rooftop_activation
# Maintainer: Alejandro Morales Hernandez <alejandro.morales.hernandez@ulb.be>
# GitHub: @alejandro3500
# Documentation and serialisations are hosted on GitHub Pages.

Header set Access-Control-Allow-Origin *
Options +FollowSymLinks
RewriteEngine on

# Versioned IRIs, e.g. https://w3id.org/rooftop_activation/2.0.0
# Redirect to the ontology file of the matching Git tag (v2.0.0).
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)$ https://raw.githubusercontent.com/alejandro3500/Rooftop_activation_ontology/v$1/ontology/rooftop_activation_ontology.rdf [R=303,L]

# Current version: content negotiation

# HTML documentation for browsers
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^/?$ https://alejandro3500.github.io/Rooftop_activation_ontology/index-en.html [R=303,L]

# RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^/?$ https://alejandro3500.github.io/Rooftop_activation_ontology/ontology.owl [R=303,L]

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^/?$ https://alejandro3500.github.io/Rooftop_activation_ontology/ontology.ttl [R=303,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^/?$ https://alejandro3500.github.io/Rooftop_activation_ontology/ontology.jsonld [R=303,L]

# N-Triples
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^/?$ https://alejandro3500.github.io/Rooftop_activation_ontology/ontology.nt [R=303,L]

# Default: HTML documentation
RewriteRule ^/?$ https://alejandro3500.github.io/Rooftop_activation_ontology/index-en.html [R=303,L]
