# Permanent identifier redirect for https://w3id.org/sso
#
# w3id.org does not host the SSO ontology itself: this file only
# 303-redirects, by content negotiation, to the current published
# version hosted on GitHub Pages.
#
# The target always points to the current revision of the ontology.
# Updating the ontology therefore does not require changing this file.

RewriteEngine On

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://labmodelsdigitalsupc.github.io/SSO/ontology.jsonld [R=303,L]

# HTML documentation, for browsers
RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.* 
RewriteRule ^$ https://labmodelsdigitalsupc.github.io/SSO/index-en.html [R=303,L]

# N-Triples
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://labmodelsdigitalsupc.github.io/SSO/ontology.nt [R=303,L]

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} \*/turtle
RewriteRule ^$ https://labmodelsdigitalsupc.github.io/SSO/ontology.ttl [R=303,L]

# RDF/XML, explicit request
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://labmodelsdigitalsupc.github.io/SSO/ontology.owl [R=303,L]

# Default: RDF/XML
# Used for requests with "*/*" or an unmatched Accept header.
RewriteRule ^$ https://labmodelsdigitalsupc.github.io/SSO/ontology.owl [R=303,L]
