# # /taco-rdf/
#
# Persistent identifier namespace for taco-rdf: the Brazilian Food
# Composition Table (TACO), 4th edition, as an RDF knowledge graph.
#
# Resources are served from https://victoria125.github.io/taco-rdf/ with
# content negotiation: Turtle or JSON-LD for RDF clients, HTML for browsers.
# Source: https://github.com/Victoria125/taco-rdf
#
# ## Contact
# This space is administered by:
#
# Vitória Maia
# GitHub username: Victoria125
# Contact: vitoriamaia19@gmail.com

Options -MultiViews
RewriteEngine on

# Vocabulary: https://w3id.org/taco-rdf/vocab (terms are hash IRIs, vocab#Food)
RewriteCond %{HTTP_ACCEPT} text/turtle [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle [NC]
RewriteRule ^vocab$ https://victoria125.github.io/taco-rdf/vocab.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^vocab$ https://victoria125.github.io/taco-rdf/vocab.jsonld [R=303,L]
RewriteRule ^vocab$ https://victoria125.github.io/taco-rdf/vocab.html [R=303,L]

# A measurement is described in its food's document.
RewriteRule ^id/measurement/([0-9]+)/[^/]+$ https://w3id.org/taco-rdf/id/food/$1 [R=303,L]

# Instance data: https://w3id.org/taco-rdf/id/<path>
RewriteCond %{HTTP_ACCEPT} text/turtle [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle [NC]
RewriteRule ^id/(.+)$ https://victoria125.github.io/taco-rdf/id/$1.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^id/(.+)$ https://victoria125.github.io/taco-rdf/id/$1.jsonld [R=303,L]
RewriteRule ^id/(.+)$ https://victoria125.github.io/taco-rdf/id/$1.html [R=303,L]

# Anything else: the landing page.
RewriteRule ^.*$ https://victoria125.github.io/taco-rdf/ [R=302,L]
