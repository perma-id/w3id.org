# KM Energy ontology
# Maintainer: Alexey Mikheev (https://github.com/avmiheev)
# The fragment identifies a term; it is not sent in an HTTP request.

Options -MultiViews
RewriteEngine On

RewriteRule ^$ https://github.com/avmiheev/km-energy [R=302,L]
RewriteRule ^ontology/?$ https://raw.githubusercontent.com/avmiheev/km-energy/main/ontology/analytics-core.ttl [R=303,L]
RewriteRule ^ontology\.ttl$ https://raw.githubusercontent.com/avmiheev/km-energy/main/ontology/analytics-core.ttl [R=303,L]
RewriteRule ^ontology\.owl$ https://raw.githubusercontent.com/avmiheev/km-energy/main/ontology/analytics-core.owl [R=303,L]
RewriteRule ^example/?$ https://raw.githubusercontent.com/avmiheev/km-energy/main/ontology/article-example.ttl [R=303,L]
