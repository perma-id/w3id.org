Options +FollowSymLinks
RewriteEngine On

# Landing page
RewriteRule ^$ https://github.com/federicobellati [R=302,L]

# Semantic application profiles by name and version
RewriteRule ^sap/([^/]+)/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://github.com/federicobellati/semantic-application-profiles/tree/main/$1/$2/ [R=302,L]
RewriteRule ^sap/([^/]+)/([0-9]+\.[0-9]+\.[0-9]+)/(.*[^/])$ https://raw.githubusercontent.com/federicobellati/semantic-application-profiles/main/$1/$2/$3 [R=302,L]

# Sensor description mapping ontology by version
RewriteRule ^ontology/(sensorDescriptionMapping)/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://github.com/federicobellati/ontology/tree/main/$1/$2/ [R=302,L]
RewriteRule ^ontology/(sensorDescriptionMapping)/([0-9]+\.[0-9]+\.[0-9]+)/(.*[^/])$ https://raw.githubusercontent.com/federicobellati/ontology/main/$1/$2/$3 [R=302,L]

# Mapping ontology by version
RewriteRule ^ontology/(mapping)/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://github.com/federicobellati/ontology/tree/main/$1/$2/ [R=302,L]
RewriteRule ^ontology/(mapping)/([0-9]+\.[0-9]+\.[0-9]+)/(.*[^/])$ https://raw.githubusercontent.com/federicobellati/ontology/main/$1/$2/$3 [R=302,L]

# Registry repositories by name
RewriteRule ^(datastreams|facilities|features-of-interest|locations|networks|research-infrastructures|sensors-models|sensors-deployment|ultimate-features-of-interest)-registry/?$ https://github.com/federicobellati/$1-registry/tree/main/ [R=302,L]
RewriteRule ^(datastreams|facilities|features-of-interest|locations|networks|research-infrastructures|sensors-models|sensors-deployment|ultimate-features-of-interest)-registry/(.*[^/])$ https://raw.githubusercontent.com/federicobellati/$1-registry/main/$2 [R=302,L]

# In situ metadata profiles by project and version
RewriteRule ^metadata_profiles/(danubius|ismar-ve|itineris)/insitu/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://github.com/federicobellati/metadata-profiles/tree/main/cnr-ismar/$1/insitu/$2/ [R=302,L]
RewriteRule ^metadata_profiles/(danubius|ismar-ve|itineris)/insitu/([0-9]+\.[0-9]+\.[0-9]+)/(.*[^/])$ https://raw.githubusercontent.com/federicobellati/metadata-profiles/main/cnr-ismar/$1/insitu/$2/$3 [R=302,L]

# Resources by path
RewriteRule ^resources/?$ https://github.com/federicobellati/resources/tree/main/ [R=302,L]
RewriteRule ^resources/(.*)/$ https://github.com/federicobellati/resources/tree/main/$1/ [R=302,L]
RewriteRule ^resources/(.*[^/])$ https://raw.githubusercontent.com/federicobellati/resources/main/$1 [R=302,L]

# Assets by path
RewriteRule ^assets/(.*)$ https://assets.ve.ismar.cnr.it/$1 [R=302,L]
