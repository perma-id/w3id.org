# OntoGSN
# Ontology: https://w3id.org/OntoGSN/ontology redirects to content negotiated (ttl/jsonld/rdf+xml)
# Version:  https://w3id.org/OntoGSN/ontology/{x.y.z} redirects to the same files at the git tag v{x.y.z}
# Homepage: https://w3id.org/OntoGSN redirects to https://fortiss.github.io/OntoGSN/
# Any other path answers 404.

Header set Access-Control-Allow-Origin *
Options +FollowSymLinks

# MIME type for OWL
AddType application/rdf+xml .rdf
AddType text/turtle .ttl
AddType application/ld+json .jsonld

RewriteEngine on

# --- Ontology, current version ---

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^ontology/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/ontogsn.ttl [R=303,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^ontology/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/ontogsn.jsonld [R=303,L]

# RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^ontology/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/ontogsn.rdf [R=303,L]

# Fallback for other Accept headers: the Turtle serialization
RewriteRule ^ontology/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/ontogsn.ttl [R=303,L]

# --- Ontology, one version (owl:versionIRI) ---
# /ontology/1.3.0 is the file at the git tag v1.3.0. A new version needs no new rule.
# A version without a tag answers 404 at the target.

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^ontology/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/v$1/ontology/serializations/ontogsn.jsonld [R=303,L]

# RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^ontology/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/v$1/ontology/serializations/ontogsn.rdf [R=303,L]

# Turtle, and the fallback for other Accept headers
RewriteRule ^ontology/([0-9]+\.[0-9]+\.[0-9]+)/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/v$1/ontology/serializations/ontogsn.ttl [R=303,L]

# --- Ontology, one section of the GSN standard, Turtle only ---
RewriteRule ^ontology/core/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/separated/ontogsn-complete_1_core.ttl [R=303,L]
RewriteRule ^ontology/pattern/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/separated/ontogsn-complete_2_pattern.ttl [R=303,L]
RewriteRule ^ontology/modular/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/separated/ontogsn-complete_3_modular.ttl [R=303,L]
RewriteRule ^ontology/confidence/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/separated/ontogsn-complete_4_confidence.ttl [R=303,L]
RewriteRule ^ontology/dialectic/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/serializations/separated/ontogsn-complete_5_dialectic.ttl [R=303,L]

# --- SHACL shapes: the full file and its five sections, Turtle only ---
RewriteRule ^shapes/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/shapes/ontogsn-shapes_0_full.ttl [R=303,L]
RewriteRule ^shapes/core/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/shapes/ontogsn-shapes_1_core.ttl [R=303,L]
RewriteRule ^shapes/pattern/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/shapes/ontogsn-shapes_2_pattern.ttl [R=303,L]
RewriteRule ^shapes/modular/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/shapes/ontogsn-shapes_3_modular.ttl [R=303,L]
RewriteRule ^shapes/confidence/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/shapes/ontogsn-shapes_4_confidence.ttl [R=303,L]
RewriteRule ^shapes/dialectic/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/ontology/shapes/ontogsn-shapes_5_dialectic.ttl [R=303,L]

# --- Augmentation and alignment, Turtle only ---
RewriteRule ^augmentation/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/augmentation/ontogsn-augmentation.ttl [R=303,L]
RewriteRule ^augmentation/shapes/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/augmentation/shapes/ontogsn-augmentation-shapes.ttl [R=303,L]
RewriteRule ^alignment/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/alignments/ontogsn-align.ttl [R=303,L]

# --- Design record, Turtle only ---
RewriteRule ^design/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/development/design/ontogsn-design.ttl [R=303,L]
RewriteRule ^design/(data|queries|augmentations)/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/development/design/ontogsn-design-$1.ttl [R=303,L]
RewriteRule ^alignment/design/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/development/design/ontogsn-align-design.ttl [R=303,L]
RewriteRule ^augmentation/design/?$ https://raw.githubusercontent.com/fortiss/OntoGSN/main/development/design/ontogsn-augmentation-design.ttl [R=303,L]

# --- Website ---
RewriteRule ^playground/?$ https://fortiss.github.io/OntoGSN/playground/ [R=303,L]
RewriteRule ^$ https://fortiss.github.io/OntoGSN/ [R=302,L]

# --- Any other path is not an OntoGSN identifier ---
RewriteRule ^ - [R=404,L]
