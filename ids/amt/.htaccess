# https://w3id.org/amt/<ANYTHING> — permanent identifiers for the Academic Meta Tool (AMT).
#
# Addresses in use:
#
#   /amt/            the start page of AMT
#   /amt/vocab       the vocabulary (negotiated on Accept: Turtle, RDF/XML,
#                        JSON-LD, otherwise the HTML page)
#   /amt/explorer    the Explorer
#   /amt/ontology    the data model page
#   /amt/engine      the source code of amt-engine
#   /amt/runner      the source code of amt-runner
#   /amt/doi         the concept DOI of amt-engine (Zenodo)
#
# Everything leads to the pages on GitHub Pages of the Alpaca organisation
# (https://alpaca-fair-framework.github.io/amt-engine/) or to the repositories. The namespace
# of the vocabulary itself is http://academic-meta-tool.xyz/vocab# and does not
# change; this space only gives it, and the rest of AMT, an address that does
# not depend on a domain or a host.
#
# ## Contact
# This space is administered by:
#
# Florian Thiery
# GitHub username: @florianthiery
# email: florian.thiery@leiza.de

RewriteEngine On
RewriteBase /ids/amt/

RewriteRule ^$ https://alpaca-fair-framework.github.io/amt-engine/ [R=302,L]

# The vocabulary: content negotiation on the Accept header
RewriteCond %{HTTP_ACCEPT} text/turtle|application/x-turtle
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/amt.ttl [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/amt.rdf [R=302,L]
RewriteCond %{HTTP_ACCEPT} application/(ld\+)?json
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/amt.jsonld [R=302,L]
RewriteRule ^vocab/?$ https://alpaca-fair-framework.github.io/amt-engine/vocab/ [R=302,L]

RewriteRule ^explorer/?$ https://alpaca-fair-framework.github.io/amt-engine/explorer/ [R=302,L]

RewriteRule ^ontology/?$ https://alpaca-fair-framework.github.io/amt-engine/ontology/ [R=302,L]

RewriteRule ^engine/?$ https://github.com/alpaca-fair-framework/amt-engine [R=302,L]

RewriteRule ^runner/?$ https://github.com/alpaca-fair-framework/amt-runner [R=302,L]

RewriteRule ^doi/?$ https://doi.org/10.5281/zenodo.23669466 [R=302,L]
