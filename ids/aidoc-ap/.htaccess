# Turn off MultiViews
Options -MultiViews

# Directive to ensure *.rdf files served as appropriate content type,
AddType application/rdf+xml .rdf
AddType application/owl+xml .owl
AddType text/turtle .ttl
AddType application/ld+json .jsonld

Header set Access-Control-Allow-Origin *
Options +FollowSymLinks
RewriteEngine on

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://certain-project.github.io/aidoc-ap/ontology.owl [R=302,L]


RewriteCond %{HTTP_ACCEPT} application/owl\+xml
RewriteRule ^$ https://certain-project.github.io/aidoc-ap/ontology.owl [R=302,L]


RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^$ https://certain-project.github.io/aidoc-ap/ontology.ttl [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://certain-project.github.io/aidoc-ap/ontology.jsonld [R=302,L]

# https://w3id.org/aidoc-ap/1.0
RewriteRule ^1.0$ https://certain-project.github.io/aidoc-ap/ [R=302,L]

# AIDOC-AP Lifecycle Extension: https://w3id.org/aidoc-ap/lifecycle (namespace https://w3id.org/aidoc-ap/lifecycle#)
# Documented from its own repository, CERTAIN-Project/aidoc-ap-lifecycle; these rules precede the default rules below.

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/owl\+xml
RewriteRule ^lifecycle/?$ https://certain-project.github.io/aidoc-ap-lifecycle/ontology.owl [R=302,L]

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^lifecycle/?$ https://certain-project.github.io/aidoc-ap-lifecycle/aidoc-lc.ttl [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^lifecycle/?$ https://certain-project.github.io/aidoc-ap-lifecycle/ontology.jsonld [R=302,L]

RewriteRule ^lifecycle/?$ https://certain-project.github.io/aidoc-ap-lifecycle/ [R=302,L]

# https://w3id.org/aidoc-ap/lifecycle/<version>: release snapshot
RewriteRule ^lifecycle/([0-9]+\.[0-9]+)/?$ https://certain-project.github.io/aidoc-ap-lifecycle/$1/aidoc-lc.ttl [R=302,L]

# https://w3id.org/aidoc-ap/lifecycle/example/...: instances of the example graphs
RewriteRule ^lifecycle/example/.*$ https://certain-project.github.io/aidoc-ap-lifecycle/examples.html [R=302,L]

RewriteRule ^lifecycle/(.+)$ https://certain-project.github.io/aidoc-ap-lifecycle/$1 [R=302,L]

# AIDOC-AP LEX Extension: https://w3id.org/aidoc-ap/lex (namespace https://w3id.org/aidoc-ap/lex#)
# Documented from its own repository, CERTAIN-Project/aidoc-ap-lex; these rules precede the default rules below.

# https://w3id.org/aidoc-ap/lex/requirements (namespace https://w3id.org/aidoc-ap/lex/requirements#)
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^lex/requirements/?$ https://certain-project.github.io/aidoc-ap-lex/requirements.ttl [R=302,L]

RewriteRule ^lex/requirements/?$ https://certain-project.github.io/aidoc-ap-lex/requirements.html [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/owl\+xml
RewriteRule ^lex/?$ https://certain-project.github.io/aidoc-ap-lex/ontology.owl [R=302,L]

RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^lex/?$ https://certain-project.github.io/aidoc-ap-lex/aidoc-lex.ttl [R=302,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^lex/?$ https://certain-project.github.io/aidoc-ap-lex/ontology.jsonld [R=302,L]

RewriteRule ^lex/?$ https://certain-project.github.io/aidoc-ap-lex/ [R=302,L]

# https://w3id.org/aidoc-ap/lex/<version>: release snapshot
RewriteRule ^lex/([0-9]+\.[0-9]+)/?$ https://certain-project.github.io/aidoc-ap-lex/$1/aidoc-lex.ttl [R=302,L]

# https://w3id.org/aidoc-ap/lex/example/...: instances of the example graph
RewriteRule ^lex/example/.*$ https://certain-project.github.io/aidoc-ap-lex/examples.html [R=302,L]

RewriteRule ^lex/(.+)$ https://certain-project.github.io/aidoc-ap-lex/$1 [R=302,L]

# Default

RewriteRule ^$ https://certain-project.github.io/aidoc-ap [R=302,L]
RewriteRule ^(.*)$ https://certain-project.github.io/aidoc-ap/$1 [R=302,L]
