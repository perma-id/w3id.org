# # /bcfOWL/
#
# Content-negotiated IRIs for bcfOWL, the BIM Collaboration Format Ontology.
#
# https://w3id.org/bcfOWL# is the namespace. https://w3id.org/bcfOWL redirects to
# the latest version at https://design-computation-rwth.github.io/bcfOWL/
#
# https://w3id.org/bcfOWL/<version> (for example 1.0.0) is the version IRI of a
# release. It redirects to the fixed copy of that release at
# https://design-computation-rwth.github.io/bcfOWL/<version>/
#
# ## Contact
# This space is administered by:
#
# Oliver Schulz
# schulz@dc.rwth-aachen.de
# GitHub username: OlliSchu
#
# Jyrki Oraskari
# jyrki.oraskari@dc.rwth-aachen.de
# GitHub username: jyrkioraskari

RewriteEngine on

# --- Latest version ---------------------------------------------------

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^$ https://design-computation-rwth.github.io/bcfOWL/ontology.ttl [R=303,NE,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://design-computation-rwth.github.io/bcfOWL/ontology.jsonld [R=303,NE,L]

# RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://design-computation-rwth.github.io/bcfOWL/ontology.owl [R=303,NE,L]

# N-Triples
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://design-computation-rwth.github.io/bcfOWL/ontology.nt [R=303,NE,L]

# Default: human-readable documentation
RewriteRule ^$ https://design-computation-rwth.github.io/bcfOWL/ [R=303,NE,L]

# --- A specific version -----------------------------------------------

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)$ https://design-computation-rwth.github.io/bcfOWL/$1/ontology.ttl [R=303,NE,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)$ https://design-computation-rwth.github.io/bcfOWL/$1/ontology.jsonld [R=303,NE,L]

# RDF/XML
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)$ https://design-computation-rwth.github.io/bcfOWL/$1/ontology.owl [R=303,NE,L]

# N-Triples
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)$ https://design-computation-rwth.github.io/bcfOWL/$1/ontology.nt [R=303,NE,L]

# Default: human-readable documentation
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)$ https://design-computation-rwth.github.io/bcfOWL/$1/ [R=303,NE,L]
