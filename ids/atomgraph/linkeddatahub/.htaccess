Options +FollowSymLinks
RewriteEngine on

RewriteRule ^$ https://atomgraph.github.io/LinkedDataHub/ns/ldh.ttl [R=302,L]
RewriteRule ^default$ https://atomgraph.github.io/LinkedDataHub/ns/def.ttl [R=302,L]
RewriteRule ^document-hierarchy$ https://atomgraph.github.io/LinkedDataHub/ns/dh.ttl [R=302,L]
RewriteRule ^dataspaces$ https://atomgraph.github.io/LinkedDataHub/ns/lds.ttl [R=302,L]
