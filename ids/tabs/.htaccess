# # /tabs/
#
# TABS (Temporal Altitudinal Biogeographic Shifts): an R package and open datasets to reconstruct how islands and
# mountain habitats change through time. Persistent links to the parts of TABS that have no DOI of their own (the
# datasets, the package and the paper have DOIs).
#
# https://w3id.org/tabs/                        redirects to the TABS website (documentation and vignettes)
# https://w3id.org/tabs/gitlab                  redirects to the source code on GitLab
# https://w3id.org/tabs/tibs-tabs-workshop      redirects to the workshop material of the TIBS-TABS workshop
#                                               (The International Biogeography Society)
# https://w3id.org/tabs/tips-for-tabs-lecture   redirects to the "Tips for TABS" lecture (Palaeoverse, YouTube)
#
# ## Contact
# This space is administered by:
#
# Johannes De Groeve
# Institute for Biodiversity and Ecosystem Dynamics (IBED), University of Amsterdam
# GitHub username: jedgroev

RewriteEngine on
RewriteRule ^$ https://uva_ibed_piac.gitlab.io/tabs/ [R=302,L]
RewriteRule ^gitlab/?$ https://gitlab.com/uva_ibed_piac/tabs [R=302,L]
RewriteRule ^tibs-tabs-workshop/?$ https://workshop-tibs-tabs-834476.gitlab.io/ [R=302,L]
RewriteRule ^tips-for-tabs-lecture/?$ https://www.youtube.com/watch?v=nsGMzWoijFc [R=302,L]
