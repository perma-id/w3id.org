# Schaaf Lab, Institute of Human Genetics, Heidelberg University, Germany
# Maintainer: Tim Schubert <tim.schubert@med.uni-heidelberg.de> (GitHub: @tim-schubert)

Options +FollowSymLinks
RewriteEngine on

# MfAP
RewriteRule ^mfap/?$ https://tim-schubert-mfap.share.connect.posit.cloud/ [R=302,L,QSA]

# SYS severity score calculator
RewriteRule ^sys-severity-calculator/?$ https://timschubert.shinyapps.io/SYS-Severity-Score-Calculator/ [R=302,L,QSA]

# Research group homepage
RewriteRule ^$ https://www.klinikum.uni-heidelberg.de/humangenetik/forschung/genetik-neurologischer-entwicklungsstoerungen/ [R=302,L,QSA]
