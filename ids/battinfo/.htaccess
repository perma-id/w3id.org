##########################################################################
# .htaccess file https://w3id.org/battinfo
#
# If testing interactively with https://htaccess.madewithlove.com/
# remember to remove the initial "battinfo/" in the URL to test.
#
##########################################################################

Options +FollowSymLinks
RewriteEngine On

##########################################################################
##  Redirections to raw files in the GitHub repo
##########################################################################

# https://w3id.org/battinfo/raw/{PATH}: a file on main
RewriteRule ^raw/([^0-9].*)$ https://raw.githubusercontent.com/BIG-MAP/BattINFO/main/$1 [R=303,NE,L]

# https://w3id.org/battinfo/raw/{VERSION}/{PATH}: the file at release tag v{VERSION}
RewriteRule ^raw/([0-9][^/]*)/(.*)$ https://raw.githubusercontent.com/BIG-MAP/BattINFO/v$1/$2 [R=303,NE,L]

##########################################################################
##  Ontology root and documentation
##########################################################################

# https://w3id.org/battinfo
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml
RewriteRule ^$ https://big-map.github.io/BattINFO/battinfo.html [R=303,NE,L]
RewriteRule ^$ https://big-map.github.io/BattINFO/battinfo.ttl [R=303,NE,L]

# https://w3id.org/battinfo/inferred
RewriteRule ^inferred/?$ https://big-map.github.io/BattINFO/battinfo-inferred.ttl [R=303,NE,L]

# https://w3id.org/battinfo/turtle
RewriteRule ^turtle/?$ https://big-map.github.io/BattINFO/battinfo.ttl [R=303,NE,L]

##########################################################################
##  Source/latest aliases
##########################################################################

RewriteRule ^latest/?$ https://raw.githubusercontent.com/BIG-MAP/BattINFO/main/battinfo.ttl [R=303,NE,L]
RewriteRule ^source/?$ https://raw.githubusercontent.com/BIG-MAP/BattINFO/main/battinfo.ttl [R=303,NE,L]

##########################################################################
##  Versioned ontology routes
##########################################################################

# Releases 0.2.0, 0.5.0 and 0.6.0 predate the versions/ tree on GitHub Pages and redirect to the file at their release tag.
RewriteRule ^(0\.[256]\.0)(/turtle)?/?$ https://raw.githubusercontent.com/BIG-MAP/BattINFO/v$1/battinfo.ttl [R=303,NE,L]

# https://w3id.org/battinfo/{VERSION}, and {VERSION}/battinfo, the version IRI a release declares
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml
RewriteRule ^([0-9][^/]*)(/battinfo)?/?$ https://big-map.github.io/BattINFO/battinfo/versions/$1/battinfo.html [R=303,NE,L]
RewriteRule ^([0-9][^/]*)(/battinfo)?/?$ https://big-map.github.io/BattINFO/battinfo/versions/$1/battinfo.ttl [R=303,NE,L]

RewriteRule ^([0-9][^/]*)/inferred/?$ https://big-map.github.io/BattINFO/battinfo/versions/$1/battinfo-inferred.ttl [R=303,NE,L]
RewriteRule ^([0-9][^/]*)/turtle/?$ https://big-map.github.io/BattINFO/battinfo/versions/$1/battinfo.ttl [R=303,NE,L]

##########################################################################
##  Publisher vocabularies (def/{PREFIX}/) on GitHub Pages. Any other
##  path under def/ falls through to the registry, which answers 404.
##########################################################################

# https://w3id.org/battinfo/def/{PREFIX}: the vocabulary, as its newest release
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml
RewriteRule ^def/([1-9][0-9]{3,})/?$ https://big-map.github.io/BattINFO/def/$1/ [R=303,NE,L]
RewriteRule ^def/([1-9][0-9]{3,})/?$ https://big-map.github.io/BattINFO/def/$1/vocab.ttl [R=303,NE,L]

# https://w3id.org/battinfo/def/{PREFIX}/{VERSION}: one release
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml
RewriteRule ^def/([1-9][0-9]{3,})/([0-9][^/]*)/?$ https://big-map.github.io/BattINFO/def/$1/$2/index.html [R=303,NE,L]
RewriteRule ^def/([1-9][0-9]{3,})/([0-9][^/]*)/?$ https://big-map.github.io/BattINFO/def/$1/$2/vocab.ttl [R=303,NE,L]

# https://w3id.org/battinfo/def/{PREFIX}/{TERM}: a term, in the newest release
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml
RewriteRule ^def/([1-9][0-9]{3,})/([A-Za-z][A-Za-z0-9_]*)$ https://big-map.github.io/BattINFO/def/$1/#$2 [R=303,NE,QSD,L]
RewriteRule ^def/([1-9][0-9]{3,})/([A-Za-z][A-Za-z0-9_]*)$ https://big-map.github.io/BattINFO/def/$1/vocab.ttl [R=303,NE,L]

##########################################################################
##  Everything else: BattINFO record identifiers, vocabulary terms, and
##  semantic artifacts -> the BattINFO registry resolver. Content
##  negotiation (JSON-LD / Turtle / HTML landing pages), tombstones, and
##  legacy namespace aliases are all handled by the resolver, so this
##  file should not need to change again as the record layer grows.
##########################################################################

RewriteRule ^(.+)$ https://battinfo-registry.onrender.com/w3id/$1 [R=303,NE,L]

