# # /agent-passport/
#
# https://w3id.org/agent-passport/envelope/v1 -> Agent Passport Envelope JSON-LD context v1
# https://w3id.org/agent-passport/binding/v1  -> Agent Binding JSON-LD context v1
# everything else under /agent-passport/     -> the specification repository pages
#
# ## Contact
# This space is administered by:
#
# Christian Schlager
# christian.schlager@me.com
# GitHub username: CSdev1909

RewriteEngine on
RewriteRule ^envelope/v1$ https://1909-works.github.io/agent-passport/contexts/envelope-v1.jsonld [R=302,L]
RewriteRule ^binding/v1$ https://1909-works.github.io/agent-passport/contexts/binding-v1.jsonld [R=302,L]
RewriteRule ^(.*)$ https://1909-works.github.io/agent-passport/$1 [R=302,L]
