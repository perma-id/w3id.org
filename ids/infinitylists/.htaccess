# # /infinitylists/
#
# Permanent address for infinitylists, a web app for place-based species
# checklists (Cornwell, Kar & Mesaglio 2025, Applications in Plant Sciences,
# https://doi.org/10.1002/aps3.70012).
#
# https://w3id.org/infinitylists/        -> the web app
# https://w3id.org/infinitylists/repo    -> the GitHub repository
# https://w3id.org/infinitylists/docs/   -> the R package documentation
#
# ## Contact
# This space is administered by:
#
# Will Cornwell
# GitHub username: wcornwell
#
# Fonti Kar
# GitHub username: fontikar
#
# Thomas Mesaglio
# GitHub username: tmesaglio

RewriteEngine on
RewriteRule ^repo/?$ https://github.com/traitecoevo/infinitylists [R=302,L]
RewriteRule ^docs/?(.*)$ https://traitecoevo.github.io/infinitylists/$1 [R=302,L]
RewriteRule ^(.*)$ https://traitecoevo.github.io/infinitylists/app/$1 [R=302,L]
