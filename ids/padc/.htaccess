# PADC namespaces
#
# https://w3id.org/padc/skg/ redirects to https://ontoportal-astro.eu/ontologies?groups=OPSKG
# https://w3id.org/padc/skg/agents* redirects to https://ontoportal-astro.eu/ontologies/OPSKGAG*
# https://w3id.org/padc/skg/core* redirects to https://ontoportal-astro.eu/ontologies/OPSKGCO*
# https://w3id.org/padc/skg/instruments* redirects to https://ontoportal-astro.eu/ontologies/OPSKGIN*
# https://w3id.org/padc/skg/research-products* redirects to https://ontoportal-astro.eu/ontologies/OPSKGRP*
# https://w3id.org/padc/skg/topics* redirects to https://ontoportal-astro.eu/ontologies/OPSKGTO*
# https://w3id.org/padc/maser* redirects to https://voparis-ns.obspm.fr/maser*
# https://w3id.org/padc/pds4* redirects to https://voparis-ns.obspm.fr/pds4*
# https://w3id.org/padc/rdf* redirects to https://voparis-ns.obspm.fr/rdf*
# https://w3id.org/padc/demo/uat* redirects to https://ontoportal-astro.eu/ontologies/UAT*
#
# ## Contact
# This space is administered by:
#
# Baptiste Cecconi
# baptiste.cecconi@obspm.fr
# GitHub username: BaptisteCecconi

RewriteEngine on
RewriteRule ^skg/agents(.*)$ https://ontoportal-astro.eu/ontologies/OPSKGAG$1 [R=303,L]
RewriteRule ^skg/core(.*)$ https://ontoportal-astro.eu/ontologies/OPSKGCO$1 [R=303,L]
RewriteRule ^skg/topics(.*)$ https://ontoportal-astro.eu/ontologies/OPSKGTO$1 [R=303,L]
RewriteRule ^skg/instruments(.*)$ https://ontoportal-astro.eu/ontologies/OPSKGIN$1 [R=303,L]
RewriteRule ^skg/research-products(.*)$ https://ontoportal-astro.eu/ontologies/OPSKGRP$1 [R=303,L]
RewriteRule ^skg/?$ https://ontoportal-astro.eu/ontologies?groups=OPSKG
RewriteRule ^maser(.*)$ https://voparis-ns.obspm.fr/maser$1 [R=303,L]
RewriteRule ^pds4(.*)$ https://voparis-ns.obspm.fr/pds4$1 [R=303,L]
RewriteRule ^rdf(.*)$ https://voparis-ns.obspm.fr/rdf$1 [R=303,L]
RewriteRule ^$ https://voparis-ns.obspm.fr/ [R=303,L]

#demo
RewriteRule ^demo/uat(.*)$ https://ontoportal-astro.eu/ontologies/UAT$1 [R=303,L]
