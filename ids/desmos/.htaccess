# DeSMoS - Descriptive Semantic Model for Structured Texts
# Namespace: https://w3id.org/desmos/

RewriteEngine On

# Accesso diretto al file OWL
RewriteRule ^desmos\.owl$ https://raw.githubusercontent.com/enricabruno/desmos/main/data/ontology/desmos.owl [R=303,L]

# Vecchio file TTL non piu disponibile
RewriteRule ^oplepiana\.ttl$ - [G,L]

# RDF/XML per i client semantici
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/owl\+xml
RewriteRule ^$ https://raw.githubusercontent.com/enricabruno/desmos/main/data/ontology/desmos.owl [R=303,L]

# Documentazione HTML generata con LODE 2.0
RewriteRule ^(.*)$ https://enricabruno.github.io/desmos/index.html [R=303,L]
