# # /dcat-ap-uk/
#
# Identifiers for DCAT-AP-UK, a proposed DCAT application profile for UK
# public-sector data catalogues (a proposal, not an endorsed standard).
# https://w3id.org/dcat-ap-uk/ redirects to https://cyberdudeuk.github.io/dcat-ap-uk/
#
# Term and codelist IRIs use 303 with content negotiation; everything else uses 302.
#
# ## Contact
# This space is administered by the DCAT-AP-UK maintainers:
#
# GitHub username: cyberdudeuk
# Issues: https://github.com/cyberdudeuk/dcat-ap-uk/issues

RewriteEngine on

# Terms: https://w3id.org/dcat-ap-uk/ns#term
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^ns$ https://cyberdudeuk.github.io/dcat-ap-uk/downloads/dcat-ap-uk.ns.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^ns$ https://cyberdudeuk.github.io/dcat-ap-uk/downloads/dcat-ap-uk.context.jsonld [R=303,L]
RewriteRule ^ns$ https://cyberdudeuk.github.io/dcat-ap-uk/properties.html [R=303,L]

# Codelists and their values: https://w3id.org/dcat-ap-uk/codelist/{list}/{code}
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^codelist(/.*)?$ https://cyberdudeuk.github.io/dcat-ap-uk/downloads/codelists.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^codelist(/.*)?$ https://cyberdudeuk.github.io/dcat-ap-uk/downloads/codelists.jsonld [R=303,L]
RewriteRule ^codelist/([^/]+)(/.*)?$ https://cyberdudeuk.github.io/dcat-ap-uk/codelists.html#cl-$1 [R=303,NE,L]
RewriteRule ^codelist/?$ https://cyberdudeuk.github.io/dcat-ap-uk/codelists.html [R=303,L]

# Sector extensions: https://w3id.org/dcat-ap-uk/ext/{id}
RewriteRule ^ext/([^/]+)$ https://cyberdudeuk.github.io/dcat-ap-uk/extensions.html#ext-$1 [R=302,NE,L]

# Validation artefacts
RewriteRule ^shapes$ https://cyberdudeuk.github.io/dcat-ap-uk/downloads/dcat-ap-uk.shacl.ttl [R=302,L]
RewriteRule ^schema$ https://cyberdudeuk.github.io/dcat-ap-uk/downloads/dcat-ap-uk.schema.json [R=302,L]
RewriteRule ^context$ https://cyberdudeuk.github.io/dcat-ap-uk/downloads/dcat-ap-uk.context.jsonld [R=302,L]

# A version of the profile, such as https://w3id.org/dcat-ap-uk/1.2
RewriteRule ^([0-9]+(\.[0-9]+)*)$ https://cyberdudeuk.github.io/dcat-ap-uk/whats-new.html [R=302,L]

# Everything else: the portal home page
RewriteRule ^ https://cyberdudeuk.github.io/dcat-ap-uk/ [R=302,L]
