# w3id.org/olb  ·  Ontologia da Legislação Brasileira (OLB)
# Redireciona para o repositório público dos autores (GitHub Pages).
# Todas as regras usam 303 (See Other), como recomendado para identificadores de conceitos.

Options +FollowSymLinks
RewriteEngine On

# ---------- Ontologia (TBox) e termos: https://w3id.org/olb  e  https://w3id.org/olb#Termo ----------
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^$ https://gersonrolim.github.io/olb/olb.ttl [R=303,L]
RewriteRule ^$ https://gersonrolim.github.io/olb/index.html [R=303,L]

# ---------- Catálogo de relações e vocabulários: https://w3id.org/olb/vocab ----------
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^vocab/?$ https://gersonrolim.github.io/olb/vocab.ttl [R=303,L]
RewriteRule ^vocab/?$ https://gersonrolim.github.io/olb/index.html#vocab [R=303,NE,L]

# ---------- Regras de validação (SHACL): https://w3id.org/olb/shapes ----------
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^shapes/?$ https://gersonrolim.github.io/olb/shapes.ttl [R=303,L]
RewriteRule ^shapes/?$ https://gersonrolim.github.io/olb/index.html#shapes [R=303,NE,L]

# ---------- Fatos de exemplo (caso fictício e demais conjuntos) ----------
RewriteRule ^caso/?$ https://gersonrolim.github.io/olb/caso.ttl [R=303,L]
RewriteRule ^comunidades/?$ https://gersonrolim.github.io/olb/comunidades.ttl [R=303,L]
RewriteRule ^cf/?$ https://gersonrolim.github.io/olb/linhagem-constitucional.ttl [R=303,L]
RewriteRule ^mh/?$ https://gersonrolim.github.io/olb/marcos-historicos.ttl [R=303,L]
RewriteRule ^teste/?$ https://gersonrolim.github.io/olb/testes-negativos.ttl [R=303,L]
RewriteRule ^dj/?$ https://gersonrolim.github.io/olb/decisoes-judiciais.ttl [R=303,L]

# ---------- Qualquer outro caminho: página de entrada ----------
RewriteRule ^(.+)$ https://gersonrolim.github.io/olb/index.html [R=303,L]
