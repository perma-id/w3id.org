# # /salish-sea/
#
# https://w3id.org/salish-sea/animals/<seven digits> identifies an animal or a
# social group in the Salish Sea Animals register
# (https://github.com/salish-sea/animals). Every address under /salish-sea/
# redirects to the register's explanation of its identifiers.
#
# ## Contact
# This space is administered by:
#
# Peter Abrahamsen
# rainhead@gmail.com
# GitHub username: rainhead

RewriteEngine on
RewriteRule ^ https://github.com/salish-sea/animals#identifiers [R=303,L]
