RewriteEngine On

# Immutable version 1.0.0
RewriteRule ^1\.0\.0/?$ https://jkhcw16-arch.github.io/truth-metric-ontology/releases/1.0.0/Truth\_Metric\_Ontology\_v1.0.0.owl [R=302,L]

RewriteRule ^1\.0\.0/ontology\.owl$ https://jkhcw16-arch.github.io/truth-metric-ontology/releases/1.0.0/Truth\_Metric\_Ontology\_v1.0.0.owl [R=302,L]

# Current ontology
RewriteRule ^ontology\.owl$ https://jkhcw16-arch.github.io/truth-metric-ontology/Truth\_Metric\_Ontology.owl [R=302,L]

# Namespace root
RewriteRule ^$ https://jkhcw16-arch.github.io/truth-metric-ontology/Truth\_Metric\_Ontology.owl [R=302,L]
