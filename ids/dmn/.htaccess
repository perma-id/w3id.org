# Persistent identifiers for "DMN 1.6 in RDF"
# Source and issue tracker: https://github.com/jwvveen/dmn-rdf
#
# https://w3id.org/dmn                    core ontology (hash namespace: https://w3id.org/dmn#)
# https://w3id.org/dmn/matrix             requirements matrix (Table 2) and hit policies
# https://w3id.org/dmn/rules              catalogue of normative statements
# https://w3id.org/dmn/bridges            bridges to the law, concepts, BPMN and ArchiMate
# https://w3id.org/dmn/alignments         mappings to earlier DMN vocabularies
# https://w3id.org/dmn/shapes             SHACL shapes (integrity, names, decision tables)
# https://w3id.org/dmn/shapes/matrix      SHACL shape against the requirements matrix
# https://w3id.org/dmn/shapes/bridges     SHACL shapes across the notations
#
# RDF clients (Accept: text/turtle and friends) get the Turtle file with a
# 303; browsers get the repository page.
#
# Contact: Jan Willem van Veen
# GitHub username: jwvveen

RewriteEngine on

# --- RDF clients -------------------------------------------------------------
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/ld\+json|application/n-triples)
RewriteRule ^$ https://raw.githubusercontent.com/jwvveen/dmn-rdf/main/dmn.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/ld\+json|application/n-triples)
RewriteRule ^(matrix|rules|bridges|alignments)/?$ https://raw.githubusercontent.com/jwvveen/dmn-rdf/main/dmn-$1.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/ld\+json|application/n-triples)
RewriteRule ^shapes/?$ https://raw.githubusercontent.com/jwvveen/dmn-rdf/main/shacl/dmn-shapes.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/ld\+json|application/n-triples)
RewriteRule ^shapes/matrix/?$ https://raw.githubusercontent.com/jwvveen/dmn-rdf/main/shacl/dmn-matrix-shapes.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/ld\+json|application/n-triples)
RewriteRule ^shapes/bridges/?$ https://raw.githubusercontent.com/jwvveen/dmn-rdf/main/shacl/dmn-bridge-shapes.ttl [R=303,L]

# --- Explicit file names always give the file ----------------------------------
RewriteRule ^dmn\.ttl$ https://raw.githubusercontent.com/jwvveen/dmn-rdf/main/dmn.ttl [R=302,L]
RewriteRule ^dmn-(matrix|rules|bridges|alignments)\.ttl$ https://raw.githubusercontent.com/jwvveen/dmn-rdf/main/dmn-$1.ttl [R=302,L]

# --- Browsers and everything else: the repository ------------------------------
RewriteRule ^(.*)$ https://github.com/jwvveen/dmn-rdf [R=302,L]
