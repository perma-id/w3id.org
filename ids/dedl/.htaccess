RewriteEngine On

# Content negotiation for the DEDL ontology (https://github.com/dedl-project/dedl).
# RDF formats are checked before HTML so that RDF clients that also accept
# text/html get RDF; browsers never ask for RDF and fall through to HTML.
# Requests without a matching Accept header (e.g. */*) get Turtle.

# =========================
# JSON-LD context
# =========================
RewriteRule ^context\.jsonld$ https://dedl-project.github.io/dedl/context.jsonld [R=303,L]

# =========================
# Versioned releases: /dedl/0.1, /dedl/1.0.0, ...
# =========================
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^([0-9]+(?:\.[0-9]+)+)/?$ https://dedl-project.github.io/dedl/$1/ontology.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^([0-9]+(?:\.[0-9]+)+)/?$ https://dedl-project.github.io/dedl/$1/ontology.owl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^([0-9]+(?:\.[0-9]+)+)/?$ https://dedl-project.github.io/dedl/$1/ontology.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/n-triples [NC]
RewriteRule ^([0-9]+(?:\.[0-9]+)+)/?$ https://dedl-project.github.io/dedl/$1/ontology.nt [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/html [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [NC]
RewriteRule ^([0-9]+(?:\.[0-9]+)+)/?$ https://dedl-project.github.io/dedl/$1/index.html [R=303,L]

RewriteRule ^([0-9]+(?:\.[0-9]+)+)/?$ https://dedl-project.github.io/dedl/$1/ontology.ttl [R=303,L]

# =========================
# Latest version: /dedl
# =========================
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^$ https://dedl-project.github.io/dedl/ontology.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^$ https://dedl-project.github.io/dedl/ontology.owl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^$ https://dedl-project.github.io/dedl/ontology.jsonld [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/n-triples [NC]
RewriteRule ^$ https://dedl-project.github.io/dedl/ontology.nt [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/html [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [NC]
RewriteRule ^$ https://dedl-project.github.io/dedl/index.html [R=303,L]

RewriteRule ^$ https://dedl-project.github.io/dedl/ontology.ttl [R=303,L]
