RewriteEngine On

# CESSDA permanent w3id redirects for SKG-IF

# Products - Research data redirects - map w3id identifiers to CESSDA Data Catalogue
# Pattern: https://w3id.org/cessda/cessda_product_research_data_<hash>
# Redirects to: https://datacatalogue.cessda.eu/detail/<hash>
RewriteRule ^cessda_product_research_data_([A-Fa-f0-9_-]+)/?$ https://datacatalogue.cessda.eu/detail/$1 [R=303,L]

# Products - Literature redirects - map w3id identifiers back to SKG-IF
# Pattern: https://w3id.org/cessda/cessda_product_literature_<id>
# Redirects to: https://skg-if.cessda.eu/products/<full-w3id-uri>
RewriteRule ^cessda_product_literature_([A-Fa-f0-9_-]+)/?$ https://skg-if.cessda.eu/products/https://w3id.org/cessda/cessda_product_literature_$1 [R=303,L]

# Products - Generic fallback for future product types - map w3id identifiers back to SKG-IF
# Pattern: https://w3id.org/cessda/cessda_product_<type>_<id>
# Redirects to: https://skg-if.cessda.eu/products/<full-w3id-uri>
RewriteRule ^cessda_product_([a-z_]+)_([A-Fa-f0-9_-]+)/?$ https://skg-if.cessda.eu/products/https://w3id.org/cessda/cessda_product_$1_$2 [R=303,L]

# Person redirects - map w3id identifiers back to SKG-IF
# Pattern: https://w3id.org/cessda/cessda_person_<id>
# Redirects to: https://skg-if.cessda.eu/persons/<full-w3id-uri>
RewriteRule ^cessda_person_([A-Fa-f0-9_-]+)/?$ https://skg-if.cessda.eu/persons/https://w3id.org/cessda/cessda_person_$1 [R=303,L]

# Organisation redirects - map w3id identifiers back to SKG-IF
# Pattern: https://w3id.org/cessda/cessda_organisation_<id>
# Redirects to: https://skg-if.cessda.eu/organisations/<full-w3id-uri>
RewriteRule ^cessda_organisation_([A-Fa-f0-9_-]+)/?$ https://skg-if.cessda.eu/organisations/https://w3id.org/cessda/cessda_organisation_$1 [R=303,L]

# Main namespace redirect (fallback)
RewriteRule ^/?$ https://www.cessda.eu/ [R=303,L]
