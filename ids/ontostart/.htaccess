### OntoStart redirects for https://w3id.org/ontostart/
###
### Generated by `ontostart htaccess` from ontostart.yaml: change that file and
### regenerate rather than editing this one.
###
### URL layout (N = an ontology name matching [a-z0-9][a-z0-9-]*, T = a term,
### x.y.z = a version, ext = ttl | owl | jsonld | nt)
###
###   /                        catalogue of the ontologies (HTML, or catalog.<ext> by content negotiation)
###   /catalog.<ext>           the catalogue in that syntax
###   /N/                      ontology N (HTML site, or RDF by content negotiation); /N is the same
###   /N/x.y.z                 ontology N, that version (owl:versionIRI minted by CI)
###   /N/T                     term of N (HTML: term page; RDF: the ontology)
###   /N/versions/(latest|x.y.z)/   versioned files (RDF by content negotiation)
###   /N/N.<ext>               latest file in that syntax
###   /N/<anything else>       passed through to N's folder on GitHub Pages
###   /sandbox, /sandbox/      the catalogue
###   /sandbox/N/...           sandbox ontology N, as /N/...
###   /testo/...               same as /sandbox/testo/... (alias)
###   /x.y.z                   retired root ontology, that version (as /main/x.y.z)
###   /x.y.z/...               same as /main/x.y.z/...
###   /versions/..., /docs/..., /ontostart.<ext>   same as /main/...
###   anything else            passed through to GitHub Pages
###
### Ontologies are not listed here: any name resolves, so a new ontology needs no
### change to this file. Reserved names are never taken for an ontology:
### catalog, docs, main, sandbox, versions.
###
### All targets are on https://micheldumontier.github.io/ontostart/
### (GitHub Pages, one folder per ontology).
###
### Content negotiation: the first-listed RDF type in the Accept header wins.
### If none is listed first, an RDF type anywhere in the header is used unless
### the client also accepts HTML. Everything else gets HTML.
###
### Tests: apache/test-redirects.sh with apache/tests/redirects.tsv

Header always set Access-Control-Allow-Origin "*"
Header always merge Vary "Accept"
Options -MultiViews
RewriteEngine On

### Parameters
# Where browsers asking for a term go: "ontospy" (the term's OntoSpy page) or "site" (ontology home page)
RewriteRule ^ - [E=TERM_DOCS:ontospy]

### Content negotiation -> EXT (ttl | owl | jsonld | nt | html)

# 1. First-listed type wins
RewriteCond %{HTTP_ACCEPT} ^\s*(text/turtle|application/x-turtle|application/turtle|text/ttl)\b [NC]
RewriteRule ^ - [E=EXT:ttl]
RewriteCond %{HTTP_ACCEPT} ^\s*(application/rdf\+xml|application/xml|text/xml)\b [NC]
RewriteRule ^ - [E=EXT:owl]
RewriteCond %{HTTP_ACCEPT} ^\s*application/ld\+json\b [NC]
RewriteRule ^ - [E=EXT:jsonld]
RewriteCond %{HTTP_ACCEPT} ^\s*application/n-triples\b [NC]
RewriteRule ^ - [E=EXT:nt]
RewriteCond %{HTTP_ACCEPT} ^\s*(text/html|application/xhtml\+xml)\b [NC]
RewriteRule ^ - [E=EXT:html]

# 2. Otherwise an RDF type anywhere in the header, if the client doesn't also accept HTML
RewriteCond %{ENV:EXT} ^$
RewriteCond %{HTTP_ACCEPT} !(text/html|application/xhtml\+xml) [NC]
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/turtle|text/ttl) [NC]
RewriteRule ^ - [E=EXT:ttl]
RewriteCond %{ENV:EXT} ^$
RewriteCond %{HTTP_ACCEPT} !(text/html|application/xhtml\+xml) [NC]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^ - [E=EXT:owl]
RewriteCond %{ENV:EXT} ^$
RewriteCond %{HTTP_ACCEPT} !(text/html|application/xhtml\+xml) [NC]
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^ - [E=EXT:jsonld]
RewriteCond %{ENV:EXT} ^$
RewriteCond %{HTTP_ACCEPT} !(text/html|application/xhtml\+xml) [NC]
RewriteCond %{HTTP_ACCEPT} application/n-triples [NC]
RewriteRule ^ - [E=EXT:nt]

# 3. Default: HTML
RewriteCond %{ENV:EXT} ^$
RewriteRule ^ - [E=EXT:html]

### Path P below this folder; aliases rewrite it here, never by a redirect to w3id.org
RewriteRule ^(.*)$ - [E=P:$1]

### Aliases: old paths rewritten to the current ones (then redirected like them)
RewriteCond %{ENV:P} ^testo(/.*)?$
RewriteRule ^ - [E=P:sandbox/testo%1]

### Catalogue: /  and  /catalog.<ext>
RewriteCond %{ENV:P} ^catalog\.(ttl|owl|jsonld|nt)$
RewriteRule ^ https://micheldumontier.github.io/ontostart/catalog.%1 [R=303,L]
RewriteCond %{ENV:P} ^$
RewriteCond %{ENV:EXT} !^html$
RewriteRule ^ https://micheldumontier.github.io/ontostart/catalog.%{ENV:EXT} [R=303,L]
RewriteCond %{ENV:P} ^$
RewriteRule ^ https://micheldumontier.github.io/ontostart/ [R=303,L]

### Sandbox: /sandbox and /sandbox/ are the catalogue
RewriteCond %{ENV:P} ^sandbox/?$
RewriteRule ^ https://micheldumontier.github.io/ontostart/ [R=303,L]

### Legacy root: the retired root ontology, in main/ as ontostart.<ext>
### /x.y.z, /versions/..., /docs/... and /ontostart.<ext> resolve as /main/... does
RewriteCond %{ENV:P} ^(\d+\.\d+\.\d+(/.*)?|versions(/.*)?|docs(/.*)?|ontostart\.(ttl|owl|jsonld|nt))$
RewriteRule ^ - [E=B:main,E=REST:%1]
RewriteCond %{ENV:P} ^main(/(.*))?$
RewriteRule ^ - [E=B:main,E=REST:%2]

### Split P into the ontology B (N or sandbox/N) and the rest REST; /N is the same as /N/
RewriteCond %{ENV:B} ^$
RewriteCond %{ENV:P} ^(sandbox/[a-z0-9][a-z0-9-]*)(/(.*))?$
RewriteRule ^ - [E=B:%1,E=REST:%3]
RewriteCond %{ENV:B} ^$
RewriteCond %{ENV:P} !^(catalog|docs|main|sandbox|versions)(/|$)
RewriteCond %{ENV:P} ^([a-z0-9][a-z0-9-]*)(/(.*))?$
RewriteRule ^ - [E=B:%1,E=REST:%3]

### Paths that name no ontology are passed through
RewriteCond %{ENV:B} ^$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:P} [R=303,L]

# BONTO: ontology file name of B (its last segment)
RewriteCond %{ENV:B} ([^/]+)$
RewriteRule ^ - [E=BONTO:%1]
RewriteCond %{ENV:B} ^main$
RewriteRule ^ - [E=BONTO:ontostart]

### Ontology: /B/  (and /B)
RewriteCond %{ENV:REST} ^$
RewriteCond %{ENV:EXT} !^html$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/versions/latest/%{ENV:BONTO}.%{ENV:EXT} [R=303,L]
RewriteCond %{ENV:REST} ^$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/ [R=303,L]

### Version IRI: /B/x.y.z  (HTML: the version's landing page)
RewriteCond %{ENV:EXT} !^html$
RewriteCond %{ENV:REST} ^(\d+\.\d+\.\d+)/?$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/versions/%1/%{ENV:BONTO}.%{ENV:EXT} [R=303,L]
RewriteCond %{ENV:REST} ^(\d+\.\d+\.\d+)/?$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/%1/ [R=303,L]

### Versions folder: /B/versions/(latest|x.y.z)/  (HTML: landing page, or the site for latest)
RewriteCond %{ENV:EXT} !^html$
RewriteCond %{ENV:REST} ^versions/(latest|\d+\.\d+\.\d+)/?$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/versions/%1/%{ENV:BONTO}.%{ENV:EXT} [R=303,L]
RewriteCond %{ENV:REST} ^versions/latest/?$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/ [R=303,L]
RewriteCond %{ENV:REST} ^versions/(\d+\.\d+\.\d+)/?$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/%1/ [R=303,L]

### Latest file in a given syntax: /B/<file>.(ttl|owl|jsonld|nt)
RewriteCond %{ENV:REST} ^([^/]+\.(ttl|owl|jsonld|nt))$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/versions/latest/%1 [R=303,L]

### Folders named without their slash: /B/versions, /B/docs
RewriteCond %{ENV:REST} ^(versions|docs)$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/%1/ [R=303,L]

### Terms: /B/T
# RDF: the ontology that defines the term
RewriteCond %{ENV:EXT} !^html$
RewriteCond %{ENV:REST} ^[A-Za-z_][A-Za-z0-9_-]*$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/versions/latest/%{ENV:BONTO}.%{ENV:EXT} [R=303,L]
# HTML: OntoSpy page (classes start with an upper-case letter, properties don't)
RewriteCond %{ENV:TERM_DOCS} ^ontospy$
RewriteCond %{ENV:REST} ^([A-Z][A-Za-z0-9_-]*)$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/docs/ontospy/class-%{ENV:BONTO}%1.html [R=303,L]
RewriteCond %{ENV:TERM_DOCS} ^ontospy$
RewriteCond %{ENV:REST} ^([a-z_][A-Za-z0-9_-]*)$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/docs/ontospy/prop-%{ENV:BONTO}%1.html [R=303,L]
RewriteCond %{ENV:REST} ^[A-Za-z_][A-Za-z0-9_-]*$
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/ [R=303,L]

### Anything else (docs, versions, landing pages, ...) is passed through
RewriteRule ^ https://micheldumontier.github.io/ontostart/%{ENV:B}/%{ENV:REST} [R=303,L]
