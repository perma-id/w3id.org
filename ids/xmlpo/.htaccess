RewriteEngine on

# ontology (ttl)

Redirect 303 /ontology https://raw.githubusercontent.com/OntoUML/ontouml-models/refs/heads/master/models/xhani2023xmlpo/ontology.ttl

# metadata (ttl)

Redirect 303 /metadata https://raw.githubusercontent.com/OntoUML/ontouml-models/refs/heads/master/models/xhani2023xmlpo/metadata.ttl
