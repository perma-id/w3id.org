# Turn off MultiViews
Options +FollowSymLinks -MultiViews

# Rewrite engine setup
RewriteEngine On

# Ontology rule to serve HTML content
# /sal/salmodule#Task -> https://cgs-earth.github.io/sal/ontology/salmodule#Task
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^([^/]+)$ https://cgs-earth.github.io/sal/ontology/$1 [R=303,L,QSD]

# Ontology rule to serve Turtle content
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^([^/]+)$ https://cgs-earth.github.io/sal/ontology/$1.ttl [R=303,L,QSD]

# Ontology rule to serve N-Triples content
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^([^/]+)$ https://cgs-earth.github.io/sal/ontology/$1.nt [R=303,L,QSD]

# Ontology rule to serve RDF/XML content
RewriteCond %{HTTP_ACCEPT} text/xml [OR]
RewriteCond %{HTTP_ACCEPT} application/xml [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^([^/]+)$ https://cgs-earth.github.io/sal/ontology/$1.xml [R=303,L,QSD]

# Ontology rule to serve JSON-LD content
RewriteCond %{HTTP_ACCEPT} application/json [OR]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^([^/]+)$ https://cgs-earth.github.io/sal/ontology/$1.json [R=303,L,QSD]

# Ontology rule without content type
RewriteRule ^([^/]*)$ https://cgs-earth.github.io/sal/ontology/$1 [R=303,L,QSD]

# General SAL Redirects for ant GitHub Pages Deploy
# Rewrite rule to serve HTML content
RewriteCond %{HTTP_ACCEPT} text/html
RewriteRule ^([^/]+)[/]?(.*)$ https://$1.github.io/$2 [R=303,L]

# Rewrite rule to serve Turtle content
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^([^/]+)[/]?(.*)$ https://$1.github.io/$2.ttl [R=303,L,QSD]

# Rewrite rule to serve N-Triples content
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^([^/]+)[/]?(.*)$ https://$1.github.io/$2.nt [R=303,L,QSD]

# Rewrite rule to serve RDF/XML content
RewriteCond %{HTTP_ACCEPT} text/xml [OR]
RewriteCond %{HTTP_ACCEPT} application/xml [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^([^/]+)[/]?(.*)$ https://$1.github.io/$2.xml [R=303,L,QSD]

# Rewrite rule to serve JSON-LD content
RewriteCond %{HTTP_ACCEPT} application/json [OR]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^([^/]+)[/]?(.*)$ https://$1.github.io/$2.json [R=303,L,QSD]

# Rewrite rule without content type
RewriteRule ^([^/]+)[/]?(.*)$ https://$1.github.io/$2 [R=303,L]
