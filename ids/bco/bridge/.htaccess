
Options +FollowSymLinks
RewriteEngine On

# BCO Bridge Compliance Ontology
# Turtle content negotiation

# Turtle representation
RewriteCond %{HTTP:Accept} (^|[,[:space:]])text/turtle([;,[:space:]]|$) [NC]
RewriteRule ^$ https://zenodo.org/records/23203730/files/S3_BCO_Turtle_all_rules.ttl?download=1 [R=303,L]

# HTML representation
RewriteCond %{HTTP:Accept} text/html [NC]
RewriteRule ^$ https://zenodo.org/records/23203730/files/BCO_documentation.html?download=1 [R=303,L]

# Default DOI redirects
RewriteRule ^$ https://doi.org/10.5281/zenodo.20585467 [R=303,L]
RewriteRule ^(.*)$ https://doi.org/10.5281/zenodo.20585467 [R=303,L]
