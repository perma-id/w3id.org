# /prograph/
#
# ProGraph: a virtual graph layer that runs SPARQL and Cypher over tabular data.
# https://gitlab.com/briceg/prograph
#
# https://w3id.org/prograph/<path>  redirects to https://prograph.app/<path>
# for example https://w3id.org/prograph/endpoint#rowCap, the SPARQL endpoint's vocabulary
#
# ## Contact
# This space is administered by:
#
# Brice Giesbrecht
# briceg@gmail.com
# GitHub username: bgiesbrecht

RewriteEngine on

RewriteRule ^(.*)$ https://prograph.app/$1 [R=302,L]
