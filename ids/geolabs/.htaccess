RewriteCond %{QUERY_STRING} (^|&)format=ttl(&|$)
RewriteRule ^ospd/data-types/(register|geolabs|specification|registerSystem|amendmentAction|dataTypeItemClass|dataTypes|data-types|data-type)/?$ https://geolabs.github.io/bblocks-data-types/_sources/vocabulary/data.ttl? [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle
