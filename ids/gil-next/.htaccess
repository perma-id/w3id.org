# w3id.org/gil-next — GIL (Raiden/Canon) permanent identifiers.
# Maintainer: Tevin Taylor (GitHub @tevintay249-stack). Gateway: https://tevintay249-stack.github.io/gil-next-id/
RewriteEngine on

# Permanent Atoms denote concepts, not documents: 303 See Other to their description, RDF by content negotiation.
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/n-triples|application/rdf\+xml|application/ld\+json|application/trig) [NC]
RewriteRule ^atom/([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$ https://tevintay249-stack.github.io/gil-next-id/atom/$1.ttl [R=303,L]
RewriteRule ^atom/([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$ https://tevintay249-stack.github.io/gil-next-id/atom/$1.html [R=303,L]

# The identity vocabulary and policy (gid:).
RewriteRule ^id$ https://tevintay249-stack.github.io/gil-next-id/id.ttl [R=303,L]

# Index, and everything else under gil-next (older candidate vocabularies): the gateway, which says what it serves.
RewriteRule ^$ https://tevintay249-stack.github.io/gil-next-id/ [R=302,L]
RewriteRule ^(.*)$ https://tevintay249-stack.github.io/gil-next-id/$1 [R=302,L]
