Options -MultiViews

AddType application/rdf+xml .rdf
AddType application/rdf+xml .owl
AddType text/turtle .ttl
AddType application/n-triples .n3
AddType application/ld+json .jsonld
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^$ https://iagofg.github.io/docencia-ontology/task6/index-es.html [R=303,L]

RewriteCond %{HTTP_ACCEPT} !application/rdf\+xml.*(text/html|application/xhtml\+xml)
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^(.+) https://iagofg.github.io/docencia-ontology/task6/index-es.html#/$1 [R=303,NE]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml

RewriteRule ^(.+) https://raw.githubusercontent.com/iagofg/docencia-ontology/main/task6/ontology.owl [R=302,NE,L]
RewriteRule ^$ https://raw.githubusercontent.com/iagofg/docencia-ontology/main/task6/ontology.owl [R=303,L]