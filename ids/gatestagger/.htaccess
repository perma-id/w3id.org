# /gatestagger/
# Permanent IRIs for the GateStagger approval-release decision vocabulary.
# Content is hosted in the author's public Zenodo deposit, not on w3id.org.
# Maintainer: Ahmad Baghdadi
# Contact: ambaghdadi@uqu.edu.sa
# GitHub username: baghdadi05555-sketch

RewriteEngine on

# Vocabulary and record IRIs resolve to the public documentation deposit.
# The vocabulary, worked Turtle graph and complete record archive are downloads.
# Zenodo serves those files as binary downloads; no RDF content negotiation is claimed.
RewriteRule ^ https://zenodo.org/records/23265291 [R=303,L]
