# hcmo — Home-Cage Monitoring Ontology (HCMO)
#
# Permanent W3ID directory providing stable, content-negotiated resolution for
# the HCMO ontology, developed at https://github.com/dhuzard/HCMO
#
# Ontology IRI:    https://w3id.org/hcmo/ontology/hcm
# Base namespace:  https://w3id.org/hcmo/ontology/hcm#
# Modules:         https://w3id.org/hcmo/ontology/hcm/bio#
#                  https://w3id.org/hcmo/ontology/hcm/env#
#                  https://w3id.org/hcmo/ontology/hcm/obs#
#                  https://w3id.org/hcmo/ontology/hcm/tech#
# Version IRI:     https://w3id.org/hcmo/ontology/hcm/<version>  (e.g. /0.4.1)
# Vocabularies:    https://w3id.org/hcmo/id/vocab/<scheme>[/<concept>]
# Profiles:        https://w3id.org/hcmo/ontology/profile/bfo-sosa-bridge
#                  https://w3id.org/hcmo/ontology/external/upper-presentation
# SPARQL:          https://w3id.org/hcmo/sparql
#
# RDF is served from GitHub Pages (https://dhuzard.github.io/HCMO/), which
# holds byte-identical copies of the GitHub release assets and serves them with
# RDF media types. (GitHub release downloads are served as
# application/octet-stream, which RDF crawlers do not parse.) The merged
# distributions contain all modules, so module IRIs resolve to the same graph.
#
# ## Contact
# This space is administered by:
#
# Damien Huzard
# damien@metadatapp.net
# GitHub username: dhuzard

Options -MultiViews

RewriteEngine on

# ===========================================================================
# Version-aware resolution: https://w3id.org/hcmo/ontology/hcm/<version>
# <version> is any segment beginning with a digit (e.g. 0.4.1); it matches the
# GitHub release tag v<version> and the Pages folder dist/<version>/.
# (Module names such as bio/env/obs/tech begin with a letter and fall through to
#  the "latest" block below.)
# ===========================================================================

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^ontology/hcm/([0-9][^/]*)$ https://dhuzard.github.io/HCMO/dist/$1/hcmo.ttl [R=303,L]

# RDF/XML (OWL)
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/xml [OR]
RewriteCond %{HTTP_ACCEPT} text/xml
RewriteRule ^ontology/hcm/([0-9][^/]*)$ https://dhuzard.github.io/HCMO/dist/$1/hcmo.owl [R=303,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^ontology/hcm/([0-9][^/]*)$ https://dhuzard.github.io/HCMO/dist/$1/hcmo.jsonld [R=303,L]

# HTML documentation (browsers) -> the GitHub release page for that version
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^ontology/hcm/([0-9][^/]*)$ https://github.com/dhuzard/HCMO/releases/tag/v$1 [R=303,L]

# Default for a version IRI: serve the canonical Turtle graph
RewriteRule ^ontology/hcm/([0-9][^/]*)$ https://dhuzard.github.io/HCMO/dist/$1/hcmo.ttl [R=303,L]

# ===========================================================================
# Latest resolution: https://w3id.org/hcmo/ontology/hcm (+ bio/env/obs/tech modules)
# ===========================================================================

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^ontology/hcm(/(bio|env|obs|tech))?$ https://dhuzard.github.io/HCMO/dist/latest/hcmo.ttl [R=303,L]

# RDF/XML (OWL)
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/xml [OR]
RewriteCond %{HTTP_ACCEPT} text/xml
RewriteRule ^ontology/hcm(/(bio|env|obs|tech))?$ https://dhuzard.github.io/HCMO/dist/latest/hcmo.owl [R=303,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json [OR]
RewriteCond %{HTTP_ACCEPT} application/json
RewriteRule ^ontology/hcm(/(bio|env|obs|tech))?$ https://dhuzard.github.io/HCMO/dist/latest/hcmo.jsonld [R=303,L]

# HTML documentation (browsers) -> WIDOCO documentation on GitHub Pages
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^ontology/hcm(/(bio|env|obs|tech))?$ https://dhuzard.github.io/HCMO/ [R=303,L]

# Default response for the ontology IRI: serve the canonical Turtle graph
RewriteRule ^ontology/hcm(/(bio|env|obs|tech))?$ https://dhuzard.github.io/HCMO/dist/latest/hcmo.ttl [R=303,L]

# ===========================================================================
# Optional profiles (not part of the merged release graph)
# ===========================================================================

RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^ontology/profile/bfo-sosa-bridge$ https://github.com/dhuzard/HCMO/blob/main/docs/BFO-SOSA-BRIDGE-PROFILE.md [R=303,L]
RewriteRule ^ontology/profile/bfo-sosa-bridge$ https://dhuzard.github.io/HCMO/profile/bfo-sosa-bridge.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^ontology/external/upper-presentation$ https://github.com/dhuzard/HCMO/blob/main/docs/UPPER-LEVEL-VIEW.md [R=303,L]
RewriteRule ^ontology/external/upper-presentation$ https://dhuzard.github.io/HCMO/ontology/external/upper-presentation.ttl [R=303,L]

# ===========================================================================
# SKOS vocabularies: https://w3id.org/hcmo/id/vocab/<scheme>[/<concept>]
# A scheme and all its concepts resolve to the scheme's Turtle file.
# ===========================================================================

RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml [OR]
RewriteCond %{HTTP_USER_AGENT} ^Mozilla/.*
RewriteRule ^id/vocab/([a-z0-9-]+)(/.*)?$ https://github.com/dhuzard/HCMO/tree/main/vocabularies [R=303,L]
RewriteRule ^id/vocab/([a-z0-9-]+)(/.*)?$ https://dhuzard.github.io/HCMO/vocab/$1.ttl [R=303,L]

# ===========================================================================
# SPARQL endpoint: https://w3id.org/hcmo/sparql
# Read-only Fuseki endpoint of the reference graph. SPARQL clients are sent
# to the endpoint (the query string, e.g. ?query=..., is kept); a browser
# without a query is sent to the query page of the web interface. A POST
# query gets a 307, so the client repeats the POST with its body.
# ===========================================================================

RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^sparql/?$ https://sparql.hcmo.metadatapp.net/hcmo/sparql [R=307,L]

RewriteCond %{QUERY_STRING} ^$
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml
RewriteRule ^sparql/?$ https://sparql.hcmo.metadatapp.net/#/dataset/hcmo/query [R=302,L,NE]
RewriteRule ^sparql/?$ https://sparql.hcmo.metadatapp.net/hcmo/sparql [R=302,L]

# ===========================================================================
# Landing: https://w3id.org/hcmo/ (and any unmatched path) -> source repo
# ===========================================================================
RewriteRule ^ https://github.com/dhuzard/HCMO [R=302,L]
