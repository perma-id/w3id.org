# BSDO — Battery Swap Domain Ontology
#
# https://w3id.org/bsdo      -> terminology (TBox)
# https://w3id.org/bsdo/abox -> population (ABox)
#
# Content negotiation: HTML for browsers, RDF/XML on request,
# Turtle otherwise. Files are hosted on GitHub Pages at
# https://sidodea-ie.github.io/BSDO/
#
# Archived at https://doi.org/10.5281/zenodo.21683493
#
# ## Contact
# Sido Dea Auvia
# ORCID: 0009-0006-9730-6541
# GitHub username: sidodea-IE

RewriteEngine on

# --- Population (ABox) ---
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^abox/?$ https://sidodea-ie.github.io/BSDO/ [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^abox/?$ https://sidodea-ie.github.io/BSDO/bsdo-abox.owl [R=303,L]
RewriteRule ^abox/?$ https://sidodea-ie.github.io/BSDO/bsdo-abox.ttl [R=303,L]

# --- Terminology (TBox), default target ---
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^$ https://sidodea-ie.github.io/BSDO/ [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^$ https://sidodea-ie.github.io/BSDO/bsdo.owl [R=303,L]
RewriteRule ^$ https://sidodea-ie.github.io/BSDO/bsdo.ttl [R=303,L]
