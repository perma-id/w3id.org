Header set Access-Control-Allow-Origin *

AddType text/turtle .ttl

RewriteEngine On

# 1. Access to the phisical files .ttl
RewriteRule ^hpc/hpc-core\.ttl$ https://raw.githubusercontent.com/logistica-dev/exa-atow-ontologies/main/hpc_ontology/hpc-core.ttl [R=302,L]
RewriteRule ^hpc/hpc\.ttl$  https://raw.githubusercontent.com/logistica-dev/exa-atow-ontologies/main/hpc_ontology/hpc.ttl  [R=302,L]

# 2. Namespace /hpc: Turtle for software                                               
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^hpc/?$ https://raw.githubusercontent.com/logistica-dev/exa-atow-ontologies/main/hpc_ontology/hpc.ttl [R=303,L]

# 3. Access the URI from a browser (HTML)
RewriteRule ^hpc/?$ https://raw.githubusercontent.com/logistica-dev/exa-atow-ontologies/main/hpc_ontology/index.html [R=303,L]

# 4. Workflow Ontology
RewriteRule ^exato-wf\.ttl$ https://raw.githubusercontent.com/logistica-dev/exa-atow-ontologies/main/workflow_ontology/exaatow_workflow_ontology.ttl [R=302,L]
