# ============================================
# AEROSPACE-X Content Negotiation
# ============================================

Header set Access-Control-Allow-Origin "*"
Header set Vary "Accept"

AddType application/rdf+xml .rdf .owl
AddType text/turtle .ttl
AddType application/ld+json .jsonld
AddType application/schema+json .schema.json
AddType application/asset-administration-shell-package .aasx

Options +FollowSymLinks
RewriteEngine on

# ============================================
# 1. ODRL Verifiable Credential Profile
# ============================================

RewriteRule ^ovc(/.*)?$ https://gitlab.com/gaia-x/lab/policy-reasoning/odrl-vc-profile/-/raw/main/ovc-1.ttl [R=303,L]

# ============================================
# 2. Ontology
# ============================================
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^ontology(/development|/[0-9.]+)?/?$ https://a-x.pages.fraunhofer.de/ontology/ontology.shacl.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^ontology(/development|/[0-9.]+)?/?$ https://a-x.pages.fraunhofer.de/ontology/ontology.owl.ttl [R=303,L]

RewriteRule ^ontology(/development|/[0-9.]+)?/?$ https://a-x.pages.fraunhofer.de/ontology/ [R=303,L]


# ============================================
# 3. Data Product Models
#   Public : /aerospace-x/data-product-model/{group}/{model}/{version}
#   Target : {group}/{model}/{version}/{Aspect}.{ext}
#   Media  : ttl | jsonld | schema.json | aas.json | HTML (default)
# ============================================

# ---------- 3a. Aspect file name per model ----------

# --- dmp ---
RewriteRule ^aerospace-x/data-product-model/(dmp/attachment)/([0-9.]+)/?$                              /_dpm/$1/$2/Attachment [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/certificate-metadata)/([0-9.]+)/?$                    /_dpm/$1/$2/CertificateMetadata [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/chemical-analysis)/([0-9.]+)/?$                       /_dpm/$1/$2/ChemicalAnalysis [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/chemical-safety-and-compliance)/([0-9.]+)/?$          /_dpm/$1/$2/ChemicalSafetyAndCompliance [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/chemicals)/([0-9.]+)/?$                               /_dpm/$1/$2/DmpChemicalsCertificate [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/composites)/([0-9.]+)/?$                              /_dpm/$1/$2/DmpCompositesCertificate [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/customs)/([0-9.]+)/?$                                 /_dpm/$1/$2/Customs [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/heat-treatment)/([0-9.]+)/?$                          /_dpm/$1/$2/HeatTreatment [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/inspection)/([0-9.]+)/?$                              /_dpm/$1/$2/Inspection [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/material-designation-chemicals)/([0-9.]+)/?$          /_dpm/$1/$2/MaterialDesignationChemicals [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/material-designation-composites)/([0-9.]+)/?$         /_dpm/$1/$2/MaterialDesignationComposites [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/material-designation-metals)/([0-9.]+)/?$             /_dpm/$1/$2/MaterialDesignationMetals [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/material-designation-steel)/([0-9.]+)/?$              /_dpm/$1/$2/MaterialDesignationSteel [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/metallurgical-processing)/([0-9.]+)/?$                /_dpm/$1/$2/MetallurgicalProcessing [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/metals)/([0-9.]+)/?$                                  /_dpm/$1/$2/DmpMetalsCertificate [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/parties)/([0-9.]+)/?$                                 /_dpm/$1/$2/Parties [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/product-forms-and-geometry)/([0-9.]+)/?$              /_dpm/$1/$2/ProductFormsAndGeometry [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/product-forms-and-packaging)/([0-9.]+)/?$             /_dpm/$1/$2/ProductFormsAndPackaging [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/product-shapes-and-dimensions)/([0-9.]+)/?$           /_dpm/$1/$2/ProductShapesAndDimensions [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/quantity)/([0-9.]+)/?$                                /_dpm/$1/$2/Quantity [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/regulatory-markings-and-certifications)/([0-9.]+)/?$  /_dpm/$1/$2/RegulatoryMarkingsAndCertifications [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/result)/([0-9.]+)/?$                                  /_dpm/$1/$2/Result [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/sample-specification)/([0-9.]+)/?$                    /_dpm/$1/$2/SampleSpecification [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/semantic)/([0-9.]+)/?$                                /_dpm/$1/$2/SemanticReference [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/specimen-specification)/([0-9.]+)/?$                  /_dpm/$1/$2/SpecimenSpecification [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/standards-compliance)/([0-9.]+)/?$                    /_dpm/$1/$2/StandardsCompliance [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/steel)/([0-9.]+)/?$                                   /_dpm/$1/$2/DmpSteelCertificate [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/surface-treatment)/([0-9.]+)/?$                       /_dpm/$1/$2/SurfaceTreatment [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/transaction-data)/([0-9.]+)/?$                        /_dpm/$1/$2/TransactionData [L]
RewriteRule ^aerospace-x/data-product-model/(dmp/validation)/([0-9.]+)/?$                              /_dpm/$1/$2/Validation [L]

# --- dpp ---
RewriteRule ^aerospace-x/data-product-model/(dpp/additional-data)/([0-9.]+)/?$                         /_dpm/$1/$2/AdditionalData [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/certificates)/([0-9.]+)/?$                            /_dpm/$1/$2/Certificates [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/characteristic)/([0-9.]+)/?$                          /_dpm/$1/$2/Characteristic [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/digital-product-passport)/([0-9.]+)/?$                /_dpm/$1/$2/DigitalProductPassport [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/end-of-life-handling)/([0-9.]+)/?$                    /_dpm/$1/$2/EndOfLifeHandling [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/identification)/([0-9.]+)/?$                          /_dpm/$1/$2/Identification [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/lca)/([0-9.]+)/?$                                     /_dpm/$1/$2/Lca [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/materials)/([0-9.]+)/?$                               /_dpm/$1/$2/Materials [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/metadata)/([0-9.]+)/?$                                /_dpm/$1/$2/Metadata [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/sustainability)/([0-9.]+)/?$                          /_dpm/$1/$2/Sustainability [L]
RewriteRule ^aerospace-x/data-product-model/(dpp/usage-repair-reuse-refurbishment)/([0-9.]+)/?$        /_dpm/$1/$2/UsageRepairReuseRefurbishment [L]

# --- enq ---
RewriteRule ^aerospace-x/data-product-model/(enq/containment-action)/([0-9.]+)/?$                      /_dpm/$1/$2/ContainmentAction [L]
RewriteRule ^aerospace-x/data-product-model/(enq/disposition)/([0-9.]+)/?$                             /_dpm/$1/$2/Disposition [L]
RewriteRule ^aerospace-x/data-product-model/(enq/share-non-quality)/([0-9.]+)/?$                       /_dpm/$1/$2/ShareNonQuality [L]

# --- shared ---
RewriteRule ^aerospace-x/data-product-model/(shared/address)/([0-9.]+)/?$                              /_dpm/$1/$2/Address [L]
RewriteRule ^aerospace-x/data-product-model/(shared/business-site)/([0-9.]+)/?$                        /_dpm/$1/$2/BusinessSite [L]
RewriteRule ^aerospace-x/data-product-model/(shared/legal-person)/([0-9.]+)/?$                         /_dpm/$1/$2/LegalPerson [L]
RewriteRule ^aerospace-x/data-product-model/(shared/quantity)/([0-9.]+)/?$                             /_dpm/$1/$2/Quantity [L]
RewriteRule ^aerospace-x/data-product-model/(shared/registrationnumber)/([0-9.]+)/?$                    /_dpm/$1/$2/RegistrationNumber [L]
RewriteRule ^aerospace-x/data-product-model/(shared/uuid)/([0-9.]+)/?$                                 /_dpm/$1/$2/Uuid [L]

# --- standalone ---
RewriteRule ^aerospace-x/data-product-model/(ecoc)/([0-9.]+)/?$                                        /_dpm/$1/$2/ECoC [L]

# ---------- 3b. Direct file requests (Aspect + extension) ----------
RewriteRule ^aerospace-x/data-product-model/(.+\.(?:ttl|jsonld|schema\.json|aas\.json|html))$ https://aerospace-x.pages.fraunhofer.de/data-product-model/$1 [R=303,L,NE]

# ---------- 3c. Content negotiation ----------
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^_dpm/(.+)$ https://aerospace-x.pages.fraunhofer.de/data-product-model/$1.ttl [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^_dpm/(.+)$ https://aerospace-x.pages.fraunhofer.de/data-product-model/$1.jsonld [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/schema\+json [NC]
RewriteRule ^_dpm/(.+)$ https://aerospace-x.pages.fraunhofer.de/data-product-model/$1.schema.json [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/asset-administration-shell-package [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/aas [NC]
RewriteRule ^_dpm/(.+)$ https://aerospace-x.pages.fraunhofer.de/data-product-model/$1.aas.json [R=303,L,NE]

RewriteCond %{HTTP_ACCEPT} application/json [NC]
RewriteRule ^_dpm/(.+)$ https://aerospace-x.pages.fraunhofer.de/data-product-model/$1.jsonld [R=303,L,NE]

# Default: HTML documentation of the version folder
RewriteRule ^_dpm/(.+)/[^/]+$ https://aerospace-x.pages.fraunhofer.de/data-product-model/$1/ [R=303,L,NE]

# ---------- 3d. Catalogue landing page ----------
RewriteRule ^aerospace-x/data-product-model/?$ https://aerospace-x.pages.fraunhofer.de/data-product-model/ [R=303,L,NE]


# ============================================
# 5. Catch-All: Redirect to semantic hub
# ============================================

RewriteRule ^(.*)$ https://int.semantic-hub.axdata.space/$1 [R=303,L]
