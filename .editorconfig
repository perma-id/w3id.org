# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs,ts,mts,cts,vue,json,yaml,yml}]
indent_style = space
indent_size = 2

# Note that trailing whitespace is trimmed everywhere, so the "two trailing
# spaces" style of Markdown hard line break does not survive in this
# repository. For a stack of lines -- a contact block, say -- write a bulleted
# list rather than reaching for a trailing backslash or <br>. See
# https://w3id.org/docs/rules/markdown/prefer-list-over-line-breaks
[*.md]
indent_style = space
indent_size = 2
