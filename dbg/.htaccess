RewriteEngine on

# KHD herbarium sheet images
RewriteRule ^khd/images/(KHD[0-9]+)\.(JPG|jpg)$ https://khd.dbg-images.org/$1.$2 [R=302,L]

# KHD herbarium bryophyte images
# RewriteRule ^khd/images/(KHD[0-9]+)\.(JPG|jpg)$ https://khdb.dbg-images.org/$1.$2 [R=302,L]

# DBG fungarium specimen images
# RewriteRule ^dbg/images/(DBG-F-[0-9]+)\.(JPG|jpg)$ https://khd-b.dbg-images.org/$1.$2 [R=302,L]
