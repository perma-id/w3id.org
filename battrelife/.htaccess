# w3id.org permanent identifiers for BattReLife
Options +FollowSymLinks
RewriteEngine on

# Module ontologies: https://w3id.org/battrelife/module/<name>
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^module/vocabulary$ https://cyrinesoufi.github.io/battrelife/vocab/vocabulary.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^module/validation$ https://cyrinesoufi.github.io/battrelife/validation/validation.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^module/(standard-profile|blco-bridge)$ https://cyrinesoufi.github.io/battrelife/bridge/$1.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^module/([a-z]+)$ https://cyrinesoufi.github.io/battrelife/ontology/battrelife-$1.ttl [R=303,L]

# Versioned releases: https://w3id.org/battrelife/release/<version>/<module>
RewriteRule ^release/([^/]+)/.*$ https://github.com/cyrinesoufi/battrelife/releases/tag/v$1 [R=303,L]

# Everything else (terms, browsers): documentation page
RewriteRule ^(.*)$ https://cyrinesoufi.github.io/battrelife/#$1 [R=303,NE,L]
