Options +FollowSymLinks
RewriteEngine on

# Spec and schema of the Support Ask A2A extension
RewriteRule ^v1/?$ https://github.com/gurusup/support-ask/blob/main/spec/v1/index.md [R=302,L]
RewriteRule ^v1/schema\.json$ https://raw.githubusercontent.com/gurusup/support-ask/main/spec/v1/schema.json [R=302,L]
RewriteRule ^/?$ https://github.com/gurusup/support-ask [R=302,L]
