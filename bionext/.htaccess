# w3id.org/bionext -> S3Bio/bionext-ontology GitHub Pages
# Copy to https://github.com/perma-id/w3id.org as bionext/.htaccess
# Contact: Natapol Pornputtapong (https://github.com/natapol)

Options +FollowSymLinks
RewriteEngine on

# Ontology root
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^ontology/?$ https://s3bio.github.io/bionext-ontology/bionext.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^ontology/?$ https://s3bio.github.io/bionext-ontology/bionext.owl [R=303,L]
RewriteRule ^ontology/?$ https://s3bio.github.io/bionext-ontology/ [R=303,L]

# Terms
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^ontology/(.+)$ https://s3bio.github.io/bionext-ontology/ontology/$1.ttl [R=303,L]
RewriteRule ^ontology/(.+)$ https://s3bio.github.io/bionext-ontology/ontology/$1.html [R=303,L]

# Releases and everything else
RewriteRule ^releases/(.*)$ https://s3bio.github.io/bionext-ontology/releases/$1 [R=303,L]
RewriteRule ^(.*)$ https://s3bio.github.io/bionext-ontology/$1 [R=303,L]
