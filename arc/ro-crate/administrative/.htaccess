AddType application/ld+json .jsonld

RewriteEngine On

# latest version 
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/administrative_crate/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/administrative_crate/ [R=302,L]

# versioned

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(.+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/administrative_crate/ro-crate-metadata.jsonld [R=302,L]

RewriteRule ^(.+)$ https://nfdi4plants.github.io/arc-ro-crate-profile/profiles/$1/administrative_crate/ [R=302,L]